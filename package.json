{
  "name": "root-seven-day-checkin",
  "version": "0.5.13",
  "private": true,
  "description": "ROOT 7 day check-in mini-program and operations backend",
  "scripts": {
    "admin:check": "npm run check --prefix admin",
    "admin:build": "npm run build --prefix admin",
    "deploy:prepare-admin": "node scripts/prepare-backend-admin-dist.js --clean",
    "evidence:local:write": "npm run build --prefix admin && node scripts/formal-launch-local-evidence.js --write",
    "evidence:local:check": "node scripts/formal-launch-local-evidence.js --check",
    "evidence:admin-query:rehearse": "node scripts/admin-query-performance-rehearsal.js --output docs/evidence/admin-performance-r0/query-rehearsal-events.json",
    "db:schema-snapshot:write": "node backend/scripts/mysql-schema-snapshot.js --write",
    "db:schema-snapshot:verify": "node backend/scripts/mysql-schema-snapshot.js --verify",
    "db:formal-disposition:cloudbase": "node backend/scripts/cloudbase-formal-launch-disposition.js",
    "release:manifest:miniprogram": "node scripts/miniprogram-release-manifest.js",
    "release:qrcode:trial": "node scripts/generate-wechat-trial-qrcode.js",
    "v1:baseline-signoff:check": "node --test backend/tests/baseline_signoff_contract_registry.test.js backend/tests/baseline_signoff_execution_control_registry.test.js backend/tests/baseline_signoff_evidence_verifier.test.js",
    "v1:platform-control-evidence:check": "node --test backend/tests/platform_control_evidence_registry.test.js backend/tests/remote_ci_evidence_registry.test.js",
    "v1:content-ued-authorization:check": "node --test backend/tests/content_ued_authorization_registry.test.js backend/tests/content_ued_trusted_evidence_resolver.test.js",
    "v1:formal-evidence:check": "node --test backend/tests/formal_evidence_resolver.test.js backend/tests/formal_launch_readiness_registry.test.js",
    "v1:activity:check": "node --test backend/tests/activity_module.test.js backend/tests/activity_api.test.js backend/tests/activity_formal_scope.test.js backend/tests/api.test.js",
    "v1:artifact-provenance:check": "node --test scripts/build-candidate-provenance.test.js",
    "v1:deployment-artifact-binding:check": "node --test backend/tests/deployment_artifact_binding_registry.test.js",
    "v1:mysql-production-preflight:check": "node --test backend/tests/mysql_production_preflight.test.js backend/tests/formal_launch_mysql_disposition_report.test.js",
    "v1:mysql-runtime-migration:check": "node --test backend/tests/mysql_runtime_migration_mode.test.js backend/tests/mysql_production_migrate_command.test.js backend/tests/mysql_privilege_policy.test.js",
    "v1:mysql-001-068-authorized:check": "node --test --test-reporter=tap --test-concurrency=1 backend/tests/mysql_local_readiness.integration.test.js",
    "v1:mysql-local-authorized:run": "node backend/scripts/mysql-local-authorized-runner.js",
    "v1:release-evidence:check": "node --test backend/tests/release_evidence_contract_registry.test.js",
    "v1:schema-snapshot:check": "node --test backend/tests/mysql_schema_snapshot.test.js backend/tests/mysql_migration_structure_guard.test.js",
    "v1:foundation:check": "npm run v1:baseline-signoff:check && npm run v1:platform-control-evidence:check && npm run v1:content-ued-authorization:check && npm run v1:formal-evidence:check && npm run v1:activity:check && npm run v1:artifact-provenance:check && npm run v1:deployment-artifact-binding:check && npm run v1:mysql-production-preflight:check && npm run v1:mysql-runtime-migration:check && npm run v1:release-evidence:check && npm run v1:schema-snapshot:check",
    "verify:canary": "node scripts/production-canary-verify.js",
    "verify": "node scripts/final-verification.js"
  },
  "engines": {
    "node": ">=20"
  }
}
