{
  "registryVersion": 1,
  "contractVersion": "1.0.0",
  "productVersion": "v1.0.0",
  "scope": "NON_RUNTIME_PLATFORM_CONTROL_EVIDENCE",
  "digestAlgorithm": "SHA-256",
  "canonicalization": {
    "version": "MYROOT_CANONICAL_JSON_V1",
    "unicodeNormalization": "NFC_REQUIRED",
    "objectKeyOrdering": "UTF16_CODE_UNIT_ASCENDING",
    "numberEncoding": "SAFE_INTEGER_JSON",
    "arrayOrdering": "SCHEMA_DEFINED_DETERMINISTIC",
    "undefinedPolicy": "REJECT",
    "digestDomainSeparation": "PLATFORM_CONTROL_EVIDENCE_V1"
  },
  "requiredEnvironmentKinds": ["CANDIDATE", "PRODUCTION"],
  "evidenceKinds": [
    {
      "evidenceKind": "TIMER_ONLY_IAM",
      "requiredRoles": ["PLATFORM_SECURITY", "ENGINEERING", "QA"]
    },
    {
      "evidenceKind": "ALERT_RECEIVER",
      "requiredRoles": ["OPERATIONS_ON_CALL", "PLATFORM_SECURITY", "ENGINEERING", "QA"]
    }
  ],
  "allowedSignatureMethods": [
    "CONTROLLED_APPROVAL_RECORD_V1",
    "DETACHED_DIGITAL_SIGNATURE_V1"
  ],
  "documentSchema": {
    "exactFields": [
      "evidenceFormatVersion",
      "digestCanonicalizationVersion",
      "productVersion",
      "releaseRef",
      "environmentKind",
      "environmentRef",
      "timerOnlyIam",
      "alertReceiver",
      "signoffs",
      "collectedAt"
    ],
    "timerOnlyIamExactFields": [
      "functionRef",
      "revisionRef",
      "triggerRef",
      "triggerType",
      "invocationPolicyRef",
      "principalRef",
      "allowedActions",
      "resourceRef",
      "executionMode",
      "timerSucceeded",
      "nonTimerDenied",
      "timerSuccessEvidenceRef",
      "nonTimerDenyEvidenceRef",
      "configSnapshotDigest",
      "observedAt"
    ],
    "alertReceiverExactFields": [
      "receiverRef",
      "onCallOwnerRef",
      "channelClass",
      "signingPolicyRef",
      "persistencePolicyRef",
      "ackPolicyRef",
      "retryPolicyRef",
      "deadLetterPolicyRef",
      "warningSloSeconds",
      "criticalSloSeconds",
      "syntheticSendAuthorizationRef",
      "syntheticWarningEvidenceRef",
      "syntheticCriticalEvidenceRef",
      "receiverAcknowledgementRef",
      "observedAt"
    ],
    "signoffExactFields": [
      "signoffId",
      "signerRef",
      "role",
      "evidenceKind",
      "environmentKind",
      "controlPayloadDigest",
      "decision",
      "signedAt",
      "signatureMethod",
      "signedPayloadDigest",
      "signatureDigest",
      "validatorRef",
      "validationStatus",
      "validationEvidenceRef",
      "revocationStatus",
      "revocationEvidenceRef"
    ],
    "opaqueReferencePatterns": {
      "release": "^release:sha256:[a-f0-9]{64}$",
      "environment": "^environment:sha256:[a-f0-9]{64}$",
      "resource": "^resource:sha256:[a-f0-9]{64}$",
      "actor": "^actor:sha256:[a-f0-9]{64}$",
      "evidence": "^evidence:sha256:[a-f0-9]{64}$",
      "policy": "^policy:sha256:[a-f0-9]{64}$",
      "signoff": "^signoff:sha256:[a-f0-9]{64}$",
      "validator": "^validator:sha256:[a-f0-9]{64}$"
    }
  },
  "authorization": {
    "runtimeAuthorized": false,
    "candidateCreationAuthorized": false,
    "deploymentAuthorized": false,
    "iamMutationAuthorized": false,
    "alertChannelMutationAuthorized": false,
    "syntheticSendAuthorized": false,
    "productionWriteAuthorized": false,
    "gateClosureAuthorized": false
  }
}
