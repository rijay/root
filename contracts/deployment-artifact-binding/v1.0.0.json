{
  "registryVersion": 1,
  "contractVersion": "1.0.0",
  "productVersion": "v1.0.0",
  "buildVersion": "0.5.13",
  "scope": "NON_RUNTIME_DEPLOYMENT_ARTIFACT_BINDING_STRUCTURE_VALIDATION",
  "sourceProvenanceEvidenceClass": "SOURCE_PROVENANCE_ONLY",
  "validationLevel": "STRUCTURE_ONLY_UNTRUSTED_INPUT",
  "digestAlgorithm": "SHA-256",
  "canonicalization": {
    "version": "MYROOT_CANONICAL_JSON_V1",
    "unicodeNormalization": "NFC_REQUIRED",
    "objectKeyOrdering": "UTF16_CODE_UNIT_ASCENDING",
    "numberEncoding": "SAFE_INTEGER_JSON",
    "arrayOrdering": "SCHEMA_DEFINED_DETERMINISTIC",
    "undefinedPolicy": "REJECT",
    "digestDomainSeparation": "DEPLOYMENT_ARTIFACT_BINDING_V1",
    "sourceProvenancePayloadDigestDomain": "myroot-candidate-provenance-payload:v1",
    "cloudFunctionSetDigestDomain": "myroot-deployment-artifact-binding-cloud-function-set:v1",
    "bindingPayloadDigestDomain": "myroot-deployment-artifact-binding-payload:v1"
  },
  "requiredArtifactModuleIds": [
    "ADMIN",
    "BACKEND",
    "CLOUD_FUNCTION",
    "CONTENT",
    "MIGRATION",
    "MINIPROGRAM",
    "ROUTE_REGISTRY"
  ],
  "artifactKinds": [
    {
      "moduleId": "ADMIN",
      "artifactKind": "STATIC_ADMIN_BUNDLE_SHA256_V1"
    },
    {
      "moduleId": "BACKEND",
      "artifactKind": "OCI_IMAGE_SHA256_V1"
    },
    {
      "moduleId": "CLOUD_FUNCTION",
      "artifactKind": "CLOUD_FUNCTION_ARCHIVE_SET_SHA256_V1"
    },
    {
      "moduleId": "CONTENT",
      "artifactKind": "CONTENT_SET_SHA256_V1"
    },
    {
      "moduleId": "MIGRATION",
      "artifactKind": "MIGRATION_SET_SHA256_V1"
    },
    {
      "moduleId": "MINIPROGRAM",
      "artifactKind": "WECHAT_UPLOAD_PACKAGE_SHA256_V1"
    },
    {
      "moduleId": "ROUTE_REGISTRY",
      "artifactKind": "ROUTE_REGISTRY_BUNDLE_SHA256_V1"
    }
  ],
  "requiredCloudFunctionKeys": [
    "MYROOT_HEALTH_RETENTION",
    "MYROOT_JOB_DISPATCHER",
    "MYROOT_V1_RUNTIME_SCHEDULER"
  ],
  "requiredSignoffRoles": [
    "ENGINEERING",
    "QA",
    "PLATFORM_SECURITY"
  ],
  "allowedSignatureMethods": [
    "CONTROLLED_APPROVAL_RECORD_V1",
    "DETACHED_DIGITAL_SIGNATURE_V1"
  ],
  "maxValidityDays": 30,
  "recordSchema": {
    "documentExactFields": [
      "recordType",
      "bindingFormatVersion",
      "digestCanonicalizationVersion",
      "productVersion",
      "buildVersion",
      "sourceCommit",
      "sourceProvenancePayloadDigest",
      "candidateManifestDigest",
      "releaseId",
      "targetEnvironmentRef",
      "modules",
      "revocationSnapshotDigest",
      "validFrom",
      "validUntil",
      "collectedAt",
      "revocationStatus",
      "revokedAt",
      "revocationEvidenceRef",
      "signoffs"
    ],
    "moduleBaseExactFields": [
      "moduleId",
      "sourceArtifactDigest",
      "deploymentArtifactDigest",
      "artifactKind",
      "remoteReadbackEvidenceRef",
      "platformBinding"
    ],
    "platformBindingExactFields": [
      "platformSubjectRef",
      "platformRevisionRef",
      "readbackSubjectRef",
      "readbackRevisionRef",
      "readbackArtifactDigest",
      "observedAt"
    ],
    "backendExactFields": [
      "ociImageDigest",
      "runtimeReadbackImageDigest"
    ],
    "miniprogramExactFields": [
      "uploadPackageDigest",
      "uploadVersion",
      "platformUploadReceiptRef"
    ],
    "cloudFunctionsExactFields": [
      "functions"
    ],
    "cloudFunctionExactFields": [
      "functionKey",
      "archiveDigest",
      "platformSubjectRef",
      "platformRevisionRef",
      "readbackSubjectRef",
      "readbackRevisionRef",
      "readbackArchiveDigest",
      "platformUploadReceiptRef",
      "remoteReadbackEvidenceRef",
      "observedAt"
    ],
    "signoffExactFields": [
      "signoffId",
      "signerRef",
      "role",
      "bindingPayloadDigest",
      "decision",
      "signedAt",
      "validUntil",
      "signatureMethod",
      "signedPayloadDigest",
      "signatureDigest",
      "validatorRef",
      "validationStatus",
      "validationEvidenceRef",
      "revocationStatus",
      "revokedAt",
      "revocationEvidenceRef"
    ],
    "opaqueReferencePatterns": {
      "release": "^release:sha256:[a-f0-9]{64}$",
      "environment": "^environment:sha256:[a-f0-9]{64}$",
      "subject": "^subject:sha256:[a-f0-9]{64}$",
      "revision": "^revision:sha256:[a-f0-9]{64}$",
      "evidence": "^evidence:sha256:[a-f0-9]{64}$",
      "receipt": "^receipt:sha256:[a-f0-9]{64}$",
      "signoff": "^signoff:sha256:[a-f0-9]{64}$",
      "actor": "^actor:sha256:[a-f0-9]{64}$",
      "validator": "^validator:sha256:[a-f0-9]{64}$"
    }
  },
  "authorization": {
    "runtimeAuthorized": false,
    "candidateCreationAuthorized": false,
    "deploymentAuthorized": false,
    "attestationAuthorized": false,
    "platformMutationAuthorized": false,
    "gateClosureAuthorized": false
  }
}
