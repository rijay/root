{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "version": "2.0",
  "envId": "myroot-prod-d5gl3gzg7115f149a",
  "functionRoot": "cloudfunctions",
  "functions": [
    {
      "name": "myroot-job-dispatcher",
      "dir": "cloudfunctions/myroot-job-dispatcher",
      "description": "Retired dispatcher artifact; no triggers and no legacy Job implementation",
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "timeout": 30,
      "memorySize": 256,
      "installDependency": false,
      "triggers": []
    },
    {
      "name": "myroot-health-retention",
      "dir": "cloudfunctions/myroot-job-dispatcher",
      "description": "myRoot health-data retention scheduler; defaults to dry-run",
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "timeout": 30,
      "memorySize": 256,
      "installDependency": false,
      "triggers": [
        {
          "name": "health_data_retention_cleanup",
          "type": "timer",
          "config": "0 15 4 * * * *"
        }
      ]
    }
  ]
}
