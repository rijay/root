{
  "name": "root-seven-day-checkin-backend",
  "version": "0.7.0",
  "private": true,
  "description": "myRoot formal-launch API and operations admin",
  "scripts": {
    "health-data-retention-cleanup": "node scripts/health-data-retention-cleanup.js",
    "snapshot:cleanup:dry-run": "node scripts/formal-launch-snapshot-cleanup-dry-run.js",
    "jobs:manifest": "node scripts/cloudbase-job-manifest.js",
    "production-env": "node scripts/production-env-matrix.js",
    "dev": "node src/server.js",
    "dev:miniprogram": "NODE_ENV=development ROOT_LISTEN_HOST=127.0.0.1 ROOT_STORE_ADAPTER=sqlite ROOT_SQLITE_FILE=./data/myroot-v070-devtools.sqlite ROOT_ALLOW_OPENID_LOGIN=true ROOT_LOCAL_MINIPROGRAM_DEV_SEED=true node src/server.js",
    "dev:ued-review": "node scripts/ued-review-server.js",
    "store:migrate:mysql": "node scripts/store-migrate.js",
    "db:migrate": "node scripts/mysql-migrate.js",
    "store:verify": "node scripts/store-verify.js",
    "test": "node --test --test-reporter=tap tests/*.test.js"
  },
  "dependencies": {
    "@cloudbase/node-sdk": "^3.18.3",
    "mysql2": "^3.14.1",
    "ws": "^8.21.0"
  },
  "overrides": {
    "axios": "1.18.1",
    "lodash.set": "npm:set-value@4.1.0",
    "lodash.unset": "npm:unset-value@2.0.1"
  },
  "engines": {
    "node": "22.x"
  }
}
