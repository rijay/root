{
  "pages": [
    "pages/welcome/index",
    "pages/home/index",
    "pages/health/index",
    "pages/activities/index",
    "pages/profile/index",
    "pages/login/index",
    "pages/register/index",
    "pages/legal/index",
    "pages/health-consent/index"
  ],
  "subPackages": [
    {
      "root": "subpkg/content",
      "pages": [
        "pages/detail/index"
      ]
    },
    {
      "root": "subpkg/health",
      "pages": [
        "pages/initial-assessment/index",
        "pages/scale-assessment/index"
      ]
    },
    {
      "root": "subpkg/activity",
      "pages": [
        "pages/detail/index",
        "pages/enrollments/index"
      ]
    },
    {
      "root": "subpkg/profile",
      "pages": [
        "pages/about/index",
        "pages/support/index",
        "pages/privacy-account/index"
      ]
    }
  ],
  "window": {
    "navigationBarTitleText": "myRoot",
    "navigationBarBackgroundColor": "#FDFBF6",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#F7F4EC"
  },
  "usingComponents": {},
  "tabBar": {
    "custom": true,
    "color": "#8A8172",
    "selectedColor": "#586B3F",
    "backgroundColor": "#FDFBF6",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/home/index",
        "text": "首页"
      },
      {
        "pagePath": "pages/health/index",
        "text": "健康"
      },
      {
        "pagePath": "pages/activities/index",
        "text": "活动"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的"
      }
    ]
  },
  "preloadRule": {
    "pages/home/index": {
      "network": "all",
      "packages": ["subpkg/content"]
    },
    "pages/activities/index": {
      "network": "all",
      "packages": ["subpkg/activity"]
    },
    "pages/health/index": {
      "network": "all",
      "packages": ["subpkg/health"]
    },
    "pages/profile/index": {
      "network": "all",
      "packages": ["subpkg/profile"]
    }
  },
  "style": "v2",
  "lazyCodeLoading": "requiredComponents",
  "sitemapLocation": "sitemap.json"
}
