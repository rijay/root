@import "./styles/tokens.wxss";

page {
  min-height: 100vh;
  color: var(--color-text-primary);
  background: var(--color-bg);
  font-family: var(--font-family);
}

.page {
  min-height: 100vh;
  padding: var(--spacing-lg) var(--spacing-md) calc(128rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--color-root-bg);
}

.section {
  margin-top: var(--spacing-lg);
}

.top-logo {
  width: 218rpx;
  height: 72rpx;
}

.hero-image {
  width: 100%;
  overflow: hidden;
  border-radius: var(--radius-card);
}

.panel,
.brand-card,
.content-card {
  padding: var(--spacing-lg);
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-sm);
}

.eyebrow {
  color: var(--color-primary-dark);
  font-size: var(--font-size-xs);
  font-weight: 700;
}

.h1 {
  margin-top: var(--spacing-sm);
  color: var(--color-text-primary);
  font-size: var(--font-size-2xl);
  line-height: 1.12;
  font-weight: 800;
}

.h2,
.section-title {
  color: var(--color-text-primary);
  font-size: var(--font-size-lg);
  line-height: 1.25;
  font-weight: 800;
}

.body,
.muted {
  color: var(--color-text-secondary);
  font-size: var(--font-size-base);
  line-height: 1.68;
}

.button-row {
  display: flex;
  gap: var(--spacing-sm);
  flex-wrap: wrap;
}

.btn,
.btn-primary,
.btn-secondary,
.btn-outline,
.btn-accent {
  min-height: 88rpx;
  padding: 0 var(--spacing-lg);
  border: 0;
  border-radius: var(--radius-control);
  font-size: var(--font-size-lg);
  font-weight: 600;
  line-height: 88rpx;
  text-align: center;
}

.btn::after,
.btn-primary::after,
.btn-secondary::after,
.btn-outline::after,
.btn-accent::after {
  border: 0;
}

.btn,
.btn-primary {
  color: var(--color-surface);
  background: var(--color-root-ink);
  box-shadow: var(--shadow-primary-cta);
}

.btn:active,
.btn-primary:active,
.btn-secondary:active,
.btn-outline:active,
.btn-accent:active {
  transform: scale(0.98);
}

.btn.secondary,
.btn-secondary {
  color: var(--color-root-ink);
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-sm);
}

.btn.ghost,
.btn-outline {
  color: var(--color-root-moss);
  background: transparent;
  border: 2rpx solid var(--color-root-sprout);
}

.btn-accent {
  color: var(--color-surface);
  background: var(--color-root-clay);
  box-shadow: var(--shadow-accent-cta);
}

.btn[disabled],
.btn.disabled,
.btn-primary[disabled],
.btn-secondary[disabled],
.btn-outline[disabled],
.btn-accent[disabled] {
  color: var(--color-text-tertiary);
  background: var(--color-border);
  border-color: var(--color-border);
  box-shadow: none;
}

.input,
.textarea {
  width: 100%;
  min-height: 88rpx;
  padding: 0 var(--spacing-md);
  box-sizing: border-box;
  color: var(--color-text-primary);
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: var(--font-size-base);
}

.textarea {
  min-height: 180rpx;
  padding-top: var(--spacing-md);
  line-height: 1.5;
}

.option-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--spacing-md);
}

.option-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  padding: var(--spacing-md);
  color: var(--color-text-primary);
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-control);
  font-size: var(--font-size-sm);
  line-height: 1.45;
  box-shadow: var(--shadow-sm);
  box-sizing: border-box;
}

.option-card.active {
  background: var(--color-primary-tint);
  border-color: var(--color-primary);
  box-shadow: 0 8rpx 24rpx rgba(88, 107, 63, 0.12);
}

.list-item {
  padding: var(--spacing-md) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.list-item:last-child {
  border-bottom: 0;
}

.safe-bottom {
  height: calc(var(--spacing-lg) + env(safe-area-inset-bottom));
}

.root-page {
  min-height: 100vh;
  padding: var(--spacing-lg) var(--spacing-md) calc(128rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--color-root-bg);
}

.root-card {
  padding: var(--spacing-lg);
  background: var(--color-root-surface);
  border: 1rpx solid var(--color-root-line);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-sm);
}

.root-card--dark {
  color: var(--color-root-nav);
  background: var(--color-root-ink);
  border-color: var(--color-root-ink);
}

.root-button {
  min-height: 96rpx;
  padding: 0 var(--spacing-lg);
  color: var(--color-root-surface);
  background: var(--color-root-ink);
  border: 0;
  border-radius: var(--radius-control);
  font-size: var(--font-size-lg);
  font-weight: 600;
  line-height: 96rpx;
  text-align: center;
}

.root-button::after {
  border: 0;
}

.root-button:active {
  transform: scale(0.98);
}

.root-button[disabled] {
  color: var(--color-root-muted);
  background: var(--color-root-line);
  box-shadow: none;
}

.root-button--secondary {
  color: var(--color-root-moss);
  background: var(--color-root-surface);
  border: 1rpx solid var(--color-root-line);
}

.root-cell-group {
  overflow: hidden;
  background: var(--color-root-surface);
  border: 1rpx solid var(--color-root-line);
  border-radius: var(--radius-card);
}

.root-cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 0 var(--spacing-lg);
  border-bottom: 1rpx solid var(--color-root-line);
  color: var(--color-root-ink);
  font-size: var(--font-size-base);
}

.root-cell:last-child {
  border-bottom: 0;
}

.root-cell__value {
  color: var(--color-root-muted);
  text-align: right;
}

.root-section-title {
  color: var(--color-root-ink);
  font-size: var(--font-size-lg);
  line-height: 1.25;
  font-weight: 700;
}

.root-helper-text {
  color: var(--color-root-muted);
  font-size: var(--font-size-xs);
  line-height: 1.6;
}

.root-brand-logo {
  width: 218rpx;
  height: 42rpx;
}

.root-form-card {
  margin-top: var(--spacing-lg);
}

.root-option-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--spacing-md);
}

.root-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  padding: var(--spacing-md);
  color: var(--color-root-ink);
  background: var(--color-root-surface);
  border: 2rpx solid var(--color-root-line);
  border-radius: var(--radius-control);
  box-shadow: var(--shadow-sm);
  box-sizing: border-box;
  font-size: var(--font-size-sm);
  font-weight: 650;
  line-height: 1.45;
}

.root-option.active {
  background: var(--color-primary-tint);
  border-color: var(--color-root-moss);
  box-shadow: 0 8rpx 24rpx rgba(88, 107, 63, 0.12);
}

.root-option__mark {
  flex-shrink: 0;
  color: var(--color-root-moss);
  font-weight: 900;
}

.root-progress {
  display: grid;
  gap: var(--spacing-sm);
}

.root-progress__bar {
  height: 10rpx;
  overflow: hidden;
  background: var(--color-root-line);
  border-radius: var(--radius-full);
}

.root-progress__fill {
  height: 100%;
  background: var(--color-root-moss);
  border-radius: var(--radius-full);
}
