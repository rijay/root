.root-tab-bar {
  position: fixed;
  z-index: 1000;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  height: calc(52px + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  background: rgba(253, 251, 246, 0.98);
  border-top: 1rpx solid rgba(232, 224, 208, 0.82);
}

.root-tab-bar__item {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: flex-start;
  flex-direction: column;
  gap: 2px;
  padding-top: 6px;
  box-sizing: border-box;
  color: #433e34;
}

.root-tab-bar__icon-image {
  display: block;
  width: 20px;
  height: 20px;
}

.root-tab-bar__label {
  font-size: 10px;
  line-height: 15px;
}

.root-tab-bar__item.is-active {
  color: #586b3f;
  font-weight: 600;
}
