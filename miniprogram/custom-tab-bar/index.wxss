.root-tab-bar {
  position: fixed;
  z-index: 1000;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  height: calc(60px + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid rgba(123, 122, 126, 0.22);
}

.root-tab-bar__item {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: flex-start;
  flex-direction: column;
  gap: 3px;
  min-width: 0;
  height: 60px;
  padding-top: 8px;
  box-sizing: border-box;
  color: #7b7a7e;
}

.root-tab-bar__icon-image {
  display: block;
  width: 22px;
  height: 22px;
}

.root-tab-bar__label {
  font-size: 11px;
  line-height: 18px;
}

.root-tab-bar__item.is-active {
  color: #6b7c3a;
  font-weight: 600;
}
