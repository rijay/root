.root-tab-bar {
  position: fixed;
  z-index: 1000;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  height: 84px;
  padding-bottom: 24px;
  box-sizing: border-box;
  background: rgba(253, 251, 246, 0.98);
  border-top: 1rpx solid rgba(232, 224, 208, 0.82);
}

.root-tab-bar__item {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: flex-start;
  flex-direction: column;
  gap: 7px;
  padding-top: 13px;
  box-sizing: border-box;
  color: #433e34;
}

.root-tab-bar__icon-image {
  display: block;
  width: 22px;
  height: 22px;
}

.root-tab-bar__label {
  font-size: 11px;
  line-height: 18px;
}

.root-tab-bar__item.is-active {
  color: #586b3f;
  font-weight: 600;
}
