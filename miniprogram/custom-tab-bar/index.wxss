.root-tab-bar {
  position: fixed;
  z-index: 1000;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  height: calc(120rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  background: rgba(253, 251, 246, 0.98);
  border-top: 1rpx solid rgba(232, 224, 208, 0.82);
}

.root-tab-bar__item {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 8rpx;
  color: #433e34;
}

.root-tab-bar__icon {
  width: 30rpx;
  height: 30rpx;
  border: 3rpx solid currentColor;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.root-tab-bar__icon--1 { border-radius: 50% 50% 48% 48%; transform: rotate(45deg) scale(0.82); }
.root-tab-bar__icon--2 { border-radius: 4rpx; border-top-width: 8rpx; }
.root-tab-bar__icon--3 { border-radius: 50%; border-bottom-color: transparent; }

.root-tab-bar__label {
  font-size: 22rpx;
  line-height: 28rpx;
}

.root-tab-bar__item.is-active {
  color: #586b3f;
  font-weight: 600;
}
