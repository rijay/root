.probe-page {
  min-height: 100vh;
  padding: 40rpx 32rpx 80rpx;
  background: #f7f4ec;
  box-sizing: border-box;
}

.probe-header {
  padding: 24rpx 0 28rpx;
}

.probe-title {
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #1f1d1a;
}

.probe-meta {
  margin-top: 12rpx;
  color: #6f675c;
  font-size: 24rpx;
  line-height: 1.6;
  word-break: break-all;
}

.probe-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.probe-card {
  margin-top: 18rpx;
}

.probe-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #27231f;
}

.probe-status {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #eee7dc;
  color: #6f675c;
  white-space: nowrap;
}

.probe-status.ready {
  background: #e7efdd;
  color: #4f6637;
}

.probe-status.blocked {
  background: #f5d9d1;
  color: #9b3d2c;
}

.probe-status.running {
  background: #e6e2d8;
  color: #6a5f4f;
}

.probe-detail {
  margin-top: 16rpx;
  color: #6f675c;
  font-size: 24rpx;
  line-height: 1.6;
  word-break: break-all;
}

.probe-raw {
  display: block;
  margin-top: 16rpx;
  color: #332f2a;
  font-size: 22rpx;
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-all;
}
