.probe-page {
  min-height: 100vh;
  padding: 40rpx 32rpx 80rpx;
  background: var(--color-ui-grouped);
  box-sizing: border-box;
}

.probe-header {
  padding: 24rpx 0 28rpx;
}

.probe-title {
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-graphite);
}

.probe-meta {
  margin-top: 12rpx;
  color: var(--color-neutral-grey);
  font-size: 24rpx;
  line-height: 1.6;
  word-break: break-all;
}

.probe-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.probe-card {
  margin-top: 18rpx;
}

.probe-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-graphite);
}

.probe-status {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: var(--color-system-line);
  color: var(--color-neutral-grey);
  white-space: nowrap;
}

.probe-status.ready {
  background: var(--color-olive-soft);
  color: var(--color-olive-mid);
}

.probe-status.blocked {
  background: var(--color-danger-tint);
  color: var(--color-danger);
}

.probe-status.running {
  background: var(--color-system-line);
  color: var(--color-neutral-grey);
}

.probe-detail {
  margin-top: 16rpx;
  color: var(--color-neutral-grey);
  font-size: 24rpx;
  line-height: 1.6;
  word-break: break-all;
}

.probe-raw {
  display: block;
  margin-top: 16rpx;
  color: var(--color-graphite);
  font-size: 22rpx;
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-all;
}
