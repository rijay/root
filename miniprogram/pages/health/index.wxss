.health-page {
  padding-top: 0;
}

.health-intro {
  margin: 0 calc(-1 * var(--spacing-md));
  padding: 72rpx var(--spacing-lg) 64rpx;
  color: var(--color-root-nav);
  background: linear-gradient(148deg, #1f271c 0%, var(--color-root-moss) 58%, #819164 100%);
}

.health-kicker,
.state-eyebrow {
  font-size: var(--font-size-xs);
  font-weight: 700;
  letter-spacing: 2rpx;
}

.health-kicker {
  color: rgba(253, 251, 246, 0.66);
}

.health-title {
  margin-top: 72rpx;
  font-size: var(--font-size-2xl);
  font-weight: 750;
  line-height: 1.16;
}

.health-copy {
  max-width: 620rpx;
  margin-top: var(--spacing-md);
  color: rgba(253, 251, 246, 0.78);
  font-size: var(--font-size-sm);
  line-height: 1.72;
}

.state-card {
  margin-top: var(--spacing-lg);
}

.state-card--gated {
  border-color: rgba(88, 107, 63, 0.28);
}

.state-eyebrow {
  color: var(--color-root-moss);
}

.state-title {
  margin-top: var(--spacing-sm);
}

.state-copy {
  margin-top: var(--spacing-sm);
}

.state-action {
  width: 100%;
  margin-top: var(--spacing-lg);
  padding: 0;
}

.text-action {
  width: 100%;
  margin-top: var(--spacing-sm);
  padding: var(--spacing-sm);
  color: var(--color-root-moss);
  background: transparent;
  border: 0;
  font-size: var(--font-size-sm);
  line-height: 1.5;
}

.text-action::after {
  border: 0;
}

.health-note {
  display: flex;
  gap: var(--spacing-sm);
  margin-top: var(--spacing-lg);
  padding: 0 var(--spacing-sm);
  color: var(--color-root-muted);
  font-size: var(--font-size-xs);
  line-height: 1.65;
}

.health-note-mark {
  flex: 0 0 24rpx;
  width: 24rpx;
  height: 4rpx;
  margin-top: 17rpx;
  background: var(--color-root-moss);
}
