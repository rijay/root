page {
  background: #fdfbf6;
}

.health-page {
  height: 100vh;
  background: #fdfbf6;
}

.health-page--safety {
  background: #fbf2ed;
}

.health-state {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 16px;
  min-height: calc(100vh - 52px - env(safe-area-inset-bottom));
  padding: 40px 20px;
  box-sizing: border-box;
  color: #6c6457;
  font-size: 13px;
  line-height: 21px;
  text-align: center;
}

.health-state__retry {
  height: 40px;
  margin: 0;
  padding: 0 24px;
  color: #586b3f;
  background: #fff;
  border-radius: 12px;
  font-size: 13px;
  line-height: 40px;
}

.health-state__retry::after {
  border: 0;
}

.health-entry,
.health-result-screen,
.health-safety-screen {
  position: relative;
  width: 100%;
  min-height: 844px;
  box-sizing: border-box;
}

.health-entry {
  padding-bottom: 164px;
}

.health-entry__tab-header {
  position: absolute;
  top: 78px;
  left: 20px;
  display: flex;
  align-items: center;
  width: calc(100% - 40px);
  height: 38px;
}

.health-entry__wordmark {
  width: 84px;
  height: 22px;
}

.health-entry__eyebrow {
  position: absolute;
  top: 134px;
  left: 20px;
  width: calc(100% - 40px);
  color: #586b3f;
  font-size: 12px;
  font-weight: 600;
  line-height: 18px;
  letter-spacing: 2px;
}

.health-entry__title {
  position: absolute;
  top: 168px;
  left: 20px;
  width: calc(100% - 40px);
  color: #080806;
  font-size: 26px;
  font-weight: 600;
  line-height: 36px;
  white-space: pre-line;
}

.health-entry__description {
  position: absolute;
  top: 256px;
  left: 20px;
  width: calc(100% - 40px);
  color: #6c6457;
  font-size: 13px;
  line-height: 21px;
  white-space: pre-line;
}

.health-entry__step {
  position: absolute;
  left: 20px;
  display: flex;
  align-items: center;
  width: calc(100% - 40px);
  height: 74px;
  padding: 0 16px;
  box-sizing: border-box;
  color: #433e34;
  background: #fff;
  border-radius: 12px;
}

.health-entry__step--active {
  background: #eef1e8;
}

.health-entry__step--01 {
  top: 326px;
}

.health-entry__step--02 {
  top: 412px;
}

.health-entry__step--03 {
  top: 498px;
}

.health-entry__step-number {
  flex: 0 0 36px;
  color: #8a8172;
  font-size: 11px;
  line-height: 18px;
}

.health-entry__step-copy {
  color: #433e34;
  font-size: 14px;
  font-weight: 500;
  line-height: 21px;
  white-space: pre-line;
}

.health-entry__start,
.health-safety-screen__return {
  position: absolute;
  left: 20px;
  height: 56px;
  margin: 0;
  padding: 0;
  color: #fff;
  background: #586b3f;
  border-radius: 12px;
  font-size: 14px;
  font-weight: 500;
  line-height: 56px;
  width: calc(100% - 40px) !important;
}

.health-entry__start {
  top: 610px;
}

.health-entry__start::after,
.health-safety-screen__return::after {
  border: 0;
}

.health-entry__eligibility {
  position: absolute;
  top: 680px;
  left: 20px;
  width: calc(100% - 40px);
  color: #8a8172;
  font-size: 11px;
  line-height: 18px;
  text-align: center;
}

.health-result-screen {
  min-height: 980px;
  padding-bottom: 140px;
}

.health-result-screen__wordmark {
  position: absolute;
  top: 78px;
  left: 20px;
  color: #080806;
  font-size: 27px;
  font-weight: 600;
  line-height: 34px;
}

.health-result__classification {
  position: absolute;
  top: 132px;
  left: 20px;
  width: calc(100% - 40px);
  height: 164px;
  padding: 20px;
  box-sizing: border-box;
  color: #fff;
  background: #586b3f;
  border-radius: 16px;
}

.health-result__label,
.health-result__title {
  display: block;
}

.health-result__label {
  color: rgba(255, 255, 255, 0.72);
  font-size: 12px;
  line-height: 18px;
}

.health-result__title {
  margin-top: 12px;
  font-size: 24px;
  font-weight: 600;
  line-height: 32px;
}

.health-result__tags {
  display: flex;
  gap: 8px;
  margin-top: 14px;
}

.health-result__tags text {
  display: block;
  min-width: 70px;
  height: 30px;
  padding: 0 12px;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.14);
  border-radius: 15px;
  font-size: 11px;
  line-height: 30px;
  text-align: center;
}

.health-result__tips-title {
  position: absolute;
  top: 326px;
  left: 20px;
  width: calc(100% - 40px);
  color: #080806;
  font-size: 20px;
  font-weight: 600;
  line-height: 28px;
}

.health-result__tips {
  position: absolute;
  top: 370px;
  left: 20px;
  width: calc(100% - 40px);
}

.health-result__tip {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 78px;
  margin-bottom: 10px;
  padding: 14px 16px;
  box-sizing: border-box;
  background: #fff;
  border-radius: 12px;
}

.health-result__tip-number {
  flex: 0 0 40px;
  color: #8a8172;
  font-size: 11px;
  line-height: 18px;
}

.health-result__tip-copy {
  color: #433e34;
  font-size: 13px;
  line-height: 20px;
}

.health-result__recommendations {
  position: absolute;
  top: 644px;
  left: 20px;
  width: calc(100% - 40px);
}

.health-result__recommendation {
  position: relative;
  width: 100%;
  min-height: 86px;
  margin-bottom: 10px;
  padding: 15px 110px 14px 16px;
  box-sizing: border-box;
  background: #eef1e8;
  border-radius: 12px;
}

.health-result__recommendation-title,
.health-result__recommendation-copy {
  display: block;
}

.health-result__recommendation-title {
  color: #344126;
  font-size: 14px;
  font-weight: 600;
  line-height: 20px;
}

.health-result__recommendation-copy {
  margin-top: 5px;
  overflow: hidden;
  color: #6c6457;
  font-size: 11px;
  line-height: 16px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.health-result__recommendation-status {
  position: absolute;
  top: 32px;
  right: 16px;
  color: #8a8172;
  font-size: 11px;
  line-height: 18px;
}

.health-result__consent {
  position: absolute;
  top: 836px;
  left: 50%;
  width: 200px;
  height: 36px;
  margin: 0;
  padding: 0;
  color: #586b3f;
  background: transparent;
  font-size: 12px;
  line-height: 36px;
  transform: translateX(-50%);
}

.health-result__consent::after {
  border: 0;
}

.health-safety-screen {
  min-height: 844px;
  background: #fbf2ed;
}

.health-safety-screen__eyebrow {
  position: absolute;
  top: 142px;
  left: 20px;
  color: #b67855;
  font-size: 12px;
  font-weight: 600;
  line-height: 18px;
  letter-spacing: 1px;
}

.health-safety-screen__icon {
  position: absolute;
  top: 188px;
  left: 20px;
  width: 56px;
  height: 56px;
  color: #fff;
  background: #b67855;
  border-radius: 50%;
  font-size: 30px;
  font-weight: 500;
  line-height: 56px;
  text-align: center;
}

.health-safety-screen__title {
  position: absolute;
  top: 278px;
  left: 20px;
  width: calc(100% - 40px);
  color: #080806;
  font-size: 26px;
  font-weight: 600;
  line-height: 36px;
  white-space: pre-line;
}

.health-safety-screen__body {
  position: absolute;
  top: 374px;
  left: 20px;
  width: calc(100% - 40px);
  color: #6c6457;
  font-size: 14px;
  line-height: 22px;
}

.health-safety-screen__guidance {
  position: absolute;
  top: 474px;
  left: 20px;
  width: calc(100% - 40px);
  min-height: 156px;
  padding: 17px 16px;
  box-sizing: border-box;
  background: #fff;
  border-radius: 14px;
}

.health-safety-screen__guidance-title {
  display: block;
  color: #080806;
  font-size: 14px;
  font-weight: 600;
  line-height: 20px;
}

.health-safety-screen__guidance-row {
  display: flex;
  gap: 8px;
  margin-top: 8px;
  color: #433e34;
  font-size: 12px;
  line-height: 17px;
}

.health-safety-screen__guidance-row text:first-child {
  color: #b67855;
}

.health-safety-screen__notice {
  position: absolute;
  top: 654px;
  left: 20px;
  width: calc(100% - 40px);
  color: #8a8172;
  font-size: 11px;
  line-height: 18px;
}

.health-safety-screen__return {
  top: 724px;
  background: #b67855;
}

/* v0.6.0 仅扩展健康入口，沿用本页原有字号、颜色和卡片语言。 */
.health-entry--v060 {
  min-height: 980px;
  padding-bottom: 160px;
}

.health-entry--v060 .health-entry__description {
  white-space: normal;
}

.health-assessment-list {
  position: absolute;
  top: 338px;
  left: 20px;
  width: calc(100% - 40px);
}

.health-assessment-card {
  margin-bottom: 12px;
  padding: 17px 16px;
  background: #fff;
  border-radius: 12px;
}

.health-assessment-card__top,
.health-assessment-card__actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.health-assessment-card__title,
.health-assessment-card__meta,
.health-assessment-card__copy {
  display: block;
}

.health-assessment-card__title {
  color: #080806;
  font-size: 15px;
  font-weight: 600;
  line-height: 22px;
}

.health-assessment-card__meta,
.health-assessment-card__status {
  color: #586b3f;
  font-size: 11px;
  line-height: 18px;
}

.health-assessment-card__copy {
  margin-top: 10px;
  color: #6c6457;
  font-size: 12px;
  line-height: 19px;
}

.health-assessment-card__actions {
  margin-top: 14px;
}

.health-assessment-card__start {
  flex: 1;
  width: auto !important;
  min-width: 0;
  height: 44px;
  margin: 0;
  padding: 0 18px;
  box-sizing: border-box;
  color: #fff;
  background: #586b3f;
  border-radius: 10px;
  font-size: 12px;
  line-height: 44px;
}

.health-assessment-card__start::after,
.health-history-entry::after {
  border: 0;
}

.health-assessment-card__start[disabled] {
  color: #8a8172;
  background: #e8e0d0;
}

.health-assessment-card__latest {
  display: flex;
  flex: 0 0 auto;
  min-height: 44px;
  align-items: center;
  color: #586b3f;
  font-size: 12px;
  line-height: 18px;
  white-space: nowrap;
}

.health-history-entry {
  position: absolute;
  top: 730px;
  left: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  width: calc(100% - 40px) !important;
  height: 50px;
  min-height: 50px;
  margin: 0;
  padding: 0 16px;
  box-sizing: border-box;
  color: #433e34;
  background: #eef1e8;
  border-radius: 12px;
  font-size: 13px;
  line-height: 20px;
  text-align: center;
  white-space: nowrap;
}

.health-local-note {
  position: absolute;
  top: 796px;
  left: 20px;
  width: calc(100% - 40px);
  color: #8a8172;
  font-size: 11px;
  line-height: 18px;
  text-align: center;
}

@media (max-width: 374px) {
  .health-entry,
  .health-result-screen,
  .health-safety-screen {
    transform-origin: top left;
  }

  .health-entry__start,
  .health-safety-screen__return {
    width: calc(100vw - 40px) !important;
  }
}
