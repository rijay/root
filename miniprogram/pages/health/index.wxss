page {
  background: var(--color-brand-white);
}

.health-page {
  height: 100vh;
  background: var(--color-brand-white);
}

.health-page--safety {
  background: var(--color-danger-tint);
}

.health-state {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 16px;
  min-height: calc(100vh - 52px - env(safe-area-inset-bottom));
  padding: 40px 20px;
  box-sizing: border-box;
  color: var(--color-neutral-grey);
  font-size: 13px;
  line-height: 21px;
  text-align: center;
}

.health-state__retry {
  height: 40px;
  margin: 0;
  padding: 0 24px;
  color: var(--color-brand-olive);
  background: var(--color-brand-white);
  border-radius: 12px;
  font-size: 13px;
  line-height: 40px;
}

.health-state__retry::after {
  border: 0;
}

.health-entry,
.health-result-screen,
.health-safety-screen {
  position: relative;
  width: 100%;
  min-height: 844px;
  box-sizing: border-box;
}

.health-entry {
  padding-bottom: 164px;
}

.health-entry__tab-header {
  position: absolute;
  top: 78px;
  left: 20px;
  display: flex;
  align-items: center;
  width: calc(100% - 40px);
  height: 38px;
}

.health-entry__wordmark {
  width: 84px;
  height: 22px;
}

.health-entry__eyebrow {
  position: absolute;
  top: 134px;
  left: 20px;
  width: calc(100% - 40px);
  color: var(--color-brand-olive);
  font-size: 12px;
  font-weight: 600;
  line-height: 18px;
  letter-spacing: 2px;
}

.health-entry__title {
  position: absolute;
  top: 168px;
  left: 20px;
  width: calc(100% - 40px);
  color: var(--color-brand-black);
  font-size: 26px;
  font-weight: 600;
  line-height: 36px;
  white-space: pre-line;
}

.health-entry__description {
  position: absolute;
  top: 256px;
  left: 20px;
  width: calc(100% - 40px);
  color: var(--color-neutral-grey);
  font-size: 13px;
  line-height: 21px;
  white-space: pre-line;
}

.health-entry__step {
  position: absolute;
  left: 20px;
  display: flex;
  align-items: center;
  width: calc(100% - 40px);
  height: 74px;
  padding: 0 16px;
  box-sizing: border-box;
  color: var(--color-graphite);
  background: var(--color-brand-white);
  border-radius: 12px;
}

.health-entry__step--active {
  background: var(--color-olive-tint);
}

.health-entry__step--01 {
  top: 326px;
}

.health-entry__step--02 {
  top: 412px;
}

.health-entry__step--03 {
  top: 498px;
}

.health-entry__step-number {
  flex: 0 0 36px;
  color: var(--color-neutral-grey);
  font-size: 11px;
  line-height: 18px;
}

.health-entry__step-copy {
  color: var(--color-graphite);
  font-size: 14px;
  font-weight: 500;
  line-height: 21px;
  white-space: pre-line;
}

.health-entry__start,
.health-safety-screen__return {
  position: absolute;
  left: 20px;
  height: 56px;
  margin: 0;
  padding: 0;
  color: var(--color-brand-white);
  background: var(--color-brand-olive);
  border-radius: 12px;
  font-size: 14px;
  font-weight: 500;
  line-height: 56px;
  width: calc(100% - 40px) !important;
}

.health-entry__start {
  top: 610px;
}

.health-entry__start::after,
.health-safety-screen__return::after {
  border: 0;
}

.health-entry__eligibility {
  position: absolute;
  top: 680px;
  left: 20px;
  width: calc(100% - 40px);
  color: var(--color-neutral-grey);
  font-size: 11px;
  line-height: 18px;
  text-align: center;
}

.health-result-screen {
  min-height: 980px;
  padding-bottom: 140px;
}

.health-result-screen__wordmark {
  position: absolute;
  top: 78px;
  left: 20px;
  color: var(--color-brand-black);
  font-size: 27px;
  font-weight: 600;
  line-height: 34px;
}

.health-result__classification {
  position: absolute;
  top: 132px;
  left: 20px;
  width: calc(100% - 40px);
  height: 164px;
  padding: 20px;
  box-sizing: border-box;
  color: var(--color-brand-white);
  background: var(--color-brand-olive);
  border-radius: 16px;
}

.health-result__label,
.health-result__title {
  display: block;
}

.health-result__label {
  color: rgba(255, 255, 255, 0.72);
  font-size: 12px;
  line-height: 18px;
}

.health-result__title {
  margin-top: 12px;
  font-size: 24px;
  font-weight: 600;
  line-height: 32px;
}

.health-result__tags {
  display: flex;
  gap: 8px;
  margin-top: 14px;
}

.health-result__tags text {
  display: block;
  min-width: 70px;
  height: 30px;
  padding: 0 12px;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.14);
  border-radius: 15px;
  font-size: 11px;
  line-height: 30px;
  text-align: center;
}

.health-result__tips-title {
  position: absolute;
  top: 326px;
  left: 20px;
  width: calc(100% - 40px);
  color: var(--color-brand-black);
  font-size: 20px;
  font-weight: 600;
  line-height: 28px;
}

.health-result__tips {
  position: absolute;
  top: 370px;
  left: 20px;
  width: calc(100% - 40px);
}

.health-result__tip {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 78px;
  margin-bottom: 10px;
  padding: 14px 16px;
  box-sizing: border-box;
  background: var(--color-brand-white);
  border-radius: 12px;
}

.health-result__tip-number {
  flex: 0 0 40px;
  color: var(--color-neutral-grey);
  font-size: 11px;
  line-height: 18px;
}

.health-result__tip-copy {
  color: var(--color-graphite);
  font-size: 13px;
  line-height: 20px;
}

.health-result__recommendations {
  position: absolute;
  top: 644px;
  left: 20px;
  width: calc(100% - 40px);
}

.health-result__recommendation {
  position: relative;
  width: 100%;
  min-height: 86px;
  margin-bottom: 10px;
  padding: 15px 110px 14px 16px;
  box-sizing: border-box;
  background: var(--color-olive-tint);
  border-radius: 12px;
}

.health-result__recommendation-title,
.health-result__recommendation-copy {
  display: block;
}

.health-result__recommendation-title {
  color: var(--color-olive-dark);
  font-size: 14px;
  font-weight: 600;
  line-height: 20px;
}

.health-result__recommendation-copy {
  margin-top: 5px;
  overflow: hidden;
  color: var(--color-neutral-grey);
  font-size: 11px;
  line-height: 16px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.health-result__recommendation-status {
  position: absolute;
  top: 32px;
  right: 16px;
  color: var(--color-neutral-grey);
  font-size: 11px;
  line-height: 18px;
}

.health-result__consent {
  position: absolute;
  top: 836px;
  left: 50%;
  width: 200px;
  height: 36px;
  margin: 0;
  padding: 0;
  color: var(--color-brand-olive);
  background: transparent;
  font-size: 12px;
  line-height: 36px;
  transform: translateX(-50%);
}

.health-result__consent::after {
  border: 0;
}

.health-safety-screen {
  min-height: 844px;
  background: var(--color-danger-tint);
}

.health-safety-screen__eyebrow {
  position: absolute;
  top: 142px;
  left: 20px;
  color: var(--color-olive-mid);
  font-size: 12px;
  font-weight: 600;
  line-height: 18px;
  letter-spacing: 1px;
}

.health-safety-screen__icon {
  position: absolute;
  top: 188px;
  left: 20px;
  width: 56px;
  height: 56px;
  color: var(--color-brand-white);
  background: var(--color-olive-mid);
  border-radius: 50%;
  font-size: 30px;
  font-weight: 500;
  line-height: 56px;
  text-align: center;
}

.health-safety-screen__title {
  position: absolute;
  top: 278px;
  left: 20px;
  width: calc(100% - 40px);
  color: var(--color-brand-black);
  font-size: 26px;
  font-weight: 600;
  line-height: 36px;
  white-space: pre-line;
}

.health-safety-screen__body {
  position: absolute;
  top: 374px;
  left: 20px;
  width: calc(100% - 40px);
  color: var(--color-neutral-grey);
  font-size: 14px;
  line-height: 22px;
}

.health-safety-screen__guidance {
  position: absolute;
  top: 474px;
  left: 20px;
  width: calc(100% - 40px);
  min-height: 156px;
  padding: 17px 16px;
  box-sizing: border-box;
  background: var(--color-brand-white);
  border-radius: 14px;
}

.health-safety-screen__guidance-title {
  display: block;
  color: var(--color-brand-black);
  font-size: 14px;
  font-weight: 600;
  line-height: 20px;
}

.health-safety-screen__guidance-row {
  display: flex;
  gap: 8px;
  margin-top: 8px;
  color: var(--color-graphite);
  font-size: 12px;
  line-height: 17px;
}

.health-safety-screen__guidance-row text:first-child {
  color: var(--color-olive-mid);
}

.health-safety-screen__notice {
  position: absolute;
  top: 654px;
  left: 20px;
  width: calc(100% - 40px);
  color: var(--color-neutral-grey);
  font-size: 11px;
  line-height: 18px;
}

.health-safety-screen__return {
  top: 724px;
  background: var(--color-olive-mid);
}

/* v0.7.0 健康入口、账号记录与综合建议。 */
.health-entry--v060 {
  min-height: 1460px;
  padding-bottom: 160px;
}

.health-entry--v060 .health-entry__description {
  white-space: normal;
}

.health-assessment-list {
  position: absolute;
  top: 338px;
  left: 20px;
  width: calc(100% - 40px);
}

.health-assessment-card {
  margin-bottom: 12px;
  padding: 17px 16px;
  background: var(--color-brand-white);
  border-radius: 12px;
}

.health-assessment-card__top,
.health-assessment-card__actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.health-assessment-card__title,
.health-assessment-card__meta,
.health-assessment-card__copy {
  display: block;
}

.health-assessment-card__title {
  color: var(--color-brand-black);
  font-size: 15px;
  font-weight: 600;
  line-height: 22px;
}

.health-assessment-card__meta,
.health-assessment-card__status {
  color: var(--color-brand-olive);
  font-size: 11px;
  line-height: 18px;
}

.health-assessment-card__copy {
  margin-top: 10px;
  color: var(--color-neutral-grey);
  font-size: 12px;
  line-height: 19px;
}

.health-assessment-card__actions {
  margin-top: 14px;
}

.health-assessment-card__start {
  flex: 1;
  width: auto !important;
  min-width: 0;
  height: 44px;
  margin: 0;
  padding: 0 18px;
  box-sizing: border-box;
  color: var(--color-brand-white);
  background: var(--color-brand-olive);
  border-radius: 10px;
  font-size: 12px;
  line-height: 44px;
}

.health-assessment-card__start::after,
.health-history-entry::after {
  border: 0;
}

.health-assessment-card__start[disabled] {
  color: var(--color-neutral-grey);
  background: var(--color-ui-line-solid);
}

.health-assessment-card__latest {
  display: flex;
  flex: 0 0 auto;
  min-height: 44px;
  align-items: center;
  color: var(--color-brand-olive);
  font-size: 12px;
  line-height: 18px;
  white-space: nowrap;
}

.health-history-entry {
  position: absolute;
  top: 730px;
  left: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  width: calc(100% - 40px) !important;
  height: 50px;
  min-height: 50px;
  margin: 0;
  padding: 0 16px;
  box-sizing: border-box;
  color: var(--color-graphite);
  background: var(--color-olive-tint);
  border-radius: 12px;
  font-size: 13px;
  line-height: 20px;
  text-align: center;
  white-space: nowrap;
}

.health-local-note {
  position: absolute;
  top: 796px;
  left: 20px;
  width: calc(100% - 40px);
  color: var(--color-neutral-grey);
  font-size: 11px;
  line-height: 18px;
  text-align: center;
}

.health-overview-card {
  position: absolute;
  top: 856px;
  left: 20px;
  width: calc(100% - 40px);
  padding: 20px 16px;
  box-sizing: border-box;
  background: var(--color-olive-tint);
  border: 1px solid var(--color-ui-line);
  border-radius: 16px;
}

.health-overview-card__head,
.health-overview-state,
.health-advice__action,
.health-overview-error {
  display: flex;
  align-items: center;
}

.health-overview-card__head,
.health-overview-state {
  justify-content: space-between;
  gap: 12px;
}

.health-overview-card__eyebrow,
.health-overview-card__source,
.health-overview-state__type,
.health-overview-state__time {
  font-size: 10px;
  line-height: 16px;
}

.health-overview-card__eyebrow,
.health-overview-card__source {
  color: var(--color-brand-olive);
  font-weight: 600;
  letter-spacing: 1px;
}

.health-overview-card__source {
  padding: 3px 8px;
  background: var(--color-brand-white);
  border-radius: 10px;
  letter-spacing: 0;
}

.health-overview-card__title {
  display: block;
  margin-top: 10px;
  color: var(--color-brand-black);
  font-size: 20px;
  font-weight: 600;
  line-height: 28px;
}

.health-overview-states {
  margin-top: 14px;
  background: var(--color-brand-white);
  border-radius: 12px;
}

.health-overview-state {
  min-height: 64px;
  padding: 10px 12px;
  box-sizing: border-box;
  border-bottom: 1px solid var(--color-ui-line);
}

.health-overview-state:last-child {
  border-bottom: 0;
}

.health-overview-state__type,
.health-overview-state__time {
  display: block;
  color: var(--color-neutral-grey);
}

.health-overview-state__value {
  max-width: 56%;
  color: var(--color-brand-black);
  font-size: 13px;
  font-weight: 600;
  line-height: 19px;
  text-align: right;
}

.health-overview-pending,
.health-overview-error,
.health-advice__summary,
.health-advice__follow-up,
.health-advice__caution,
.health-overview-card__disclaimer {
  display: block;
  color: var(--color-neutral-grey);
  font-size: 11px;
  line-height: 18px;
}

.health-overview-pending {
  margin-top: 14px;
  padding: 12px;
  background: var(--color-brand-white);
  border-radius: 10px;
}

.health-overview-pending--generating {
  border-left: 3px solid var(--color-brand-olive);
}

.health-overview-pending__title,
.health-overview-pending__detail,
.health-advice__source-note {
  display: block;
}

.health-overview-pending__title {
  color: var(--color-graphite);
  font-size: 12px;
  font-weight: 600;
  line-height: 19px;
}

.health-overview-pending__detail {
  margin-top: 4px;
  color: var(--color-neutral-grey);
  font-size: 10px;
  line-height: 16px;
}

.health-advice {
  margin-top: 16px;
}

.health-advice__source-note {
  margin-bottom: 12px;
  padding: 9px 10px;
  color: var(--color-neutral-grey);
  background: var(--color-brand-white);
  border-radius: 9px;
  font-size: 10px;
  line-height: 16px;
}

.health-advice__source-note--model {
  color: var(--color-olive-dark);
}

.health-advice__source-note--safety {
  color: var(--color-danger);
  background: var(--color-danger-tint);
}

.health-advice__summary {
  color: var(--color-graphite);
  font-size: 13px;
  line-height: 20px;
}

.health-advice__actions {
  margin-top: 10px;
}

.health-advice__action {
  align-items: flex-start;
  gap: 10px;
  padding: 10px 0;
  color: var(--color-graphite);
  border-top: 1px solid var(--color-ui-line);
  font-size: 12px;
  line-height: 19px;
}

.health-advice__number {
  flex: 0 0 24px;
  color: var(--color-brand-olive);
  font-size: 10px;
  font-weight: 600;
}

.health-advice__follow-up,
.health-advice__caution,
.health-overview-card__disclaimer {
  margin-top: 10px;
}

.health-advice__caution {
  color: var(--color-danger);
}

.health-overview-error {
  justify-content: space-between;
  gap: 10px;
  margin-top: 12px;
  padding: 10px 12px;
  color: var(--color-danger);
  background: var(--color-danger-tint);
  border-radius: 10px;
}

.health-overview-error button {
  flex: 0 0 auto;
  min-height: 34px;
  margin: 0;
  padding: 0 12px;
  color: var(--color-danger);
  background: var(--color-brand-white);
  border: 0;
  font-size: 11px;
  line-height: 34px;
}

.health-overview-error button::after {
  border: 0;
}

@media (max-width: 374px) {
  .health-entry,
  .health-result-screen,
  .health-safety-screen {
    transform-origin: top left;
  }

  .health-entry__start,
  .health-safety-screen__return {
    width: calc(100vw - 40px) !important;
  }
}
