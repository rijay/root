.health-page { padding-top: 0; }
.health-intro { margin: 0 calc(-1 * var(--spacing-md)); padding: 72rpx var(--spacing-lg) 64rpx; color: var(--color-root-nav); background: linear-gradient(148deg, var(--color-brand-olive) 0%, var(--color-root-moss) 58%, var(--color-olive-mid) 100%); }
.health-kicker, .state-eyebrow { font-size: var(--font-size-xs); font-weight: 700; letter-spacing: 2rpx; }
.health-kicker { color: rgba(255, 255, 255, 0.72); }
.health-title { margin-top: 72rpx; font-size: var(--font-size-2xl); font-weight: 750; line-height: 1.16; }
.health-copy { max-width: 620rpx; margin-top: var(--spacing-md); color: rgba(255, 255, 255, 0.82); font-size: var(--font-size-sm); line-height: 1.72; }
.state-card { margin-top: var(--spacing-lg); }
.state-eyebrow { color: var(--color-olive-mid); }
.state-title { margin-top: var(--spacing-sm); }
.state-copy { margin-top: var(--spacing-sm); }
.state-action { width: 100%; margin-top: var(--spacing-lg); padding: 0; }
.health-section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--spacing-md); margin-top: var(--spacing-xl); }
.history-link { min-height: 88rpx; margin: 0 -20rpx -14rpx 0; padding: 0 20rpx; color: var(--color-olive-mid); background: transparent; border: 0; font-size: var(--font-size-sm); line-height: 88rpx; }
.history-link::after, .text-action::after, .assessment-action::after { border: 0; }
.assessment-list { display: grid; gap: var(--spacing-md); margin-top: var(--spacing-md); }
.assessment-card { padding: var(--spacing-lg); overflow: hidden; background: var(--color-root-surface); border: 1rpx solid var(--color-root-line); border-radius: var(--radius-card); box-shadow: var(--shadow-sm); }
.assessment-card--primary { color: var(--color-root-nav); background: linear-gradient(148deg, var(--color-brand-olive) 0%, var(--color-olive-mid) 100%); border-color: transparent; }
.assessment-card__top, .assessment-meta, .latest-result { display: flex; align-items: center; }
.assessment-card__top { justify-content: space-between; gap: var(--spacing-md); }
.assessment-card__type { color: var(--color-olive-mid); font-size: var(--font-size-xs); font-weight: 800; letter-spacing: 3rpx; }
.assessment-card--primary .assessment-card__type { color: var(--color-accent-on-dark); }
.assessment-status { padding: 8rpx 16rpx; color: var(--color-root-muted); background: var(--color-root-bg); border-radius: var(--radius-full); font-size: var(--font-size-xs); font-weight: 650; }
.assessment-status.is-ready { color: var(--color-brand-olive); background: var(--color-olive-tint); }
.assessment-card--primary .assessment-status { color: rgba(255, 255, 255, 0.72); background: rgba(255, 255, 255, 0.12); }
.assessment-card--primary .assessment-status.is-ready { color: var(--color-root-nav); background: rgba(161, 179, 113, 0.24); }
.assessment-title { margin-top: 48rpx; font-size: 44rpx; font-weight: 780; line-height: 1.18; }
.assessment-copy { margin-top: var(--spacing-sm); color: var(--color-root-copy); font-size: var(--font-size-sm); line-height: 1.7; }
.assessment-card--primary .assessment-copy { color: rgba(255, 255, 255, 0.78); }
.assessment-meta { flex-wrap: wrap; gap: 12rpx 24rpx; margin-top: var(--spacing-md); color: var(--color-root-muted); font-size: var(--font-size-xs); }
.assessment-card--primary .assessment-meta { color: rgba(255, 255, 255, 0.62); }
.latest-result { justify-content: space-between; gap: var(--spacing-sm); min-height: 88rpx; margin-top: var(--spacing-md); padding: 18rpx 20rpx; box-sizing: border-box; background: var(--color-root-bg); border-radius: var(--radius-md); font-size: var(--font-size-sm); }
.assessment-card--primary .latest-result { background: rgba(255, 255, 255, 0.1); }
.latest-label { color: var(--color-root-muted); font-size: var(--font-size-xs); }
.assessment-card--primary .latest-label { color: rgba(255, 255, 255, 0.58); }
.latest-title { margin-top: 4rpx; font-weight: 700; }
.assessment-action { width: 100%; min-height: 104rpx; margin-top: var(--spacing-lg); padding: 0 var(--spacing-md); color: var(--color-brand-white); background: var(--color-brand-olive); border: 0; border-radius: var(--radius-control); font-size: var(--font-size-lg); font-weight: 720; line-height: 104rpx; }
.assessment-card--primary .assessment-action { color: var(--color-brand-olive); background: var(--color-brand-white); }
.assessment-action.is-disabled { color: var(--color-root-muted); background: var(--color-root-line); }
.review-note { margin-top: var(--spacing-md); }
.text-action { width: 100%; margin-top: var(--spacing-sm); padding: var(--spacing-sm); color: var(--color-olive-mid); background: transparent; border: 0; font-size: var(--font-size-sm); line-height: 1.5; }
.health-note { display: flex; gap: var(--spacing-sm); margin-top: var(--spacing-lg); padding: 0 var(--spacing-sm); color: var(--color-root-muted); font-size: var(--font-size-xs); line-height: 1.65; }
.health-note-mark { flex: 0 0 24rpx; width: 24rpx; height: 4rpx; margin-top: 17rpx; background: var(--color-olive-mid); }
