<scroll-view class="health-page" scroll-y enhanced show-scrollbar="{{false}}">
  <view wx:if="{{loading}}" class="health-state" role="status" aria-live="polite">
    <text>正在整理健康评测…</text>
  </view>

  <view wx:elif="{{errorText}}" class="health-state" role="alert">
    <text>{{errorText}}</text>
    <button class="health-state__retry" bindtap="loadCatalog">重新加载</button>
  </view>

  <view wx:else class="health-entry health-entry--v060">
    <view class="health-entry__tab-header">
      <root-wordmark class="health-entry__wordmark" />
    </view>
    <text class="health-entry__eyebrow">ROOT4U</text>
    <text class="health-entry__title">从此刻开始，\n理解自己的健康起点</text>

    <view class="health-assessment-list">
      <view wx:for="{{assessments}}" wx:key="assessmentType" class="health-assessment-card" role="group" aria-label="{{item.title}}">
        <view class="health-assessment-card__top">
          <view>
            <text class="health-assessment-card__title">{{item.title}}</text>
            <text class="health-assessment-card__meta">{{item.estimatedText}}</text>
          </view>
          <text class="health-assessment-card__status">{{item.canResume ? '继续' : item.latest ? '可回测' : '未开始'}}</text>
        </view>
        <text class="health-assessment-card__copy">{{item.description}}</text>
        <view class="health-assessment-card__actions">
          <button class="health-assessment-card__start" data-type="{{item.assessmentType}}" bindtap="startAssessment" disabled="{{item.available === false}}" aria-label="{{item.available === false ? item.unavailableText : item.canResume ? '继续' + item.title : item.latest ? '重新进行' + item.title : '开始' + item.title}}">{{item.available === false ? item.unavailableText : item.canResume ? '继续评测' : item.latest ? '重新评测' : '开始评测'}}</button>
          <text wx:if="{{item.latest}}" class="health-assessment-card__latest" data-assessment-id="{{item.latest.assessmentId}}" bindtap="openLatest" role="button" aria-label="查看 {{item.title}} 最近结果">查看最近结果</text>
        </view>
      </view>
    </view>

    <button class="health-history-entry" bindtap="openHistory">评测历史与回测对比</button>
    <text wx:if="{{storageMode === 'SERVER'}}" class="health-local-note">问卷答案、评测结果和回测记录会安全保存到你的 myRoot 账号，可跨设备查看，也可在评测历史中删除。</text>

    <view class="health-overview-card">
      <view class="health-overview-card__head">
        <text class="health-overview-card__eyebrow">YOUR CURRENT STATE</text>
      </view>
      <text class="health-overview-card__title">当前状态与健康建议</text>

      <view wx:if="{{overview && overview.states.length}}" class="health-overview-states">
        <view wx:for="{{overview.states}}" wx:key="assessmentId" class="health-overview-state">
          <view>
            <text class="health-overview-state__type">{{item.typeLabel}}</text>
            <text class="health-overview-state__time">{{item.completedAtText}}</text>
          </view>
          <text class="health-overview-state__value">{{item.title}}</text>
        </view>
      </view>

      <view wx:if="{{overview && !overview.ready}}" class="health-overview-pending">
        还需完成：{{overview.missingText}}。完成两项评测后生成综合建议。
      </view>

      <view wx:if="{{adviceLoading}}" class="health-overview-pending health-overview-pending--generating" role="status" aria-live="polite">
        <text class="health-overview-pending__title">{{adviceStatusText}}</text>
        <text wx:if="{{adviceConfirming}}" class="health-overview-pending__detail">无需重复点击，结果保存后会自动显示。</text>
      </view>

      <view wx:if="{{overview && overview.advice}}" class="health-advice">
        <text wx:if="{{overview.advice.sourceHint}}" class="health-advice__source-note health-advice__source-note--{{overview.advice.sourceTone}}">{{overview.advice.sourceHint}}</text>
        <text class="health-advice__summary">{{overview.advice.summary}}</text>
        <view class="health-advice__actions">
          <view wx:for="{{overview.advice.actions}}" wx:key="*this" class="health-advice__action">
            <text class="health-advice__number">0{{index + 1}}</text>
            <text>{{item}}</text>
          </view>
        </view>
        <text wx:if="{{overview.advice.followUp}}" class="health-advice__follow-up">{{overview.advice.followUp}}</text>
        <text wx:for="{{overview.advice.cautions}}" wx:key="*this" class="health-advice__caution">{{item}}</text>
      </view>

      <view wx:if="{{overviewErrorText}}" class="health-overview-error">
        <text>{{overviewErrorText}}</text>
        <button wx:if="{{overview && overview.ready}}" bindtap="generateAdvice">重试生成</button>
        <button wx:else bindtap="reloadOverview">重新加载</button>
      </view>
      <text class="health-overview-card__disclaimer">当前状态由已审核评测规则确定；建议仅用于日常健康管理参考，不构成诊断、治疗或用药建议。</text>
    </view>
  </view>
</scroll-view>
