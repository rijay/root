<scroll-view class="health-page" scroll-y enhanced show-scrollbar="{{false}}">
  <view wx:if="{{loading}}" class="health-state" role="status" aria-live="polite">
    <text>正在整理健康评测…</text>
  </view>

  <view wx:elif="{{errorText}}" class="health-state" role="alert">
    <text>{{errorText}}</text>
    <button class="health-state__retry" bindtap="loadCatalog">重新加载</button>
  </view>

  <view wx:else class="health-entry health-entry--v060">
    <view class="health-entry__tab-header">
      <root-wordmark class="health-entry__wordmark" />
    </view>
    <text class="health-entry__eyebrow">ROOT4U</text>
    <text class="health-entry__title">从此刻开始，\n理解自己的健康起点</text>
    <text class="health-entry__description">保留现有健康起点体验，增加可回测的初始评测与肠道规律自测。结果用于日常状态观察，不构成医疗诊断。</text>

    <view class="health-assessment-list">
      <view wx:for="{{assessments}}" wx:key="assessmentType" class="health-assessment-card" role="group" aria-label="{{item.title}}">
        <view class="health-assessment-card__top">
          <view>
            <text class="health-assessment-card__title">{{item.title}}</text>
            <text class="health-assessment-card__meta">{{item.estimatedText}}</text>
          </view>
          <text class="health-assessment-card__status">{{item.canResume ? '继续' : item.latest ? '可回测' : '未开始'}}</text>
        </view>
        <text class="health-assessment-card__copy">{{item.description}}</text>
        <view class="health-assessment-card__actions">
          <button class="health-assessment-card__start" data-type="{{item.assessmentType}}" bindtap="startAssessment" disabled="{{item.available === false}}" aria-label="{{item.available === false ? item.unavailableText : item.canResume ? '继续' + item.title : item.latest ? '重新进行' + item.title : '开始' + item.title}}">{{item.available === false ? item.unavailableText : item.canResume ? '继续评测' : item.latest ? '重新评测' : '开始评测'}}</button>
          <text wx:if="{{item.latest}}" class="health-assessment-card__latest" data-assessment-id="{{item.latest.assessmentId}}" bindtap="openLatest" role="button" aria-label="查看 {{item.title}} 最近结果">查看最近结果</text>
        </view>
      </view>
    </view>

    <button class="health-history-entry" bindtap="openHistory">评测历史与回测对比</button>
    <text wx:if="{{storageMode === 'LOCAL_DEVICE'}}" class="health-local-note">当前版本的问卷答案、评测结果和回测记录仅保存在此设备，不上传到 myRoot 服务器；自最后保存起最长保留 180 天。更换设备或清理小程序数据后无法恢复。</text>
  </view>
</scroll-view>
