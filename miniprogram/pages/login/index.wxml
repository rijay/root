<view class="login-page">
  <page-navigation />
  <view class="login-page__wordmark"><root-wordmark tone="dark" /></view>

  <view class="login-page__content">
    <text class="login-page__kicker">ROOT MEMBER CLUB</text>
    <view class="login-page__title">
      <text>注册Root会员</text>
      <text>探索更多可能</text>
    </view>

    <view wx:if="{{identityConflict}}" class="login-page__conflict" role="alert">
      <text class="login-page__conflict-title">资料核验中</text>
      <text class="login-page__conflict-copy">当前微信身份与会员资料存在冲突，我们不会自动覆盖。你仍可返回首页浏览公开内容，或联系客服处理。</text>
    </view>

    <button
      class="login-page__button"
      style="width: 350px;"
      open-type="getPhoneNumber"
      loading="{{loading}}"
      disabled="{{loading || !agreementAccepted}}"
      bindgetphonenumber="loginWithPhone"
    >{{loading ? '正在验证…' : '手机号快捷登录'}}</button>
    <view wx:if="{{loading && loginStatusText}}" class="login-page__status" aria-live="polite">{{loginStatusText}}</view>

    <view class="login-page__privacy">
      <checkbox-group bindchange="changeAgreement">
        <label class="login-page__agreement-option">
          <checkbox value="accepted" checked="{{agreementAccepted}}" color="#586B3F" />
          <text>我已阅读并同意</text>
        </label>
      </checkbox-group>
      <view class="login-page__agreement-links">
        <text class="login-page__link" catchtap="openUserAgreement">《用户协议》</text>
        <text>与</text>
        <text class="login-page__link" catchtap="openPrivacyPolicy">《隐私政策》</text>
      </view>
      <text class="login-page__privacy-hint">未勾选不会发起手机号授权，可先阅读协议或返回浏览公开内容</text>
    </view>
  </view>
  <privacy-consent id="root-privacy-consent" />
</view>
