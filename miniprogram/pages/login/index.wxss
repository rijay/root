.login-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 88rpx;
}

.login-logo {
  width: 500rpx;
  height: 84rpx;
  margin-top: var(--spacing-md);
}

.login-title {
  margin-top: 56rpx;
  color: var(--color-root-ink);
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.2;
  text-align: center;
}

.login-copy {
  width: 590rpx;
  margin-top: var(--spacing-md);
  color: var(--color-root-copy);
  font-size: var(--font-size-base);
  line-height: 1.65;
  text-align: center;
}

.login-card {
  width: 670rpx;
  margin-top: 72rpx;
  box-sizing: border-box;
}

.root-card-title {
  color: var(--color-root-ink);
  font-size: var(--font-size-lg);
  font-weight: 700;
}

.root-promise {
  margin-top: var(--spacing-md);
  color: var(--color-root-copy);
  font-size: var(--font-size-base);
  line-height: 1.45;
}

.agreement {
  display: flex;
  gap: var(--spacing-sm);
  align-items: center;
  margin: var(--spacing-lg) 0 var(--spacing-md);
  color: var(--color-text-secondary);
  font-size: var(--font-size-xs);
  line-height: 1.45;
}

.checkbox {
  display: flex;
  flex: 0 0 36rpx;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  color: var(--color-surface);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-xs);
}

.checkbox.checked {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.login-btn {
  width: 100%;
  margin-top: var(--spacing-lg);
}

.login-note {
  margin-top: var(--spacing-md);
  color: var(--color-text-tertiary);
  font-size: var(--font-size-xs);
  text-align: center;
}
