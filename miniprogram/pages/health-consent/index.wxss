.health-consent-page {
  padding-top: 48rpx;
  padding-bottom: calc(360rpx + env(safe-area-inset-bottom));
}

.consent-header {
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.consent-title {
  margin-top: 16rpx;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.3;
}

.consent-copy,
.consent-note,
.consent-list-item,
.consent-meta,
.consent-state {
  color: var(--color-text-secondary);
  font-size: 28rpx;
  line-height: 1.7;
}

.consent-copy,
.consent-note,
.consent-meta {
  margin-top: 16rpx;
}

.consent-section {
  padding: 32rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.consent-list-item {
  margin-top: 12rpx;
}

.consent-link {
  padding: 28rpx 0;
  color: var(--color-root-moss);
  font-size: 28rpx;
}

.consent-confirm {
  padding: 0 0 16rpx;
}

.consent-confirm-label {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  color: var(--color-text-primary);
  font-size: 28rpx;
  line-height: 1.6;
}

.consent-confirm-label checkbox {
  flex: 0 0 auto;
  margin-top: 4rpx;
}

.consent-actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16rpx;
  padding-top: 0;
}

.consent-dock {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid var(--color-border);
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.consent-actions button,
.consent-fallback,
.contact-button {
  width: 100%;
  margin: 0;
}

.consent-state {
  padding: 64rpx 0;
  text-align: center;
}

.consent-state--error {
  color: var(--color-danger);
}

.consent-fallback,
.contact-button {
  margin-top: 24rpx;
}

.contact-button {
  border: 0;
  background: transparent;
  color: var(--color-root-moss);
  font-size: 28rpx;
}

.contact-button::after {
  border: 0;
}

.consent-withdraw {
  background: var(--color-danger);
}
