.activity-shell { min-height: 100vh; padding: calc(108rpx + env(safe-area-inset-top)) 40rpx calc(160rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #fdfbf6; }
.activity-shell__eyebrow { display: block; color: #586b3f; font-size: 22rpx; font-weight: 600; letter-spacing: 3rpx; }
.activity-shell__title { display: block; margin-top: 14rpx; color: #080806; font-size: 64rpx; font-weight: 600; }
.activity-shell__date { display: block; margin-top: 54rpx; color: #8a8172; font-size: 22rpx; font-weight: 600; letter-spacing: 2rpx; }
.activity-shell__card { margin-top: 22rpx; overflow: hidden; background: #fff; border-radius: 30rpx; box-shadow: 0 12rpx 36rpx rgba(8,8,6,.08); }
.activity-shell__cover { height: 540rpx; background: linear-gradient(145deg, #152d3e 0%, #e99a41 56%, #5a3657 100%); }
.activity-shell__content { display: flex; flex-direction: column; padding: 32rpx; }
.activity-shell__tag { color: #586b3f; font-size: 22rpx; }
.activity-shell__name { margin-top: 14rpx; color: #080806; font-size: 34rpx; font-weight: 600; }
.activity-shell__meta { margin-top: 16rpx; color: #8a8172; font-size: 24rpx; }
