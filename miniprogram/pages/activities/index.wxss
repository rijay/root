.activities-page {
  padding-top: var(--spacing-lg);
}

.activities-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--spacing-md);
  padding: var(--spacing-sm) var(--spacing-xs) var(--spacing-lg);
}

.activities-kicker,
.state-label {
  color: var(--color-root-moss);
  font-size: var(--font-size-xs);
  font-weight: 750;
  letter-spacing: 2rpx;
}

.activities-title {
  max-width: 470rpx;
  margin-top: var(--spacing-sm);
  font-size: var(--font-size-xl);
  font-weight: 800;
  line-height: 1.24;
}

.enrollments-link,
.text-action,
.filter-clear-link,
.filter-date-clear,
.load-more {
  margin: 0;
  padding: 12rpx 0;
  color: var(--color-root-moss);
  background: transparent;
  border: 0;
  font-size: var(--font-size-sm);
  font-weight: 650;
  line-height: 1.5;
}

.enrollments-link::after,
.text-action::after,
.filter-clear-link::after,
.filter-date-clear::after,
.load-more::after,
.filter-trigger::after {
  border: 0;
}

.filter-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-md);
}

.filter-trigger {
  min-width: 150rpx;
  min-height: 64rpx;
  margin: 0;
  padding: 0 var(--spacing-md);
  color: var(--color-root-copy);
  background: var(--color-root-surface);
  border: 1rpx solid var(--color-root-line);
  border-radius: var(--radius-full);
  font-size: var(--font-size-sm);
  line-height: 64rpx;
}

.filter-trigger--active {
  color: var(--color-root-nav);
  background: var(--color-root-moss);
  border-color: var(--color-root-moss);
}

.filter-panel {
  margin-bottom: var(--spacing-lg);
}

.filter-field + .filter-field {
  margin-top: var(--spacing-md);
}

.filter-label {
  margin-bottom: var(--spacing-xs);
  color: var(--color-root-copy);
  font-size: var(--font-size-sm);
  font-weight: 700;
}

.filter-input {
  width: 100%;
  height: 76rpx;
  padding: 0 var(--spacing-md);
  box-sizing: border-box;
  color: var(--color-root-ink);
  background: var(--color-root-bg);
  border: 1rpx solid var(--color-root-line);
  border-radius: var(--radius-md);
  font-size: var(--font-size-base);
  line-height: 76rpx;
}

.filter-date-row {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
}

.filter-date-picker {
  flex: 1;
}

.filter-input--picker {
  color: var(--color-root-copy);
}

.filter-hint {
  margin-top: var(--spacing-xs);
  color: var(--color-root-muted);
  font-size: var(--font-size-xs);
  line-height: 1.5;
}

.filter-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--spacing-sm);
  margin-top: var(--spacing-lg);
}

.filter-action {
  width: 100%;
  margin: 0;
  padding: 0;
}

.activity-state {
  margin-top: var(--spacing-md);
}

.state-title,
.state-copy {
  margin-top: var(--spacing-sm);
}

.state-action {
  width: 100%;
  margin-top: var(--spacing-lg);
  padding: 0;
}

.text-action {
  width: 100%;
  margin-top: var(--spacing-sm);
  text-align: center;
}

.state-line {
  width: 56%;
  height: 28rpx;
  margin-top: var(--spacing-sm);
  background: var(--color-root-line);
  border-radius: var(--radius-full);
}

.state-line--wide {
  width: 86%;
  height: 240rpx;
  border-radius: var(--radius-card);
}

.activity-list {
  display: grid;
  gap: var(--spacing-lg);
}

.activity-card {
  overflow: hidden;
  background: var(--color-root-surface);
  border: 1rpx solid var(--color-root-line);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-sm);
}

.activity-card__visual {
  position: relative;
  min-height: 280rpx;
  overflow: hidden;
  color: var(--color-root-nav);
  background: linear-gradient(135deg, #222920, #78855f);
}

.activity-card__image,
.activity-card__shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.activity-card__shade {
  background: linear-gradient(180deg, rgba(8, 8, 6, 0.04), rgba(8, 8, 6, 0.62));
}

.activity-card__visual-copy {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--spacing-md);
  padding: var(--spacing-lg);
  box-sizing: border-box;
}

.activity-type {
  max-width: 420rpx;
  font-size: var(--font-size-lg);
  font-weight: 800;
  letter-spacing: 2rpx;
}

.activity-city {
  font-size: var(--font-size-xs);
}

.activity-card__body {
  padding: var(--spacing-lg);
}

.activity-card__topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--spacing-sm);
}

.activity-status,
.activity-capacity {
  color: var(--color-root-muted);
  font-size: var(--font-size-xs);
}

.activity-status--available {
  color: var(--color-root-moss);
  font-weight: 750;
}

.activity-status--closed {
  color: var(--color-root-clay);
}

.activity-card__title {
  margin-top: var(--spacing-md);
  font-size: var(--font-size-lg);
  font-weight: 750;
  line-height: 1.35;
}

.activity-card__meta {
  margin-top: var(--spacing-xs);
  color: var(--color-root-muted);
  font-size: var(--font-size-sm);
  line-height: 1.5;
}

.activity-card__arrow {
  margin-top: var(--spacing-lg);
  color: var(--color-root-moss);
  font-size: var(--font-size-sm);
  font-weight: 650;
}

.activity-card__enrollment {
  margin-top: var(--spacing-sm);
  color: var(--color-root-moss);
  font-size: var(--font-size-sm);
  font-weight: 700;
}

.pagination-state {
  min-height: 72rpx;
  padding: var(--spacing-xs) 0 var(--spacing-md);
  text-align: center;
}

.load-more {
  width: 100%;
  padding: var(--spacing-sm);
}

.load-more--retry {
  margin-top: var(--spacing-xs);
}
