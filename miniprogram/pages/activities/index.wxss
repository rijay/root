page { background: #fdfbf6; }

.activity-page {
  min-height: 100vh;
  padding: calc(116rpx + env(safe-area-inset-top)) 40rpx calc(164rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #fdfbf6;
}

.activity-head__title,
.activity-head__subtitle,
.activity-card__title,
.activity-card__meta,
.activity-state text {
  display: block;
}

.activity-head__title {
  color: #080806;
  font-size: 60rpx;
  font-weight: 600;
  line-height: 1.2;
}

.activity-head__subtitle {
  margin-top: 12rpx;
  color: #433e34;
  font-size: 26rpx;
  line-height: 1.5;
}

.activity-filters {
  display: flex;
  gap: 20rpx;
  margin-top: 38rpx;
}

.activity-filter {
  min-width: 144rpx;
  height: 68rpx;
  margin: 0;
  padding: 0 28rpx;
  color: #433e34;
  background: #fff;
  border: 0;
  border-radius: 34rpx;
  font-size: 24rpx;
  line-height: 68rpx;
}

.activity-filter::after,
.activity-state__action::after {
  border: 0;
}

.activity-filter--active {
  color: #fff;
  background: #080806;
}

.activity-list {
  margin-top: 48rpx;
}

.activity-card {
  overflow: hidden;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 32rpx rgba(8, 8, 6, 0.06);
  transition: transform 120ms ease, opacity 120ms ease;
}

.activity-card + .activity-card {
  margin-top: 28rpx;
}

.activity-card--pressed {
  opacity: 0.9;
  transform: scale(0.985);
}

.activity-card__visual {
  position: relative;
  overflow: hidden;
  height: 476rpx;
  background: #1d2618;
}

.activity-card--compact {
  display: flex;
  min-height: 208rpx;
}

.activity-card--compact .activity-card__visual {
  flex: 0 0 176rpx;
  height: 208rpx;
}

.activity-card__visual--placeholder {
  display: flex;
  align-items: flex-end;
  padding: 28rpx;
  box-sizing: border-box;
  background: radial-gradient(circle at 75% 20%, #d79652 0%, #615235 38%, #172419 100%);
}

.activity-card--compact .activity-card__visual--placeholder {
  padding: 18rpx;
}

.activity-card__image {
  width: 100%;
  height: 100%;
}

.activity-card__visual-mark {
  color: rgba(255, 255, 255, 0.78);
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.activity-card__status {
  position: absolute;
  top: 28rpx;
  left: 28rpx;
  padding: 10rpx 22rpx;
  color: #586b3f;
  background: #f1f5e6;
  border-radius: 28rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.4;
}

.activity-card--compact .activity-card__status {
  top: 16rpx;
  left: 16rpx;
  padding: 8rpx 14rpx;
  font-size: 19rpx;
}

.activity-card__status--closed,
.activity-card__status--muted {
  color: #6f685d;
  background: rgba(253, 251, 246, 0.92);
}

.activity-card__body {
  padding: 32rpx;
}

.activity-card--compact .activity-card__body {
  display: flex;
  justify-content: center;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  padding: 24rpx;
}

.activity-card__title {
  color: #080806;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.35;
}

.activity-card--compact .activity-card__title {
  overflow: hidden;
  font-size: 28rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.activity-card__footer {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 22rpx;
}

.activity-card--compact .activity-card__footer {
  margin-top: 12rpx;
}

.activity-card__meta {
  color: #433e34;
  font-size: 24rpx;
  line-height: 1.65;
}

.activity-card--compact .activity-card__meta {
  overflow: hidden;
  max-width: 330rpx;
  color: #8a8172;
  font-size: 20rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.activity-card__arrow {
  flex: 0 0 auto;
  color: #586b3f;
  font-size: 40rpx;
  line-height: 1;
}

.activity-card--compact .activity-card__arrow {
  font-size: 28rpx;
}

.activity-state {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  flex-direction: column;
  min-height: 360rpx;
  margin-top: 48rpx;
  color: #8a8172;
  font-size: 24rpx;
  line-height: 1.65;
}

.activity-state--card {
  min-height: 280rpx;
  padding: 40rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 28rpx;
}

.activity-state__title {
  margin-bottom: 12rpx;
  color: #080806;
  font-size: 32rpx;
  font-weight: 600;
}

.activity-state__line {
  width: 58%;
  height: 24rpx;
  margin-bottom: 22rpx;
  background: #e8e0d1;
  border-radius: 20rpx;
}

.activity-state__line--wide {
  width: 100%;
  height: 320rpx;
  border-radius: 28rpx;
}

.activity-state__action {
  height: 72rpx;
  margin: 28rpx 0 0;
  padding: 0 30rpx;
  color: #fff;
  background: #080806;
  border: 0;
  border-radius: 18rpx;
  font-size: 24rpx;
  line-height: 72rpx;
}
