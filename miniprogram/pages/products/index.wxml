<view class="root-page products-page">
  <view class="products-hero">
    <image class="products-logo" src="/static/brand/root-logo-horizontal.png" mode="aspectFit" />
    <view class="products-title">Root 会员中心商品</view>
    <view class="products-copy">myRoot 展示商品快照，购买将在 Root 会员中心完成。打卡任务可自行选择参与。</view>
  </view>

  <view wx:if="{{loading}}" class="root-card loading-card">
    <view class="root-helper-text">正在同步商品...</view>
  </view>

  <view wx:elif="{{errorText}}" class="root-card loading-card">
    <view class="root-section-title">商品暂未加载</view>
    <view class="root-helper-text">{{errorText}}</view>
    <button class="root-button retry-btn" bindtap="loadProducts">重新加载</button>
  </view>

  <view wx:elif="{{!products.length}}" class="root-card loading-card">
    <view class="root-section-title">商品即将开放</view>
    <view class="root-helper-text">当前活动暂未配置展示商品。</view>
  </view>

  <view wx:else class="product-list">
    <view wx:for="{{products}}" wx:key="productId" class="product-card">
      <view class="product-main" data-product-id="{{item.productId}}" bindtap="openDetail">
        <image class="product-image" src="{{item.imageUrl || '/static/icon/shop.png'}}" mode="aspectFit" />
        <view class="product-info">
          <view class="product-badge">{{item.badge || 'ROOT'}}</view>
          <view class="product-title">{{item.title}}</view>
          <view class="product-summary">{{item.summary}}</view>
          <view class="product-price">{{item.priceText}}</view>
        </view>
      </view>
      <view class="product-actions">
        <button class="root-button root-button--secondary action-btn" data-product-id="{{item.productId}}" bindtap="openDetail">查看详情</button>
        <button class="root-button action-btn" data-product-id="{{item.productId}}" bindtap="buyProduct" loading="{{jumpLoadingProductId === item.productId}}" disabled="{{jumpLoadingProductId}}">去购买</button>
      </view>
    </view>
    <view class="sync-note">商品快照更新时间：{{syncedAt || '待同步'}}</view>
  </view>
</view>
