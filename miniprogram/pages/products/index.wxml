<view class="products-page">
  <view class="products-hero root-page">
    <view class="products-tab-title">产品</view>
    <view class="products-kicker">ROOT PRODUCTS</view>
    <view class="products-science-entry" bindtap="openPhggReference" role="link" aria-label="查看 ROOT 核心原料 PHGG 科学参考文献集">
      <view>
        <view class="products-science-entry__eyebrow">INGREDIENT SCIENCE</view>
        <view class="products-science-entry__title">ROOT 核心原料 PHGG 科学参考文献集</view>
      </view>
      <view class="products-science-entry__arrow" aria-hidden="true"></view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="root-page products-state" role="status" aria-live="polite">
    <view class="product-skeleton"></view>
    <view class="root-helper-text">正在同步商品...</view>
  </view>

  <view wx:elif="{{errorText}}" class="root-page products-state" role="alert">
    <view class="root-section-title">商品暂未加载</view>
    <view class="root-helper-text">{{errorText}}</view>
    <button class="root-button retry-btn" bindtap="loadProducts">重新加载</button>
  </view>

  <view wx:elif="{{!products.length}}" class="root-page products-state" role="status">
    <view class="root-section-title">商品即将开放</view>
    <view class="root-helper-text">当前暂未配置展示商品。</view>
  </view>

  <view wx:else class="products-content">
    <view wx:if="{{catalogNotice}}" class="product-catalog-notice" role="status">{{catalogNotice}}</view>
    <view wx:if="{{focusNotice}}" class="product-focus-notice" role="status" aria-live="polite">{{focusNotice}}</view>
    <scroll-view
      wx:if="{{carouselVisible}}"
      class="product-carousel"
      scroll-x
      enhanced
      show-scrollbar="{{false}}"
      scroll-with-animation
      scroll-into-view="{{scrollIntoView}}"
      scroll-left="{{carouselScrollLeft}}"
      bindscroll="onProductScroll"
    >
      <view class="product-track">
        <view
          wx:for="{{products}}"
          wx:key="productId"
          id="product-{{item.productId}}"
          class="product-card product-card--{{item.visualTone}}"
          data-product-id="{{item.productId}}"
          bindtap="selectProduct"
          role="group"
          aria-label="{{item.subtitle}}，{{item.title}}"
        >
          <view class="product-card__meta">
            <text>{{item.badge || 'ROOT'}}</text>
            <text>{{item.productCode}}</text>
          </view>
          <view wx:if="{{item.imageUrl && !failedProductImages[item.productId]}}" class="product-visual product-visual--photo">
            <image class="product-image" src="{{item.imageUrl}}" mode="aspectFit" lazy-load="{{index > 0}}" data-product-id="{{item.productId}}" bindload="productImageLoaded" binderror="productImageFailed" aria-hidden="true" />
          </view>
          <view wx:else class="product-visual product-visual--generated">
            <view class="packshot-shadow"></view>
            <view class="packshot">
              <view class="packshot-brand">ROOT</view>
              <view class="packshot-rule"></view>
              <view class="packshot-code">{{item.productCode}}</view>
              <view class="packshot-caption">PREBIOTIC DRINK</view>
            </view>
          </view>
          <view class="product-card__content">
            <view class="product-subtitle">{{item.subtitle}}</view>
            <view class="product-name">{{item.title}}</view>
            <view class="product-summary">{{item.summary}}</view>
          </view>
          <view class="product-purchase">
            <view class="product-price">{{item.priceText || '会员中心实时价格'}}<text wx:if="{{!item.priceLive}}" class="product-price-source">最终价格以会员中心为准</text></view>
            <button
              class="product-buy"
              data-product-id="{{item.productId}}"
              bindtap="buyProduct"
              loading="{{jumpLoadingProductId === item.productId}}"
              disabled="{{jumpLoadingProductId}}"
              aria-label="购买 {{item.title}}"
            >购买</button>
          </view>
        </view>
        <view class="product-track__end"></view>
      </view>
    </scroll-view>

    <view class="root-page product-footnote">
      <view class="product-dots">
        <view wx:for="{{products}}" wx:key="productId" class="product-dot {{activeProductId === item.productId ? 'is-active' : ''}}" aria-hidden="true"></view>
      </view>
      <view>规格、价格、库存与优惠以 Root 会员中心实时页面为准。</view>
    </view>
  </view>
</view>
