<view class="products-page">
  <view class="products-hero root-page">
    <view class="products-kicker">ROOT PRODUCTS</view>
    <view class="products-title">全部产品，<text>按你的节奏来选。</text></view>
    <view class="products-copy">浏览 ROOT 的日常补给方案，购买将在 Root 会员中心完成。</view>
    <view wx:if="{{products.length > 1}}" class="products-swipe-hint">{{products.length}} 款产品 · 左右滑动查看</view>
  </view>

  <view wx:if="{{loading}}" class="root-page products-state">
    <view class="product-skeleton"></view>
    <view class="root-helper-text">正在同步商品...</view>
  </view>

  <view wx:elif="{{errorText}}" class="root-page products-state">
    <view class="root-section-title">商品暂未加载</view>
    <view class="root-helper-text">{{errorText}}</view>
    <button class="root-button retry-btn" bindtap="loadProducts">重新加载</button>
  </view>

  <view wx:elif="{{!products.length}}" class="root-page products-state">
    <view class="root-section-title">商品即将开放</view>
    <view class="root-helper-text">当前暂未配置展示商品。</view>
  </view>

  <view wx:else class="products-content">
    <scroll-view
      class="product-carousel"
      scroll-x
      enhanced
      show-scrollbar="{{false}}"
      scroll-with-animation
      scroll-into-view="{{scrollIntoView}}"
    >
      <view class="product-track">
        <view
          wx:for="{{products}}"
          wx:key="productId"
          id="product-{{item.productId}}"
          class="product-card product-card--{{item.visualTone}}"
          data-product-id="{{item.productId}}"
          bindtap="selectProduct"
        >
          <view class="product-card__meta">
            <text>{{item.badge || 'ROOT'}}</text>
            <text>{{item.productCode}}</text>
          </view>
          <view wx:if="{{item.imageUrl}}" class="product-visual">
            <image class="product-image" src="{{item.imageUrl}}" mode="aspectFit" />
          </view>
          <view wx:else class="product-visual product-visual--generated">
            <view class="packshot-shadow"></view>
            <view class="packshot">
              <view class="packshot-brand">ROOT</view>
              <view class="packshot-rule"></view>
              <view class="packshot-code">{{item.productCode}}</view>
              <view class="packshot-caption">PREBIOTIC DRINK</view>
            </view>
          </view>
          <view class="product-card__content">
            <view class="product-subtitle">{{item.subtitle}}</view>
            <view class="product-name">{{item.title}}</view>
            <view class="product-summary">{{item.summary}}</view>
            <view class="product-price">{{item.priceText || '会员中心实时价格'}}</view>
          </view>
          <view class="product-actions">
            <button
              class="product-buy"
              data-product-id="{{item.productId}}"
              bindtap="buyProduct"
              loading="{{jumpLoadingProductId === item.productId}}"
              disabled="{{jumpLoadingProductId}}"
            >购买</button>
            <view class="product-learn" data-product-id="{{item.productId}}" catchtap="openDetail">进一步了解 <text>›</text></view>
          </view>
        </view>
        <view class="product-track__end"></view>
      </view>
    </scroll-view>

    <view class="root-page product-footnote">
      <view class="product-dots">
        <view wx:for="{{products}}" wx:key="productId" class="product-dot {{activeProductId === item.productId ? 'is-active' : ''}}"></view>
      </view>
      <view>规格、价格、库存与优惠以 Root 会员中心实时页面为准。</view>
    </view>
  </view>
</view>
<campaign-popup id="campaign-popup" />
