.products-page {
  padding-top: 40rpx;
}

.products-hero {
  padding: 40rpx 0 32rpx;
}

.products-logo {
  width: 226rpx;
  height: 74rpx;
}

.products-title {
  margin-top: 32rpx;
  color: var(--color-root-ink);
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.18;
}

.products-copy {
  margin-top: 18rpx;
  max-width: 620rpx;
  color: var(--color-root-copy);
  font-size: var(--font-size-base);
  line-height: 1.7;
}

.loading-card {
  margin-top: 28rpx;
}

.retry-btn {
  margin-top: 28rpx;
}

.product-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.product-card {
  padding: 24rpx;
  background: var(--color-root-surface);
  border: 1rpx solid var(--color-root-line);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-sm);
}

.product-main {
  display: flex;
  gap: 24rpx;
}

.product-image {
  flex: 0 0 188rpx;
  width: 188rpx;
  height: 188rpx;
  background: var(--color-primary-tint);
  border-radius: 24rpx;
}

.product-info {
  flex: 1;
  min-width: 0;
}

.product-badge {
  display: inline-flex;
  min-height: 40rpx;
  padding: 0 16rpx;
  align-items: center;
  color: var(--color-root-moss);
  background: var(--color-primary-tint);
  border-radius: 999rpx;
  font-size: var(--font-size-xs);
  font-weight: 700;
}

.product-title {
  margin-top: 14rpx;
  color: var(--color-root-ink);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.28;
}

.product-summary {
  margin-top: 12rpx;
  color: var(--color-root-copy);
  font-size: var(--font-size-sm);
  line-height: 1.55;
}

.product-price {
  margin-top: 14rpx;
  color: var(--color-root-clay);
  font-size: var(--font-size-base);
  font-weight: 800;
}

.product-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 24rpx;
}

.action-btn {
  width: 100%;
}

.sync-note {
  padding: 8rpx 0 24rpx;
  color: var(--color-root-muted);
  font-size: var(--font-size-xs);
  text-align: center;
}
