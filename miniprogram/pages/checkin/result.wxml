<view class="page result-page">
  <view class="medal">
    <image class="medal-image" src="/static/badge/complete.png" mode="aspectFit" />
  </view>

  <view class="section panel">
    <view class="eyebrow">{{failed ? '人工协助' : '阶段完成'}}</view>
    <view class="h1">{{failed ? '需要人工协助' : '7天完成'}}</view>
    <view class="body">
      <block wx:if="{{failed}}">当前周期断卡达到3次，已进入人工介入。请联系 ROOT 顾问确认后续安排。</block>
      <block wx:else>你已经完成 {{completedDays}}/7 天记录。身体自有其序，感谢你把真实反馈交给 ROOT。</block>
    </view>
  </view>

  <view class="section panel">
    <view class="section-title">可视化总结</view>
    <view class="summary-grid">
      <view class="summary-item">
        <text class="big">{{completedDays}}</text>
        <text class="label">完成天数</text>
      </view>
      <view class="summary-item">
        <text class="big">{{session.missCount}}</text>
        <text class="label">断卡次数</text>
      </view>
    </view>
  </view>

  <view class="section button-row">
    <button class="btn" wx:if="{{!failed}}" bindtap="goRefund">申请免单</button>
    <button class="btn secondary" bindtap="goHistory">查看记录</button>
  </view>
</view>
