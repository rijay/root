.register-auth-page {
  padding: 44rpx 32rpx 72rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.auth-hero {
  padding: 44rpx 36rpx;
  border-radius: 36rpx;
}

.auth-title {
  margin-top: 18rpx;
  color: #fff;
  font-size: 46rpx;
  line-height: 1.18;
  font-weight: 800;
}

.auth-copy {
  margin-top: 24rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 26rpx;
  line-height: 1.7;
}

.auth-card {
  margin-top: 24rpx;
  padding: 32rpx;
}

.auth-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  border-bottom: 1rpx solid var(--color-root-line);
}

.auth-row:last-child {
  border-bottom: 0;
}

.auth-row-value {
  color: var(--color-primary);
  font-weight: 700;
}

.auth-actions {
  position: sticky;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  display: grid;
  gap: 20rpx;
  margin-top: 32rpx;
  padding: 24rpx;
  background: var(--color-glass);
  border: 1rpx solid var(--color-root-line);
  border-radius: 32rpx;
  box-shadow: var(--shadow-sm);
}
