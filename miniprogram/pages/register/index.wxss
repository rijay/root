page {
  background: var(--root-nav);
}

.register-page,
.register-page__scroll {
  height: 100vh;
}

.register-page {
  position: relative;
  overflow: hidden;
  color: var(--root-ink);
  background: var(--root-nav);
}

.register-page__content {
  padding: 130px 20px calc(64px + env(safe-area-inset-bottom));
}

.register-page__checking {
  padding-top: 280px;
  color: var(--root-muted);
  font-size: 13px;
  text-align: center;
}

.register-page__title,
.register-page__subtitle,
.register-page__avatar-copy,
.register-page__hint {
  display: block;
}

.register-page__title {
  margin-left: 4px;
  font-size: 28px;
  line-height: 36px;
  font-weight: 600;
}

.register-page__subtitle {
  margin: 8px 4px 0;
  color: var(--root-copy);
  font-size: 13px;
  line-height: 22px;
}

.register-page__avatar-row {
  display: flex;
  align-items: center;
  gap: 16px;
  margin: 26px 4px 0;
}

.register-page__avatar {
  flex: 0 0 72px;
  width: 72px;
  height: 72px;
  min-height: 72px;
  margin: 0;
  margin-right: 0 !important;
  margin-left: 0 !important;
  padding: 0;
  overflow: hidden;
  background: var(--root-primary-tint);
  border: 0;
  border-radius: 50%;
}

.register-page__avatar::after {
  border: 0;
}

.register-page__avatar-image {
  width: 100% !important;
  height: 100%;
}

.register-page__avatar-default {
  width: 48px;
  height: 13px;
  margin: 29px auto 0;
  overflow: hidden;
}

.register-page__avatar-wordmark {
  display: block;
  width: 65px;
  height: 13px;
  margin-left: -16px;
}

.register-page__avatar-copy {
  color: var(--root-copy);
  font-size: 13px;
  line-height: 21px;
  white-space: pre-line;
}

.register-field {
  min-height: 64px;
  margin-top: 12px;
  padding: 10px 16px;
  box-sizing: border-box;
  background: var(--root-surface);
  border-radius: 12px;
}

.register-page__avatar-row + .register-field {
  margin-top: 24px;
}

.register-field__label {
  display: block;
  color: var(--root-muted);
  font-size: 12px;
  line-height: 18px;
  font-weight: 500;
}

.register-field__input,
.register-field__value {
  height: 24px;
  color: var(--root-ink);
  font-size: 14px;
  line-height: 24px;
}

.register-field__input {
  margin-top: 1px;
}

.register-field__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 1px;
}

.register-field__value.is-placeholder {
  color: var(--root-copy);
}

.register-field__verified {
  color: var(--root-moss);
  font-size: 12px;
}

.register-field__chevron {
  width: 8px;
  height: 8px;
  margin-right: 3px;
  border-top: 1px solid var(--root-muted);
  border-right: 1px solid var(--root-muted);
  transform: rotate(45deg);
}

.register-field--gender {
  min-height: 82px;
}

.register-gender {
  display: grid;
  grid-template-columns: 142px 142px;
  gap: 10px;
  margin-top: 12px;
}

.register-gender__option {
  width: 142px;
  height: 30px;
  min-height: 30px;
  margin: 0;
  margin-right: 0 !important;
  margin-left: 0 !important;
  padding: 0;
  color: var(--root-copy);
  background: var(--root-primary-tint);
  border: 1px solid transparent;
  border-radius: 15px;
  font-size: 13px;
  line-height: 28px;
}

.register-gender__option::after {
  border: 0;
}

.register-gender__option.is-active {
  color: var(--root-moss);
  border-color: var(--root-sprout);
  font-weight: 600;
}

.register-page__hint {
  margin: 22px 4px 0;
  color: var(--root-muted);
  font-size: 11px;
  line-height: 17px;
  white-space: pre-line;
}

.register-page__submit {
  width: 100%;
  height: 56px;
  min-height: 56px;
  margin: 40px 0 0;
  margin-right: 0 !important;
  margin-left: 0 !important;
  padding: 0;
  color: #fff;
  background: var(--root-moss);
  border: 0;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 600;
  line-height: 56px;
}

.register-page__submit::after {
  border: 0;
}

.register-page__submit[disabled] {
  color: rgba(255, 255, 255, 0.78);
  opacity: 0.46;
}

@media (max-width: 359px) {
  .register-gender {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .register-gender__option {
    width: 100% !important;
  }
}
