<view class="root-page register-auth-page">
  <view class="auth-hero root-card--dark">
    <view class="eyebrow">MYROOT</view>
    <view class="auth-title">开始 Root 成长任务</view>
    <view class="auth-copy">授权后可参与打卡、问卷、咨询与活动结算。</view>
  </view>

  <view class="root-card auth-card">
    <view class="section-title">账号状态</view>
    <view class="auth-row">
      <text>小程序身份</text>
      <text class="auth-row-value">{{hasToken ? '已建立' : '待授权'}}</text>
    </view>
    <view class="auth-row">
      <text>手机号</text>
      <text class="auth-row-value">{{hasPhone ? '已记录' : '可选'}}</text>
    </view>
    <view class="auth-row">
      <text>跨小程序识别</text>
      <text class="auth-row-value">{{identity.unionidStatus === 'LINKED' ? '已连通' : '待认证补齐'}}</text>
    </view>
  </view>

  <view class="root-card auth-card">
    <view class="section-title">不强制绑定订单</view>
    <view class="root-helper-text">你可以先参与打卡、问卷和咨询；如活动规则需要购买条件，系统会在订单同步后自动判断。</view>
  </view>

  <view class="auth-actions">
    <button wx:if="{{!hasToken}}" class="root-button" loading="{{loading}}" bindtap="authorizeEntry">授权进入</button>
    <button
      wx:if="{{hasToken && !hasPhone}}"
      class="root-button root-button--secondary"
      loading="{{phoneLoading}}"
      open-type="getPhoneNumber"
      bindgetphonenumber="authorizePhone"
    >授权手机号</button>
    <button wx:if="{{hasToken}}" class="root-button" bindtap="continueToHome">进入首页</button>
  </view>
</view>
<privacy-consent />
