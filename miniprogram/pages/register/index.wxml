<view class="register-page">
  <page-navigation />
  <scroll-view class="register-page__scroll" scroll-y enhanced show-scrollbar="false">
    <view wx:if="{{!profileChecking}}" class="register-page__content">
      <text class="register-page__title">{{title}}</text>
      <text class="register-page__subtitle">{{subtitle}}</text>

      <view class="register-page__avatar-row">
        <button class="register-page__avatar" style="width: 72px;" open-type="chooseAvatar" loading="{{avatarUploading}}" disabled="{{avatarUploading}}" bindchooseavatar="chooseAvatar" aria-label="选择我的头像">
          <image wx:if="{{avatarUrl}}" class="register-page__avatar-image" src="{{avatarUrl}}" mode="aspectFill" />
          <view wx:else class="register-page__avatar-default">
            <image class="register-page__avatar-wordmark" src="/static/brand/root-logo-horizontal.png" mode="heightFix" />
          </view>
        </button>
        <text class="register-page__avatar-copy">我的头像（选填）\n使用微信头像、上传或拍照</text>
      </view>

      <view class="register-field">
        <text class="register-field__label">我的昵称</text>
        <input class="register-field__input" type="nickname" value="{{nickname}}" placeholder="微信昵称或自行填写" bindinput="changeNickname" />
      </view>

      <view class="register-field">
        <text class="register-field__label">手机号 *</text>
        <view class="register-field__row">
          <text class="register-field__value {{phone ? '' : 'is-placeholder'}}">{{phone || '等待手机号验证'}}</text>
          <text class="register-field__verified">{{phone ? '已验证' : '未验证'}}</text>
        </view>
      </view>

      <picker mode="date" value="{{birthDate}}" end="{{maxBirthDate}}" bindchange="changeBirthDate">
        <view class="register-field">
          <text class="register-field__label">生日 *</text>
          <view class="register-field__row">
            <text class="register-field__value {{birthDate ? '' : 'is-placeholder'}}">{{birthDate || '请选择生日'}}</text>
            <view class="register-field__chevron"></view>
          </view>
        </view>
      </picker>

      <view class="register-field register-field--gender">
        <text class="register-field__label">性别 *</text>
        <view class="register-gender">
          <button class="register-gender__option {{gender === 'MALE' ? 'is-active' : ''}}" style="width: 142px;" data-gender="MALE" bindtap="selectGender">男</button>
          <button class="register-gender__option {{gender === 'FEMALE' ? 'is-active' : ''}}" style="width: 142px;" data-gender="FEMALE" bindtap="selectGender">女</button>
        </view>
      </view>

      <text class="register-page__hint">手机号、生日、性别为必填项\n头像和昵称未授权时将使用默认值</text>
      <button wx:if="{{editing}}" class="register-page__submit" style="width: 350px;" loading="{{loading}}" disabled="{{loading || avatarUploading || !phone || !birthDate || !gender}}" bindtap="submitProfile">保存资料</button>
      <button wx:else class="register-page__submit" style="width: 350px;" loading="{{loading}}" disabled="{{loading || avatarUploading || !phone || !birthDate || !gender}}" bindtap="submitProfile">登录</button>
    </view>
    <view wx:else class="register-page__checking" aria-live="polite">正在核验会员状态…</view>
  </scroll-view>
  <privacy-consent id="root-privacy-consent" />
</view>
