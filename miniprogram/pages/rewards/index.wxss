.rewards-page {
  padding-top: 40rpx;
}

.rewards-hero {
  padding: 40rpx 0 28rpx;
}

.rewards-logo {
  width: 226rpx;
  height: 74rpx;
}

.rewards-title {
  margin-top: 32rpx;
  color: var(--color-root-ink);
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.18;
}

.rewards-copy {
  margin-top: 18rpx;
  color: var(--color-root-copy);
  font-size: var(--font-size-base);
  line-height: 1.7;
}

.state-card,
.condition-card,
.reward-record-card,
.review-card {
  margin-top: 24rpx;
}

.state-btn {
  margin-top: 24rpx;
}

.reward-status-card {
  margin-top: 24rpx;
  padding: 36rpx;
  color: var(--color-root-surface);
  background: var(--color-root-ink);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-md);
}

.reward-percent {
  color: #F9C647;
  font-size: 64rpx;
  font-weight: 800;
  line-height: 1;
}

.reward-title {
  margin-top: 20rpx;
  font-size: 38rpx;
  font-weight: 800;
}

.reward-copy {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: var(--font-size-base);
  line-height: 1.65;
}

.reward-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 28rpx;
}

.settlement-meta {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.66);
  font-size: var(--font-size-sm);
  line-height: 1.5;
}

.condition-row,
.reward-record-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--color-root-line);
}

.condition-row:last-child,
.reward-record-row:last-child {
  border-bottom: 0;
}

.condition-title {
  color: var(--color-root-ink);
  font-size: var(--font-size-base);
  font-weight: 800;
}

.condition-copy {
  margin-top: 8rpx;
  color: var(--color-root-copy);
  font-size: var(--font-size-sm);
  line-height: 1.5;
}

.condition-status {
  flex: 0 0 112rpx;
  color: var(--color-root-moss);
  font-size: var(--font-size-sm);
  font-weight: 800;
  text-align: right;
}

.condition-progress {
  margin-top: 6rpx;
  color: var(--color-root-muted);
  font-weight: 600;
}

.reward-record-row {
  align-items: flex-start;
  color: var(--color-root-copy);
  font-size: var(--font-size-base);
}

.reward-record-row > text {
  flex: 0 0 128rpx;
  color: var(--color-root-moss);
  font-size: var(--font-size-sm);
  font-weight: 800;
  text-align: right;
}

.reward-record-title {
  color: var(--color-root-ink);
  font-size: var(--font-size-base);
  font-weight: 800;
}

.reward-record-copy {
  margin-top: 8rpx;
  color: var(--color-root-copy);
  font-size: var(--font-size-sm);
  line-height: 1.5;
}

.reward-note {
  margin-top: 18rpx;
  color: var(--color-root-muted);
  font-size: var(--font-size-sm);
  line-height: 1.6;
}

.review-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.review-card-copy {
  margin-top: 8rpx;
  color: var(--color-root-copy);
  font-size: var(--font-size-sm);
  line-height: 1.5;
}

.review-link-btn {
  flex: 0 0 148rpx;
  min-height: 64rpx;
  padding: 0 16rpx;
  color: var(--color-root-moss);
  background: var(--color-primary-tint);
  border: 0;
  border-radius: var(--radius-full);
  font-size: var(--font-size-sm);
  font-weight: 800;
  line-height: 64rpx;
}

.review-link-btn::after {
  border: 0;
}
