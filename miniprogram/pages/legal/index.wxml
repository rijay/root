<view class="page legal-page">
  <view class="legal-header">
    <view class="eyebrow">ROOT 服务说明</view>
    <view class="legal-title">{{doc.title}}</view>
    <view class="legal-meta">更新日期：{{doc.updatedAt}}</view>
  </view>

  <view wx:for="{{doc.sections}}" wx:key="title" class="legal-section">
    <view class="section-title">{{item.title}}</view>
    <view wx:for="{{item.items}}" wx:for-item="line" wx:key="*this" class="body legal-copy">{{line}}</view>
  </view>

  <view wx:if="{{documentType === 'privacy' && privacyNotice && privacyNotice.configured}}" class="legal-section">
    <view class="section-title">六、个人信息处理者与联系方式</view>
    <view class="body legal-copy">个人信息处理者：{{privacyNotice.controllerName}}</view>
    <view class="body legal-copy">联系方式：{{privacyNotice.contact}}</view>
    <view class="body legal-copy">{{privacyNotice.retentionText}}</view>
  </view>
</view>
