.channel-error {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
  background: var(--color-ui-grouped);
}

.channel-error__mark {
  display: flex;
  width: 96rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  color: var(--color-brand-white);
  background: var(--color-danger);
  border-radius: 50%;
  font-size: 48rpx;
  font-weight: 700;
}

.channel-error__title {
  margin-top: 40rpx;
  color: var(--color-brand-black);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.3;
}

.channel-error__detail {
  margin: 24rpx 0 56rpx;
  color: var(--color-graphite);
  font-size: 28rpx;
  line-height: 1.7;
}

.channel-error .root-button + .root-button {
  margin-top: 24rpx;
}
