<view class="root-page product-detail-page">
  <view wx:if="{{loading}}" class="root-card detail-loading">
    <view class="root-helper-text">正在加载商品...</view>
  </view>

  <view wx:elif="{{errorText}}" class="root-card detail-loading">
    <view class="root-section-title">商品暂不可见</view>
    <view class="root-helper-text">{{errorText}}</view>
  </view>

  <view wx:elif="{{product}}" class="detail-content">
    <view class="detail-media">
      <image class="detail-image" src="{{product.imageUrl || '/static/icon/shop.png'}}" mode="aspectFit" />
    </view>
    <view class="detail-title-row">
      <view>
        <view class="product-badge">{{product.badge || 'ROOT'}}</view>
        <view class="detail-title">{{product.title}}</view>
      </view>
      <view class="detail-price">{{product.priceText}}</view>
    </view>
    <view class="root-card detail-card">
      <view class="root-section-title">商品说明</view>
      <view class="detail-copy">{{product.description || product.summary}}</view>
      <view class="detail-note">库存、价格、优惠与交易状态以 Root 会员中心为准。</view>
    </view>
    <view class="root-card detail-card">
      <view class="root-section-title">规格</view>
      <view wx:if="{{product.skus && product.skus.length}}" class="sku-list">
        <view wx:for="{{product.skus}}" wx:key="skuId" class="sku-row">
          <text>{{item.skuName}}</text>
          <text>{{item.priceText}}</text>
        </view>
      </view>
      <view wx:else class="detail-copy">规格信息待同步。</view>
    </view>
    <view class="sticky-actions">
      <button class="root-button" loading="{{jumpLoading}}" disabled="{{jumpLoading}}" bindtap="buyProduct">去 Root 会员中心购买</button>
    </view>
  </view>
</view>
