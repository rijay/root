.product-detail-page {
  min-height: 100vh;
  background: var(--color-ui-grouped);
}

.detail-state {
  display: grid;
  align-content: start;
  gap: 24rpx;
  padding-top: 48rpx;
}

.detail-skeleton {
  height: 620rpx;
  background: var(--color-ui-surface);
  border-radius: 44rpx;
}

.detail-content {
  padding-bottom: calc(154rpx + env(safe-area-inset-bottom));
}

.detail-stage {
  position: relative;
  height: 650rpx;
  padding: 32rpx;
  box-sizing: border-box;
  background: linear-gradient(145deg, var(--color-olive-tint) 0%, var(--color-olive-soft) 100%);
  overflow: hidden;
}

.product-detail-page--graphite .detail-stage {
  background: linear-gradient(145deg, var(--color-brand-olive) 0%, var(--color-brand-black) 100%);
}

.detail-stage__meta {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: space-between;
  color: var(--color-brand-olive);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.product-detail-page--graphite .detail-stage__meta {
  color: var(--color-olive-soft);
}

.detail-product-visual {
  position: absolute;
  inset: 70rpx 0 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-image {
  width: 100%;
  height: 100%;
}

.detail-product-visual--photo {
  inset: 84rpx 32rpx 24rpx;
  overflow: hidden;
  background: #fff;
  border-radius: 38rpx;
  box-shadow: 0 24rpx 56rpx rgba(36, 42, 11, 0.14);
}

.detail-packshot {
  position: relative;
  z-index: 1;
  display: flex;
  width: 270rpx;
  height: 446rpx;
  flex-direction: column;
  padding: 44rpx 32rpx;
  box-sizing: border-box;
  color: var(--color-brand-olive);
  background: linear-gradient(145deg, var(--color-ui-surface) 0%, var(--color-olive-soft) 100%);
  border-radius: 24rpx 24rpx 38rpx 38rpx;
  box-shadow: inset -16rpx 0 28rpx rgba(36, 42, 11, 0.08), 0 36rpx 58rpx rgba(36, 42, 11, 0.22);
  transform: perspective(800rpx) rotateY(-6deg) rotateZ(-1deg);
}

.product-detail-page--graphite .detail-packshot {
  color: var(--color-olive-tint);
  background: linear-gradient(145deg, var(--color-olive-mid) 0%, var(--color-brand-olive) 100%);
  box-shadow: inset -16rpx 0 28rpx rgba(0, 0, 0, 0.20), 0 36rpx 64rpx rgba(0, 0, 0, 0.44);
  transform: perspective(800rpx) rotateY(6deg) rotateZ(1deg);
}

.detail-packshot-shadow {
  position: absolute;
  bottom: 58rpx;
  width: 340rpx;
  height: 48rpx;
  background: rgba(36, 42, 11, 0.25);
  border-radius: 50%;
  filter: blur(12rpx);
}

.product-detail-page--graphite .detail-packshot-shadow {
  background: rgba(0, 0, 0, 0.60);
}

.detail-packshot__brand {
  font-size: 54rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.detail-packshot__rule {
  width: 72rpx;
  height: 5rpx;
  margin-top: 30rpx;
  background: currentColor;
}

.detail-packshot__code {
  margin-top: auto;
  font-size: 28rpx;
  font-weight: 700;
}

.detail-packshot__caption {
  margin-top: 10rpx;
  font-size: 17rpx;
  letter-spacing: 1rpx;
}

.detail-copy-block {
  padding-top: 48rpx;
  padding-bottom: 56rpx;
  background: var(--color-ui-surface);
}

.detail-subtitle {
  color: var(--color-olive-mid);
  font-size: 27rpx;
  font-weight: 700;
}

.detail-title {
  margin-top: 14rpx;
  color: var(--color-brand-black);
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.18;
  letter-spacing: -1rpx;
}

.detail-summary,
.detail-description {
  margin-top: 20rpx;
  color: var(--color-graphite);
  font-size: 28rpx;
  line-height: 1.7;
}

.detail-price {
  margin-top: 24rpx;
  color: var(--color-brand-black);
  font-size: 28rpx;
  font-weight: 600;
}

.detail-divider {
  height: 1rpx;
  margin: 44rpx 0;
  background: var(--color-ui-line);
}

.detail-section-label {
  color: var(--color-brand-black);
  font-size: 32rpx;
  font-weight: 700;
}

.sku-list {
  margin-top: 16rpx;
}

.detail-config-date {
  margin-top: 18rpx;
  color: var(--color-system-secondary);
  font-size: 22rpx;
  line-height: 1.5;
}

.sku-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 0;
  color: var(--color-graphite);
  font-size: 27rpx;
  border-bottom: 1rpx solid var(--color-ui-line);
}

.detail-action-shell {
  position: fixed;
  z-index: 20;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  min-height: 116rpx;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  background: var(--color-glass);
  border-top: 1rpx solid var(--color-ui-line);
  backdrop-filter: blur(20rpx);
}

.detail-action-price {
  color: var(--color-brand-black);
  font-size: 26rpx;
  font-weight: 700;
}

.detail-action-note {
  margin-top: 6rpx;
  color: var(--color-neutral-grey);
  font-size: 20rpx;
}

.detail-buy {
  min-width: 184rpx;
  min-height: 104rpx;
  margin: 0;
  padding: 0 36rpx;
  color: var(--color-brand-white);
  background: var(--color-brand-olive);
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 104rpx;
}

.detail-buy::after {
  border: 0;
}
