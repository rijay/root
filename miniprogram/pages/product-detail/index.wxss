.product-detail-page {
  padding-top: 32rpx;
}

.detail-loading {
  margin-top: 32rpx;
}

.detail-content {
  padding-bottom: 120rpx;
}

.detail-media {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 420rpx;
  background: var(--color-primary-tint);
  border-radius: var(--radius-card);
  overflow: hidden;
}

.detail-image {
  width: 360rpx;
  height: 360rpx;
}

.detail-title-row {
  display: flex;
  gap: 24rpx;
  align-items: flex-start;
  justify-content: space-between;
  margin-top: 32rpx;
}

.product-badge {
  display: inline-flex;
  min-height: 40rpx;
  padding: 0 16rpx;
  align-items: center;
  color: var(--color-root-moss);
  background: var(--color-primary-tint);
  border-radius: 999rpx;
  font-size: var(--font-size-xs);
  font-weight: 700;
}

.detail-title {
  margin-top: 16rpx;
  color: var(--color-root-ink);
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.18;
}

.detail-price {
  flex: 0 0 208rpx;
  color: var(--color-root-clay);
  font-size: var(--font-size-base);
  font-weight: 800;
  line-height: 1.45;
  text-align: right;
}

.detail-card {
  margin-top: 28rpx;
}

.detail-copy,
.detail-note {
  margin-top: 16rpx;
  color: var(--color-root-copy);
  font-size: var(--font-size-base);
  line-height: 1.7;
}

.detail-note {
  color: var(--color-root-muted);
  font-size: var(--font-size-sm);
}

.sku-list {
  margin-top: 16rpx;
}

.sku-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 0;
  color: var(--color-root-copy);
  font-size: var(--font-size-base);
  border-bottom: 1rpx solid var(--color-root-line);
}

.sku-row:last-child {
  border-bottom: 0;
}

.sticky-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: var(--color-glass);
  border-top: 1rpx solid var(--color-root-line);
}
