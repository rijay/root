page { background: #080806; }
.tab-shell--home { position: relative; height: 100vh; color: #fff; background: linear-gradient(165deg, #29341e 0%, #080806 58%, #4b3b2c 100%); }
.tab-shell__wordmark-crop { position: absolute; top: calc(74rpx + env(safe-area-inset-top)); left: 40rpx; width: 168rpx; height: 44rpx; overflow: hidden; }
.tab-shell__wordmark { width: 228rpx; height: 44rpx; margin-left: -56rpx; }
.tab-shell__hero { position: absolute; right: 48rpx; bottom: calc(250rpx + env(safe-area-inset-bottom)); left: 48rpx; text-align: center; }
.tab-shell__eyebrow { display: block; color: #a6b77a; font-size: 22rpx; font-weight: 600; letter-spacing: 3rpx; }
.tab-shell__title { display: block; margin-top: 24rpx; font-size: 52rpx; line-height: 1.3; font-weight: 600; white-space: pre-line; }
.tab-shell__description { display: block; margin-top: 22rpx; color: rgba(255,255,255,.72); font-size: 24rpx; }
.tab-shell__indicator { position: absolute; bottom: calc(160rpx + env(safe-area-inset-bottom)); left: 50%; display: flex; gap: 12rpx; transform: translateX(-50%); }
.tab-shell__indicator view { width: 8rpx; height: 8rpx; border-radius: 8rpx; background: rgba(255,255,255,.45); }
.tab-shell__indicator .is-active { width: 32rpx; background: #fff; }
