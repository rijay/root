.home-container {
  min-height: 100vh;
}

.center-view {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-md);
}

.brand-mark {
  width: 160rpx;
  height: 160rpx;
}

.login-view {
  display: flex;
  flex-direction: column;
}

.root-login-view {
  align-items: center;
  padding-top: 88rpx;
}

.root-login-logo {
  width: 500rpx;
  height: 84rpx;
  margin-top: var(--spacing-xl);
}

.root-login-title {
  margin-top: 56rpx;
  color: var(--color-root-ink);
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.2;
  text-align: center;
}

.root-login-copy {
  width: 590rpx;
  margin-top: var(--spacing-md);
  color: var(--color-root-copy);
  font-size: var(--font-size-base);
  line-height: 1.65;
  text-align: center;
}

.root-login-card {
  width: 670rpx;
  margin-top: 72rpx;
  box-sizing: border-box;
}

.root-card-title {
  color: var(--color-root-ink);
  font-size: var(--font-size-lg);
  font-weight: 700;
}

.root-promise {
  margin-top: var(--spacing-md);
  color: var(--color-root-copy);
  font-size: var(--font-size-base);
  line-height: 1.45;
}

.home-title {
  color: var(--color-text-primary);
  font-size: var(--font-size-xl);
  font-weight: 800;
  line-height: 1.2;
}

.login-button {
  width: 670rpx;
  margin-top: var(--spacing-xl);
}

.login-safe-note {
  width: 670rpx;
  margin-top: var(--spacing-md);
  text-align: center;
}

.agreement {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  flex-wrap: wrap;
  margin-top: var(--spacing-md);
  color: var(--color-text-secondary);
  font-size: var(--font-size-xs);
}

.agreement-check {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.agreement-link {
  color: var(--color-root-moss);
  font-weight: 700;
}

.checkbox {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  color: var(--color-surface);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
}

.checkbox.checked {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.root-agreement {
  width: 670rpx;
}

.step-bars {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--spacing-sm);
}

.step-bar {
  height: 10rpx;
  background: var(--color-border);
  border-radius: var(--radius-full);
}

.step-bar.active {
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
}

.register-view {
  padding-top: 44rpx;
}

.register-progress {
  margin-bottom: var(--spacing-lg);
}

.register-progress-meta {
  margin-bottom: var(--spacing-sm);
  color: var(--color-root-muted);
  font-size: var(--font-size-xs);
  font-weight: 700;
}

.question-card,
.today-card,
.calendar-card,
.chart-card,
.coupon-card,
.trend-card,
.shop-card {
  padding: var(--spacing-lg);
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-sm);
}

.question-card {
  border-radius: var(--radius-card);
}

.question-helper {
  margin-top: var(--spacing-md);
}

.coupon-card {
  border-color: rgba(174, 126, 58, 0.32);
  background: linear-gradient(135deg, #fffaf0, var(--color-surface));
}

.coupon-code {
  margin: var(--spacing-md) 0;
  padding: var(--spacing-md);
  color: var(--color-primary-dark);
  background: rgba(174, 126, 58, 0.12);
  border: 1rpx dashed rgba(174, 126, 58, 0.6);
  border-radius: var(--radius-md);
  font-size: var(--font-size-lg);
  font-weight: 900;
  text-align: center;
}

.question-title {
  margin-top: var(--spacing-md);
  color: var(--color-text-primary);
  font-size: var(--font-size-xl);
  font-weight: 800;
  line-height: 1.3;
}

.checkmark {
  float: right;
  color: var(--color-success);
  font-weight: 900;
}

.stool-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--spacing-md);
}

.stool-card {
  min-height: 286rpx;
  padding: var(--spacing-sm);
  color: var(--color-text-secondary);
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-control);
  font-size: var(--font-size-xs);
  line-height: 1.35;
  box-shadow: var(--shadow-sm);
  box-sizing: border-box;
}

.stool-card.active {
  background: var(--color-primary-tint);
  border-color: var(--color-primary);
}

.stool-card-image {
  width: 100%;
  height: 190rpx;
}

.flex-btn {
  flex: 1;
}

.register-actions {
  position: sticky;
  bottom: calc(var(--spacing-md) + env(safe-area-inset-bottom));
  padding: var(--spacing-md);
  background: var(--color-glass);
  border: 1rpx solid var(--color-root-line);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-sm);
}

.activity-banner {
  width: 100%;
  border-radius: var(--radius-control);
}

.activity-visual-card {
  padding: var(--spacing-sm);
  background: var(--color-root-surface);
  border: 1rpx solid var(--color-root-line);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-sm);
}

.sticky-actions {
  position: sticky;
  bottom: var(--spacing-md);
  display: grid;
  gap: var(--spacing-md);
  margin-top: var(--spacing-xl);
  padding: var(--spacing-md);
  background: var(--color-glass);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
}

.sticky-actions .btn-primary,
.sticky-actions .btn-outline {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 96rpx;
  box-sizing: border-box;
  line-height: 1.25;
  white-space: nowrap;
}

.progress-dots {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: var(--spacing-sm);
}

.progress-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 66rpx;
  color: var(--color-text-tertiary);
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  font-weight: 800;
}

.progress-dot.done {
  color: var(--color-surface);
  background: var(--color-success);
}

.progress-dot.today {
  color: var(--color-surface);
  background: var(--color-primary);
}

.root-status-card {
  position: relative;
  min-height: 356rpx;
  padding: 40rpx;
  box-sizing: border-box;
  border-radius: var(--radius-card);
}

.root-status-meta {
  color: var(--color-root-soft);
  font-size: var(--font-size-sm);
  font-weight: 600;
}

.root-status-progress {
  position: absolute;
  top: 48rpx;
  right: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  color: var(--color-root-ink);
  background: var(--color-root-nav);
  border-radius: 50%;
  font-size: 40rpx;
  font-weight: 800;
}

.root-status-title {
  margin-top: 46rpx;
  color: var(--color-root-surface);
  font-size: 48rpx;
  line-height: 1.18;
  font-weight: 800;
}

.root-status-copy {
  width: 440rpx;
  margin-top: var(--spacing-md);
  color: #D8D1C2;
  font-size: var(--font-size-base);
  line-height: 1.48;
}

.root-status-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-top: var(--spacing-lg);
  color: var(--color-root-ink);
  background: var(--color-root-sprout);
  border-radius: 24rpx;
  font-size: var(--font-size-lg);
  font-weight: 700;
}

.root-status-cta--done {
  color: var(--color-root-surface);
  background: rgba(253, 251, 246, 0.18);
  border: 1rpx solid rgba(253, 251, 246, 0.28);
}

.root-status-cta:active {
  transform: scale(0.98);
}

.root-mantra {
  margin-top: var(--spacing-lg);
  color: var(--color-root-moss);
  font-size: var(--font-size-base);
  font-weight: 600;
  text-align: center;
}

.home-observation-title {
  margin-top: 56rpx;
}

.home-observation-card {
  margin-top: var(--spacing-md);
}

.circle-cta,
.daily-cta {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 280rpx;
  height: 280rpx;
  margin: var(--spacing-xl) auto;
  color: var(--color-surface);
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
  border-radius: 50%;
  box-shadow: var(--shadow-lg);
  font-size: var(--font-size-lg);
  font-weight: 800;
}

.circle-cta-icon,
.daily-cta-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: var(--spacing-sm);
}

.calendar-row {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  padding: var(--spacing-md) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.calendar-row:last-child {
  border-bottom: 0;
}

.calendar-marker {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  color: var(--color-root-muted);
  background: var(--color-root-nav);
  border: 1rpx solid var(--color-root-line);
  border-radius: 50%;
  font-size: var(--font-size-xs);
  font-weight: 800;
}

.calendar-row.done .calendar-marker {
  color: var(--color-root-surface);
  background: var(--color-root-moss);
  border-color: var(--color-root-moss);
}

.calendar-row.today .calendar-marker {
  color: var(--color-root-ink);
  background: var(--color-root-soft);
  border-color: var(--color-root-sprout);
}

.row-title {
  color: var(--color-text-primary);
  font-size: var(--font-size-base);
  font-weight: 800;
}

.complete-badge {
  display: block;
  width: 420rpx;
  height: 420rpx;
  margin: var(--spacing-lg) auto 0;
}

.bar-chart,
.mini-bars {
  display: flex;
  align-items: flex-end;
  gap: var(--spacing-sm);
  height: 150rpx;
  margin: var(--spacing-lg) 0;
}

.bar {
  flex: 1;
  background: var(--color-border);
  border-radius: var(--radius-sm) var(--radius-sm) 0 0;
}

.bar.active {
  background: linear-gradient(180deg, var(--color-primary-light), var(--color-primary));
}

.daily-hero-card {
  padding: 40rpx;
}

.daily-hero-title {
  margin-top: var(--spacing-md);
  color: var(--color-root-ink);
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.18;
}

.daily-hero-copy {
  margin-top: var(--spacing-md);
  color: var(--color-root-copy);
  font-size: var(--font-size-base);
  line-height: 1.6;
}

.daily-main-button {
  width: 100%;
  margin-top: var(--spacing-lg);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--spacing-md);
}

.stats-card {
  padding: var(--spacing-lg) var(--spacing-md);
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
  text-align: left;
}

.stat-value {
  display: block;
  color: var(--color-primary-dark);
  font-size: var(--font-size-xl);
  font-weight: 900;
}

.stat-label {
  display: block;
  margin-top: var(--spacing-xs);
  color: var(--color-text-secondary);
  font-size: var(--font-size-xs);
}

.daily-history-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.daily-entry-arrow {
  color: var(--color-root-muted);
  font-size: 42rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--spacing-md);
}

.range-tabs {
  display: flex;
  gap: var(--spacing-sm);
  color: var(--color-text-tertiary);
  font-size: var(--font-size-xs);
}

.range-tabs .active {
  color: var(--color-primary-dark);
  font-weight: 800;
}

.mini-bar {
  flex: 1;
  height: 38rpx;
  background: var(--color-border);
  border-radius: var(--radius-sm);
}

.mini-bar.active {
  height: 118rpx;
  background: var(--color-success);
}

.shop-card {
  display: grid;
  grid-template-columns: 120rpx 1fr;
  gap: var(--spacing-md);
}

.shop-card-icon {
  width: 120rpx;
  height: 120rpx;
}

.shop-btn {
  margin-top: var(--spacing-md);
}
