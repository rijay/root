page { background: #080806; }
.home-page { position: relative; height: 100vh; overflow: hidden; color: #fff; background: #080806; }
.home-carousel { width: 100%; height: calc(100vh - 60px - env(safe-area-inset-bottom)); }
.home-slide { position: relative; width: 100%; height: 100%; overflow: hidden; background: radial-gradient(circle at 72% 18%, #74845a 0%, #2b3421 34%, #080806 72%); }
.home-slide--1 { background: radial-gradient(circle at 24% 24%, #9a6c42 0%, #493726 34%, #080806 76%); }
.home-slide__image, .home-slide__shade { position: absolute; inset: 0; width: 100%; height: 100%; }
.home-slide__shade { background: linear-gradient(180deg, rgba(8,8,6,.06) 34%, rgba(8,8,6,.92) 82%, #080806 100%); }
.home-slide__copy { position: absolute; right: 48rpx; bottom: 212rpx; left: 48rpx; text-align: center; opacity: .45; transform: translateY(20rpx); transition: opacity 320ms ease, transform 420ms ease; }
.home-slide__copy.is-current { opacity: 1; transform: translateY(0); }
.home-slide__kicker { display: block; margin-bottom: 30rpx; color: #a6b77a; font-size: 22rpx; font-weight: 600; letter-spacing: 3rpx; transform: translateY(-5px); }
.home-slide__line { display: block; font-size: 52rpx; line-height: 1.42; font-weight: 600; }
.home-indicator { position: absolute; z-index: 6; bottom: calc(188px + env(safe-area-inset-bottom)); left: 50%; display: flex; gap: 12rpx; transform: translateX(-50%); }
.home-indicator__dot { width: 8rpx; height: 8rpx; border-radius: 8rpx; background: rgba(255,255,255,.46); transition: width 260ms ease; }
.home-indicator__dot.is-active { width: 32rpx; background: #fff; }
.home-state { display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 28rpx; width: 100%; height: calc(100vh - 60px - env(safe-area-inset-bottom)); color: rgba(255,255,255,.72); font-size: 26rpx; }
.home-state button { min-width: 200rpx; color: #fff; background: transparent; border: 1rpx solid rgba(255,255,255,.38); font-size: 24rpx; }
.home-state button::after { border: 0; }
.home-product-banner { position: absolute; z-index: 8; right: 32rpx; bottom: calc(76px + env(safe-area-inset-bottom)); left: 32rpx; display: flex; min-height: 112rpx; align-items: center; justify-content: space-between; gap: 20rpx; padding: 18rpx 20rpx 18rpx 26rpx; box-sizing: border-box; background: rgba(255,255,255,.94); border: 1rpx solid rgba(255,255,255,.42); border-radius: 28rpx; box-shadow: 0 18rpx 48rpx rgba(0,0,0,.24); backdrop-filter: blur(18rpx); }
.home-product-banner__copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 6rpx; }
.home-product-banner__eyebrow { color: #6b7c3a; font-size: 18rpx; font-weight: 700; letter-spacing: 2rpx; }
.home-product-banner__title { overflow: hidden; color: #000; font-size: 26rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.home-product-banner__action { min-width: 150rpx; min-height: 72rpx; margin: 0; padding: 0 24rpx; color: #fff; background: #242a0b; border: 0; border-radius: 999rpx; font-size: 24rpx; font-weight: 600; line-height: 72rpx; }
.home-product-banner__action::after { border: 0; }
