.home-container {
  min-height: 100vh;
}

.center-view {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-md);
}

.brand-mark {
  width: 160rpx;
  height: 160rpx;
}

.login-view {
  display: flex;
  flex-direction: column;
  padding: 0;
}

.splash-image {
  width: 100%;
  height: 60vh;
}

.login-content {
  padding: var(--spacing-lg);
}

.home-title {
  color: var(--color-text-primary);
  font-size: var(--font-size-xl);
  font-weight: 800;
  line-height: 1.2;
}

.login-button {
  margin-top: var(--spacing-xl);
}

.dev-login-button {
  margin-top: var(--spacing-md);
}

.agreement {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-top: var(--spacing-md);
  color: var(--color-text-secondary);
  font-size: var(--font-size-xs);
}

.checkbox {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  color: var(--color-surface);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
}

.checkbox.checked {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.step-bars {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--spacing-sm);
}

.step-bar {
  height: 10rpx;
  background: var(--color-border);
  border-radius: var(--radius-full);
}

.step-bar.active {
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
}

.question-card,
.content-card,
.today-card,
.calendar-card,
.chart-card,
.coupon-card,
.trend-card,
.shop-card {
  padding: var(--spacing-lg);
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.coupon-card {
  border-color: rgba(174, 126, 58, 0.32);
  background: linear-gradient(135deg, #fffaf0, var(--color-surface));
}

.coupon-code {
  margin: var(--spacing-md) 0;
  padding: var(--spacing-md);
  color: var(--color-primary-dark);
  background: rgba(174, 126, 58, 0.12);
  border: 1rpx dashed rgba(174, 126, 58, 0.6);
  border-radius: var(--radius-md);
  font-size: var(--font-size-lg);
  font-weight: 900;
  text-align: center;
}

.question-title {
  margin-top: var(--spacing-md);
  color: var(--color-text-primary);
  font-size: var(--font-size-xl);
  font-weight: 800;
  line-height: 1.3;
}

.checkmark {
  float: right;
  color: var(--color-success);
  font-weight: 900;
}

.stool-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--spacing-md);
}

.stool-card {
  min-height: 286rpx;
  padding: var(--spacing-sm);
  color: var(--color-text-secondary);
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: var(--font-size-xs);
  line-height: 1.35;
}

.stool-card.active {
  background: var(--color-primary-tint);
  border-color: var(--color-primary);
}

.stool-card image {
  width: 100%;
  height: 190rpx;
}

.flex-btn {
  flex: 1;
}

.activity-banner {
  width: 100%;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
}

.sticky-actions {
  position: sticky;
  bottom: var(--spacing-md);
  display: grid;
  gap: var(--spacing-md);
  margin-top: var(--spacing-xl);
  padding: var(--spacing-md);
  background: var(--color-glass);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
}

.progress-dots {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: var(--spacing-sm);
}

.progress-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 66rpx;
  color: var(--color-text-tertiary);
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  font-weight: 800;
}

.progress-dot.done {
  color: var(--color-surface);
  background: var(--color-success);
}

.progress-dot.today {
  color: var(--color-surface);
  background: var(--color-primary);
}

.circle-cta,
.daily-cta {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 280rpx;
  height: 280rpx;
  margin: var(--spacing-xl) auto;
  color: var(--color-surface);
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
  border-radius: 50%;
  box-shadow: var(--shadow-lg);
  font-size: var(--font-size-lg);
  font-weight: 800;
}

.circle-cta image,
.daily-cta image {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: var(--spacing-sm);
}

.calendar-row {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  padding: var(--spacing-md) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.calendar-row:last-child {
  border-bottom: 0;
}

.calendar-row image {
  width: 72rpx;
  height: 72rpx;
}

.row-title {
  color: var(--color-text-primary);
  font-size: var(--font-size-base);
  font-weight: 800;
}

.complete-badge {
  display: block;
  width: 420rpx;
  height: 420rpx;
  margin: var(--spacing-lg) auto 0;
}

.bar-chart,
.mini-bars {
  display: flex;
  align-items: flex-end;
  gap: var(--spacing-sm);
  height: 150rpx;
  margin: var(--spacing-lg) 0;
}

.bar {
  flex: 1;
  background: var(--color-border);
  border-radius: var(--radius-sm) var(--radius-sm) 0 0;
}

.bar.active {
  background: linear-gradient(180deg, var(--color-primary-light), var(--color-primary));
}

.daily-welcome {
  padding: var(--spacing-lg);
  color: var(--color-surface);
  background: linear-gradient(135deg, var(--color-primary), var(--color-success));
  border-radius: var(--radius-lg);
  font-size: var(--font-size-lg);
  font-weight: 800;
  box-shadow: var(--shadow-md);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--spacing-md);
}

.stats-grid > view {
  padding: var(--spacing-md);
  text-align: center;
  background: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
}

.stat-value {
  display: block;
  color: var(--color-primary-dark);
  font-size: var(--font-size-xl);
  font-weight: 900;
}

.stat-label {
  display: block;
  margin-top: var(--spacing-xs);
  color: var(--color-text-secondary);
  font-size: var(--font-size-xs);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--spacing-md);
}

.range-tabs {
  display: flex;
  gap: var(--spacing-sm);
  color: var(--color-text-tertiary);
  font-size: var(--font-size-xs);
}

.range-tabs .active {
  color: var(--color-primary-dark);
  font-weight: 800;
}

.mini-bar {
  flex: 1;
  height: 38rpx;
  background: var(--color-border);
  border-radius: var(--radius-sm);
}

.mini-bar.active {
  height: 118rpx;
  background: var(--color-success);
}

.shop-card {
  display: grid;
  grid-template-columns: 120rpx 1fr;
  gap: var(--spacing-md);
}

.shop-card image {
  width: 120rpx;
  height: 120rpx;
}

.shop-btn {
  margin-top: var(--spacing-md);
}
