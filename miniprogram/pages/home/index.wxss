page { background: var(--color-brand-black); }
.home-page { position: relative; height: 100vh; overflow: hidden; color: var(--color-brand-white); background: var(--color-brand-black); }
.home-carousel { width: 100%; height: calc(100vh - 52px - env(safe-area-inset-bottom)); }
.home-slide { position: relative; width: 100%; height: 100%; overflow: hidden; background: radial-gradient(circle at 72% 18%, var(--color-olive-mid) 0%, var(--color-olive-dark) 34%, var(--color-brand-black) 72%); }
.home-slide--1 { background: radial-gradient(circle at 24% 24%, var(--color-olive-mid) 0%, var(--color-graphite) 34%, var(--color-brand-black) 76%); }
.home-slide__image, .home-slide__shade { position: absolute; inset: 0; width: 100%; height: 100%; }
.home-slide__fallback { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,.72); background: radial-gradient(circle at 50% 36%, var(--color-olive-mid) 0%, var(--color-olive-dark) 42%, var(--color-brand-black) 82%); font-size: 72rpx; letter-spacing: 12rpx; }
.home-slide__shade { background: linear-gradient(180deg, rgba(0, 0, 0,.06) 34%, rgba(0, 0, 0,.92) 82%, var(--color-brand-black) 100%); }
.home-slide__shade--asset { background: linear-gradient(180deg, rgba(0, 0, 0,.02) 0%, rgba(0, 0, 0,.08) 68%, rgba(0, 0, 0,.36) 100%); }
.home-slide__top-copy { position: absolute; z-index: 2; top: 24%; right: 48rpx; left: 48rpx; color: var(--color-olive-dark); font-size: 34rpx; line-height: 1.5; font-weight: 500; letter-spacing: 2rpx; text-align: center; text-shadow: 0 2rpx 12rpx rgba(255,255,255,.48); opacity: .45; transform: translateY(12rpx); transition: opacity 320ms ease, transform 420ms ease; }
.home-slide__top-copy.is-current { opacity: 1; transform: translateY(0); }
.home-slide__copy { position: absolute; right: 48rpx; bottom: 212rpx; left: 48rpx; text-align: center; opacity: .45; transform: translateY(20rpx); transition: opacity 320ms ease, transform 420ms ease; }
.home-slide__copy.is-current { opacity: 1; transform: translateY(0); }
.home-slide__kicker { display: block; margin-bottom: 30rpx; color: var(--color-accent-on-dark); font-size: 22rpx; font-weight: 600; letter-spacing: 3rpx; transform: translateY(-5px); }
.home-slide__line { display: block; font-size: 52rpx; line-height: 1.42; font-weight: 600; }
.home-slide__copy--foundation-single .home-slide__line { white-space: nowrap; font-size: 50rpx; }
.home-slide__copy--campaign-split .home-slide__line--secondary { font-size: 36rpx; line-height: 1.5; }
.home-indicator { position: absolute; z-index: 6; bottom: 132px; left: 50%; display: flex; gap: 12rpx; transform: translateX(-50%); }
.home-indicator__dot { width: 8rpx; height: 8rpx; border-radius: 8rpx; background: rgba(255,255,255,.46); transition: width 260ms ease; }
.home-indicator__dot.is-active { width: 32rpx; background: var(--color-brand-white); }
.home-state { display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 28rpx; width: 100%; height: calc(100vh - 52px - env(safe-area-inset-bottom)); color: rgba(255,255,255,.72); font-size: 26rpx; }
.home-state button { min-width: 200rpx; color: var(--color-brand-white); background: transparent; border: 1rpx solid rgba(255,255,255,.38); font-size: 24rpx; }
.home-state button::after { border: 0; }

@media (prefers-reduced-motion: reduce) {
  .home-slide__top-copy,
  .home-slide__copy,
  .home-indicator__dot {
    transition: none;
  }
}

@media (max-width: 360px) {
  .home-slide__copy--foundation-single .home-slide__line { font-size: 46rpx; }
}
