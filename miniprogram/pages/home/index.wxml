<view class="home-page">
  <immersive-header wx:if="{{!items[current] || items[current].copyMode !== 'asset'}}" tone="light" />
  <swiper wx:if="{{state === 'ready'}}" class="home-carousel" current="{{current}}" duration="420" circular="{{items.length > 1}}" bindchange="changeSlide">
    <swiper-item wx:for="{{items}}" wx:key="contentId">
      <view class="home-slide home-slide--{{index % 2}}" data-index="{{index}}" data-release-asset="{{item.assetState}}" bindtap="openCurrent">
        <image wx:if="{{item.coverAssetUrl && !failedImages[index]}}" class="home-slide__image" src="{{item.coverAssetUrl}}" mode="aspectFill" lazy-load="{{index > 0}}" data-index="{{index}}" bindload="imageLoaded" binderror="imageFailed" />
        <view wx:if="{{failedImages[index]}}" class="home-slide__fallback"><text>ROOT</text></view>
        <view class="home-slide__shade {{item.copyMode === 'asset' ? 'home-slide__shade--asset' : ''}}"></view>
        <view wx:if="{{item.topCopy}}" class="home-slide__top-copy {{current === index ? 'is-current' : ''}}">
          <text>{{item.topCopy}}</text>
        </view>
        <view wx:if="{{item.copyMode !== 'asset'}}" class="home-slide__copy home-slide__copy--{{item.copyVariant ? item.copyVariant : 'default'}} {{current === index ? 'is-current' : ''}}">
          <text wx:if="{{item.kicker}}" class="home-slide__kicker">{{item.kicker}}</text>
          <text wx:for="{{item.lines}}" wx:for-item="line" wx:for-index="lineIndex" wx:key="*this" class="home-slide__line {{item.copyVariant === 'campaign-split' && lineIndex > 0 ? 'home-slide__line--secondary' : ''}}">{{line}}</text>
        </view>
      </view>
    </swiper-item>
  </swiper>
  <view wx:elif="{{state === 'loading'}}" class="home-state"><text>正在读取此刻内容…</text></view>
  <view wx:elif="{{state === 'empty'}}" class="home-state"><text>此刻内容正在准备中</text></view>
  <view wx:else class="home-state"><text>内容暂时没有读到</text><button bindtap="loadContent">重新加载</button></view>
  <view wx:if="{{state === 'ready' && items.length > 1}}" class="home-indicator">
    <view wx:for="{{items}}" wx:key="contentId" class="home-indicator__dot {{current === index ? 'is-active' : ''}}"></view>
  </view>
</view>
