page { background: #080806; }
.welcome, .welcome__swiper, .welcome__slide { width: 100%; height: 100vh; }
.welcome { position: relative; overflow: hidden; color: #fff; }
.welcome__slide { position: relative; box-sizing: border-box; background: #080806; }
.welcome__slide--first { background: linear-gradient(160deg, #202918 0%, #080806 58%, #2f291d 100%); }
.welcome__slide--second { background: linear-gradient(170deg, #1e2518 0%, #080806 42%, #342a20 100%); }
.welcome__wordmark-crop { position: absolute; top: calc(74rpx + env(safe-area-inset-top)); left: 40rpx; width: 168rpx; height: 44rpx; overflow: hidden; }
.welcome__wordmark { width: 228rpx; height: 44rpx; margin-left: -56rpx; }
.welcome__copy { position: absolute; right: 48rpx; left: 48rpx; display: flex; flex-direction: column; }
.welcome__copy--first { bottom: 286rpx; }
.welcome__copy--second { top: calc(210rpx + env(safe-area-inset-top)); padding-bottom: 220rpx; }
.welcome__kicker { color: #a6b77a; font-size: 22rpx; font-weight: 600; letter-spacing: 2rpx; }
.welcome__title { margin-top: 26rpx; font-size: 60rpx; line-height: 1.27; font-weight: 600; white-space: pre-line; }
.welcome__subtitle { margin-top: 28rpx; color: #f7f4ec; font-size: 28rpx; }
.welcome__lead { font-size: 40rpx; line-height: 1.4; font-weight: 600; }
.welcome__body { margin-top: 38rpx; color: #f7f4ec; font-size: 27rpx; line-height: 1.68; white-space: pre-line; }
.welcome__dots { position: absolute; z-index: 2; bottom: calc(68rpx + env(safe-area-inset-bottom)); left: 50%; display: flex; gap: 12rpx; transform: translateX(-50%); }
.welcome__dot { width: 8rpx; height: 8rpx; border-radius: 8rpx; background: rgba(255,255,255,.5); transition: width .28s ease; }
.welcome__dot.is-active { width: 32rpx; background: #fff; }
.welcome__skip { position: absolute; z-index: 3; right: 32rpx; bottom: calc(52rpx + env(safe-area-inset-bottom)); min-width: 84rpx; padding: 0; color: #fff; background: transparent; border: 0; font-size: 28rpx; line-height: 48rpx; }
.welcome__skip::after { border: 0; }
