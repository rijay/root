<view class="profile-shell">
  <text class="profile-shell__title">我的</text>
  <view class="profile-shell__identity" bindtap="openLogin">
    <view class="profile-shell__avatar">Root</view>
    <view class="profile-shell__identity-copy">
      <text>{{loggedIn ? 'Root用户' : '登录 Root 会员'}}</text>
      <text>{{loggedIn ? '管理个人资料' : '探索更多可能'}}</text>
    </view>
    <text class="profile-shell__chevron">›</text>
  </view>
  <view class="profile-shell__menu profile-shell__menu--member">
    <view data-intent="member-orders" bindtap="openMemberEntry"><text>我的订单</text><text>会员中心　›</text></view>
    <view data-intent="member-coupons" bindtap="openMemberEntry"><text>优惠券</text><text>会员中心　›</text></view>
  </view>
  <view class="profile-shell__menu">
    <view bindtap="openSupport"><text>联系客服</text><text>›</text></view>
    <view bindtap="openAbout"><text>关于 Root</text><text>›</text></view>
  </view>
</view>
