<scroll-view class="profile-page" scroll-y enhanced show-scrollbar="false">
  <view class="profile-page__content profile-page__content--{{!loggedIn ? 'guest' : (memberLinkFailure ? 'failure' : 'member')}}">
    <text class="profile-page__title">我的</text>

    <view class="profile-identity" bindtap="handleIdentityTap">
      <view class="profile-identity__avatar">
        <image wx:if="{{loggedIn && profile.avatarUrl}}" src="{{profile.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="profile-identity__default"><root-wordmark tone="light" /></view>
      </view>
      <view class="profile-identity__copy">
        <text class="profile-identity__name">{{sessionChecking ? '正在核验' : (loggedIn ? (profile.nickname || 'Root用户') : '未登录')}}</text>
        <text class="profile-identity__hint">{{sessionChecking ? '正在确认会员身份' : (loggedIn ? '已登录' : '登录后管理个人资料')}}</text>
      </view>
      <view wx:if="{{loggedIn}}" class="profile-identity__edit">
        <text>编辑资料</text><view class="profile-row__arrow"></view>
      </view>
    </view>

    <button wx:if="{{!loggedIn && !sessionChecking}}" class="profile-login" style="width: 350px;" bindtap="openLogin">登录 / 注册</button>

    <view class="profile-card profile-card--member">
      <view class="profile-row" data-key="orders" bindtap="openMemberEntry">
        <text class="profile-row__label">我的订单</text>
        <text class="profile-row__hint">{{loggedIn ? '会员中心' : '登录后前往'}}</text>
        <view class="profile-row__arrow"></view>
      </view>
      <view class="profile-row" data-key="coupons" bindtap="openMemberEntry">
        <text class="profile-row__label">优惠券</text>
        <text class="profile-row__hint">{{loggedIn ? '会员中心' : '登录后前往'}}</text>
        <view class="profile-row__arrow"></view>
      </view>
    </view>

    <view wx:if="{{memberLinkFailure}}" class="profile-member-failure">
      <text class="profile-member-failure__title">暂时无法打开 Root 会员中心</text>
      <text class="profile-member-failure__copy">请稍后重试，当前页面内容不会丢失。</text>
      <button class="profile-member-failure__retry" style="width: 96px;" bindtap="retryMemberEntry">重试打开</button>
    </view>

    <view class="profile-card profile-card--support">
      <view class="profile-row" bindtap="openAssessmentHistory"><text class="profile-row__label">评测历史</text><view class="profile-row__arrow"></view></view>
      <view class="profile-row" data-type="faq" bindtap="openSupport"><text class="profile-row__label">常见问题</text><view class="profile-row__arrow"></view></view>
      <view class="profile-row" data-type="contact" bindtap="openSupport"><text class="profile-row__label">联系客服</text><view class="profile-row__arrow"></view></view>
      <view class="profile-row" data-type="feedback" bindtap="openSupport"><text class="profile-row__label">建议与反馈</text><view class="profile-row__arrow"></view></view>
      <view class="profile-row" bindtap="openAbout"><text class="profile-row__label">关于 Root</text><view class="profile-row__arrow"></view></view>
    </view>

    <button wx:if="{{loggedIn}}" class="profile-logout" style="width: 350px;" bindtap="logout">退出登录</button>
    <text class="profile-version">myRoot v{{version}}</text>
  </view>
</scroll-view>
