<view class="root-page profile-page">
  <view class="profile-hero">
    <image class="profile-logo" src="/static/brand/root-logo-horizontal-light.png" mode="aspectFit" />
    <view class="profile-identity">
      <image class="avatar" src="{{avatarSrc}}" mode="aspectFill" />
      <view class="user-main">
        <view class="nickname">{{user.nickname || 'ROOT用户'}}</view>
        <view class="phone">{{user.phone || '未绑定手机号'}}</view>
      </view>
      <view class="state-badge">{{statusBadge}}</view>
    </view>
    <view class="profile-quote">身体自有其序，记录会让它被看见。</view>
  </view>

  <view class="root-card status-card">
    <view class="root-section-title">当前记录状态</view>
    <view wx:if="{{progress.length}}" class="mini-progress">
      <view wx:for="{{progress}}" wx:key="dayIndex" class="mini-dot {{item.className}}"></view>
    </view>
    <view wx:elif="{{dailyStats}}" class="daily-status">
      <view class="daily-status-item">
        <text class="num">{{dailyStats.totalDays}}</text>
        <text>累计</text>
      </view>
      <view class="daily-status-item">
        <text class="num">{{dailyStats.currentStreak}}</text>
        <text>当前连续</text>
      </view>
      <view class="daily-status-item">
        <text class="num">{{dailyStats.longestStreak}}</text>
        <text>最长连续</text>
      </view>
    </view>
    <view wx:else class="root-helper-text">完成登录和画像后，即可开启 7 日重启计划。</view>
    <view class="status-meta">
      <text>累计记录 {{dailyStats ? dailyStats.totalDays : checkedDays}} 天</text>
      <text>免单状态：{{refundStatus}}</text>
    </view>
  </view>

  <view class="root-cell-group menu-card">
    <view wx:if="{{showRecords}}" class="menu-row" data-url="/subpkg/checkin/pages/history/index" bindtap="goLink">
      <text>记录历史</text><text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" data-url="/subpkg/profile/pages/tags/index" bindtap="goLink">
      <text>身体反馈画像</text><text class="menu-arrow">›</text>
    </view>
    <view wx:if="{{showOrders}}" class="menu-row" data-url="/subpkg/profile/pages/orders/index" bindtap="goLink">
      <text>订单与物流</text><text class="menu-arrow">›</text>
    </view>
    <button class="menu-row contact-row" open-type="contact" session-from="profile">
      <text>人工协助</text><text class="menu-arrow">›</text>
    </button>
    <view class="menu-row" data-url="/subpkg/profile/pages/about/index" bindtap="goLink">
      <text>关于 ROOT</text><text class="menu-arrow">›</text>
    </view>
  </view>

  <button class="root-button root-button--secondary logout-btn" bindtap="logout">退出登录</button>
  <view class="version">v0.3.1</view>
</view>
