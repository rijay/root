page,
.profile-page {
  height: 100vh;
  background: var(--color-brand-white);
}

.profile-page__content {
  position: relative;
  min-height: 760px;
  box-sizing: border-box;
}

.profile-page__title {
  position: absolute;
  top: 78px;
  left: 20px;
  width: calc(100% - 40px);
  height: 38px;
  color: var(--color-brand-black);
  font-size: 30px;
  font-weight: 600;
  line-height: 38px;
}

.profile-identity {
  position: absolute;
  top: 130px;
  left: 20px;
  display: flex;
  align-items: center;
  width: calc(100% - 40px);
  height: 72px;
}

.profile-identity__avatar {
  flex: 0 0 72px;
  width: 72px;
  height: 72px;
  overflow: hidden;
  background: var(--color-brand-black);
  border-radius: 20px;
}

.profile-identity__avatar image {
  width: 100%;
  height: 100%;
}

.profile-identity__default {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  transform: scale(.715);
}

.profile-identity__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  margin-left: 20px;
}

.profile-identity__name {
  max-width: 178px;
  overflow: hidden;
  color: var(--color-brand-black);
  font-size: 21px;
  font-weight: 600;
  line-height: 28px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-identity__hint {
  margin-top: 6px;
  color: var(--color-neutral-grey);
  font-size: 13px;
  line-height: 20px;
}

.profile-identity__edit {
  position: absolute;
  top: 16px;
  right: 6px;
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--color-neutral-grey);
  font-size: 12px;
  line-height: 20px;
}

.profile-login {
  position: absolute;
  top: 226px;
  left: 20px;
  height: 52px;
  min-height: 52px;
  margin: 0 !important;
  padding: 0;
  color: var(--color-brand-white);
  background: var(--color-brand-olive);
  border-radius: 12px;
  font-size: 16px;
  font-weight: 600;
  line-height: 52px;
  width: calc(100% - 40px) !important;
}

.profile-login::after,
.profile-member-failure__retry::after {
  border: 0;
}

.profile-card {
  position: absolute;
  left: 20px;
  width: calc(100% - 40px);
  overflow: hidden;
  box-sizing: border-box;
  padding: 0 16px;
  background: var(--color-brand-white);
  border-radius: 14px;
}

.profile-page__content--guest .profile-card--member {
  top: 306px;
  height: 128px;
}

.profile-page__content--member .profile-card--member,
.profile-page__content--failure .profile-card--member {
  top: 226px;
  height: 128px;
  border-radius: 16px;
}

.profile-row {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  color: var(--color-graphite);
  border-bottom: 1px solid var(--color-ui-line-solid);
  font-size: 14px;
}

.profile-card--member .profile-row {
  height: 64px;
  color: var(--color-brand-black);
  font-weight: 500;
}

.profile-page__content--guest .profile-card--support {
  top: 446px;
  height: 220px;
}

.profile-page__content--guest .profile-card--support .profile-row {
  height: 55px;
}

.profile-page__content--member .profile-card--support {
  top: 382px;
  height: 176px;
}

.profile-page__content--member .profile-card--support .profile-row {
  height: 44px;
}

.profile-page__content--failure .profile-card--support {
  top: 500px;
  height: 138px;
}

.profile-page__content--failure .profile-card--support .profile-row {
  height: 34.5px;
}

.profile-row:last-child {
  border-bottom: 0;
}

.profile-row__label {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-row__hint {
  width: 96px;
  margin-right: 10px;
  color: var(--color-neutral-grey);
  font-size: 11px;
  font-weight: 400;
  line-height: 18px;
  text-align: right;
}

.profile-row__arrow {
  flex: 0 0 4px;
  width: 4px;
  height: 8px;
  margin-right: 1px;
  border-top: 1px solid var(--color-neutral-grey);
  border-right: 1px solid var(--color-neutral-grey);
  transform: rotate(45deg);
}

.profile-member-failure {
  position: absolute;
  top: 374px;
  left: 20px;
  width: calc(100% - 40px);
  height: 100px;
  box-sizing: border-box;
  padding: 18px 16px;
  background: var(--color-olive-tint);
  border-radius: 14px;
}

.profile-member-failure__title,
.profile-member-failure__copy {
  display: block;
}

.profile-member-failure__title {
  color: var(--color-brand-black);
  font-size: 15px;
  font-weight: 500;
  line-height: 22px;
}

.profile-member-failure__copy {
  margin-top: 10px;
  color: var(--color-neutral-grey);
  font-size: 11px;
  line-height: 18px;
}

.profile-member-failure__retry {
  position: absolute;
  top: 46px;
  right: 16px;
  height: 34px;
  min-height: 34px;
  margin: 0 !important;
  padding: 0;
  color: var(--color-brand-olive);
  background: var(--color-brand-white);
  border-radius: 10px;
  font-size: 12px;
  font-weight: 500;
  line-height: 34px;
}

.profile-version {
  position: absolute;
  left: 20px;
  width: calc(100% - 40px);
  height: 18px;
  color: var(--color-neutral-grey);
  font-size: 11px;
  line-height: 18px;
  text-align: center;
}

.profile-page__content--guest .profile-version {
  top: 706px;
}

.profile-page__content--member .profile-version {
  top: 578px;
}

.profile-page__content--failure .profile-version {
  top: 656px;
}
