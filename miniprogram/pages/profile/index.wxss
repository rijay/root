.profile-shell { min-height: 100vh; padding: calc(108rpx + env(safe-area-inset-top)) 40rpx calc(160rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #fdfbf6; }
.profile-shell__title { color: #080806; font-size: 60rpx; font-weight: 600; }
.profile-shell__identity { display: flex; align-items: center; margin-top: 54rpx; padding: 34rpx 28rpx; background: #fff; border-radius: 28rpx; }
.profile-shell__avatar { display: flex; align-items: center; justify-content: center; width: 104rpx; height: 104rpx; color: #fff; background: #586b3f; border-radius: 52rpx; font-family: Georgia, serif; font-size: 26rpx; }
.profile-shell__identity-copy { display: flex; flex: 1; flex-direction: column; gap: 10rpx; margin-left: 24rpx; }
.profile-shell__identity-copy text:first-child { color: #080806; font-size: 32rpx; font-weight: 600; }
.profile-shell__identity-copy text:last-child { color: #8a8172; font-size: 24rpx; }
.profile-shell__chevron { color: #8a8172; font-size: 40rpx; }
.profile-shell__menu { margin-top: 28rpx; padding: 0 28rpx; background: #fff; border-radius: 28rpx; }
.profile-shell__menu view { display: flex; align-items: center; justify-content: space-between; min-height: 104rpx; color: #433e34; border-bottom: 1rpx solid #e8e0d0; font-size: 28rpx; }
.profile-shell__menu view:last-child { border-bottom: 0; }
.profile-shell__menu view text:last-child { color: #8a8172; font-size: 22rpx; text-align: right; }
.profile-shell__menu--member { margin-top: 32rpx; }
