page,
.profile-page {
  height: 100vh;
  background: var(--color-brand-white);
}

.profile-page__content {
  min-height: calc(100vh - 52px - env(safe-area-inset-bottom));
  padding: 78px 20px calc(92px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.profile-page__title {
  display: block;
  color: var(--color-brand-black);
  font-size: 30px;
  font-weight: 600;
  line-height: 38px;
}

.profile-identity {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  height: 72px;
  margin-top: 14px;
}

.profile-identity__avatar {
  flex: 0 0 72px;
  width: 72px;
  height: 72px;
  overflow: hidden;
  background: var(--color-brand-black);
  border-radius: 20px;
}

.profile-identity__avatar image {
  width: 100%;
  height: 100%;
}

.profile-identity__default {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  transform: scale(.715);
}

.profile-identity__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  margin-left: 20px;
}

.profile-identity__name {
  max-width: 178px;
  overflow: hidden;
  color: var(--color-brand-black);
  font-size: 21px;
  font-weight: 600;
  line-height: 28px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-identity__hint {
  margin-top: 6px;
  color: var(--color-neutral-grey);
  font-size: 13px;
  line-height: 20px;
}

.profile-identity__edit {
  position: absolute;
  top: 16px;
  right: 6px;
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--color-neutral-grey);
  font-size: 12px;
  line-height: 20px;
}

.profile-login {
  height: 52px;
  min-height: 52px;
  margin: 24px 0 0 !important;
  padding: 0;
  color: var(--color-brand-white);
  background: var(--color-brand-olive);
  border-radius: 12px;
  font-size: 16px;
  font-weight: 600;
  line-height: 52px;
  width: 100% !important;
}

.profile-login::after,
.profile-member-failure__retry::after {
  border: 0;
}

.profile-card {
  display: flex;
  width: 100%;
  flex-direction: column;
  gap: 8px;
  box-sizing: border-box;
  padding: 0;
  background: transparent;
}

.profile-page__content--guest .profile-card--member {
  margin-top: 20px;
}

.profile-page__content--member .profile-card--member,
.profile-page__content--failure .profile-card--member {
  margin-top: 24px;
}

.profile-row {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 52px;
  padding: 0 16px;
  box-sizing: border-box;
  color: var(--color-graphite);
  background: var(--color-ui-grouped);
  border-radius: 12px;
  font-size: 14px;
}

.profile-card--member .profile-row {
  min-height: 60px;
  color: var(--color-brand-black);
  background: var(--color-olive-tint);
  font-weight: 500;
}

.profile-page__content--guest .profile-card--support {
  margin-top: 16px;
}

.profile-page__content--member .profile-card--support {
  margin-top: 16px;
}

.profile-page__content--failure .profile-card--support {
  margin-top: 16px;
}

.profile-row__label {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-row__hint {
  width: 96px;
  margin-right: 10px;
  color: var(--color-neutral-grey);
  font-size: 11px;
  font-weight: 400;
  line-height: 18px;
  text-align: right;
}

.profile-row__arrow {
  flex: 0 0 7px;
  width: 7px;
  height: 7px;
  margin-right: 3px;
  border-top: 1px solid var(--color-neutral-grey);
  border-right: 1px solid var(--color-neutral-grey);
  transform: rotate(45deg);
}

.profile-member-failure {
  position: relative;
  width: 100%;
  min-height: 100px;
  margin-top: 16px;
  box-sizing: border-box;
  padding: 18px 16px;
  background: var(--color-olive-tint);
  border-radius: 14px;
}

.profile-member-failure__title,
.profile-member-failure__copy {
  display: block;
}

.profile-member-failure__title {
  color: var(--color-brand-black);
  font-size: 15px;
  font-weight: 500;
  line-height: 22px;
}

.profile-member-failure__copy {
  margin-top: 10px;
  color: var(--color-neutral-grey);
  font-size: 11px;
  line-height: 18px;
}

.profile-member-failure__retry {
  position: absolute;
  top: 46px;
  right: 16px;
  height: 34px;
  min-height: 34px;
  margin: 0 !important;
  padding: 0;
  color: var(--color-brand-olive);
  background: var(--color-brand-white);
  border-radius: 10px;
  font-size: 12px;
  font-weight: 500;
  line-height: 34px;
}

.profile-version {
  display: block;
  width: 100%;
  margin-top: 28px;
  color: var(--color-neutral-grey);
  font-size: 11px;
  line-height: 18px;
  text-align: center;
}
