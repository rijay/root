.profile-page {
  padding-top: var(--spacing-lg);
  padding-bottom: calc(184rpx + env(safe-area-inset-bottom));
}

.profile-hero {
  padding: 32rpx;
  color: var(--color-root-nav);
  background: var(--color-root-moss);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-md);
}

.profile-logo {
  width: 176rpx;
  height: 34rpx;
}

.profile-identity {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  margin-top: 36rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  background: var(--color-surface);
  border: 4rpx solid rgba(253, 251, 246, 0.78);
  border-radius: 50%;
}

.avatar--default {
  padding: 22rpx;
  box-sizing: border-box;
}

.avatar--photo {
  padding: 0;
}

.user-main {
  flex: 1;
  min-width: 0;
}

.nickname {
  color: var(--color-root-nav);
  font-size: var(--font-size-lg);
  font-weight: 800;
  line-height: 1.25;
}

.phone {
  margin-top: var(--spacing-xs);
  color: rgba(253, 251, 246, 0.72);
  font-size: var(--font-size-sm);
}

.state-badge {
  flex-shrink: 0;
  max-width: 220rpx;
  padding: 10rpx 18rpx;
  color: var(--color-root-ink);
  background: var(--color-root-nav);
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  font-weight: 800;
  line-height: 1.35;
  text-align: center;
}

.profile-quote {
  margin-top: 28rpx;
  color: rgba(253, 251, 246, 0.78);
  font-size: 26rpx;
  line-height: 1.6;
}

.display-profile-card {
  margin-top: var(--spacing-lg);
}

.display-profile-note {
  margin-top: var(--spacing-xs);
}

.display-profile-form {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  margin-top: var(--spacing-md);
}

.avatar-picker {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  width: 136rpx;
  color: var(--color-root-muted);
  font-size: var(--font-size-xs);
  line-height: 1.4;
  text-align: center;
}

.avatar-picker-image {
  width: 104rpx;
  height: 104rpx;
  padding: 22rpx;
  box-sizing: border-box;
  background: var(--color-root-bg);
  border: 1rpx solid var(--color-root-line);
  border-radius: 50%;
}

.avatar-picker-image--photo {
  padding: 0;
}

.avatar-picker-text {
  margin-top: var(--spacing-xs);
}

.avatar-picker-hitarea {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  background: transparent;
  border: 0;
  border-radius: 0;
  opacity: 0;
  line-height: 1;
}

.avatar-picker-hitarea::after {
  border: 0;
}

.nickname-field {
  flex: 1;
  min-width: 0;
}

.field-label {
  color: var(--color-root-muted);
  font-size: var(--font-size-xs);
}

.nickname-input {
  height: 76rpx;
  margin-top: var(--spacing-xs);
  padding: 0 var(--spacing-md);
  box-sizing: border-box;
  color: var(--color-root-ink);
  background: var(--color-root-bg);
  border: 1rpx solid var(--color-root-line);
  border-radius: var(--radius-md);
  font-size: var(--font-size-base);
}

.display-save-btn {
  width: 100%;
  margin-top: var(--spacing-md);
  padding: 0;
}

.status-card {
  margin-top: var(--spacing-lg);
}

.mini-progress {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 12rpx;
  margin-top: var(--spacing-md);
}

.mini-dot {
  height: 28rpx;
  background: var(--color-root-line);
  border-radius: var(--radius-full);
}

.mini-dot.done {
  background: var(--color-root-moss);
}

.daily-status {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--spacing-sm);
  margin-top: var(--spacing-md);
  text-align: center;
}

.daily-status-item {
  padding: var(--spacing-sm);
  background: var(--color-root-bg);
  border-radius: var(--radius-md);
  color: var(--color-root-muted);
  font-size: var(--font-size-xs);
}

.num {
  display: block;
  color: var(--color-root-moss);
  font-size: var(--font-size-xl);
  font-weight: 900;
}

.status-meta {
  display: flex;
  justify-content: space-between;
  gap: var(--spacing-md);
  margin-top: var(--spacing-md);
  color: var(--color-root-muted);
  font-size: var(--font-size-xs);
  line-height: 1.5;
}

.menu-card {
  margin-top: var(--spacing-lg);
}

.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  box-sizing: border-box;
  width: 100%;
  margin: 0;
  padding: 0 var(--spacing-lg);
  color: var(--color-root-ink);
  background: transparent;
  border: 0;
  border-bottom: 1rpx solid var(--color-root-line);
  border-radius: 0;
  font-size: var(--font-size-base);
  font-weight: 700;
  line-height: normal;
  text-align: left;
}

.menu-row::after {
  border: 0;
}

.menu-label {
  display: block;
  flex: 1;
  min-width: 0;
  text-align: left;
}

.menu-row:last-child {
  border-bottom: 0;
}

.contact-menu-row {
  position: relative;
}

.contact-hitarea {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  background: transparent;
  border: 0;
  border-radius: 0;
  opacity: 0;
  line-height: 1;
}

.contact-hitarea::after {
  border: 0;
}

.menu-arrow {
  flex-shrink: 0;
  color: var(--color-root-muted);
  font-size: 38rpx;
  font-weight: 400;
}

.logout-btn {
  width: 100%;
  margin-top: var(--spacing-lg);
  padding: 0;
}

.version {
  margin-top: var(--spacing-md);
  color: var(--color-root-muted);
  font-size: var(--font-size-xs);
  text-align: center;
}
