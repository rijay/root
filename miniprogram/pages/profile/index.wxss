page { background: #fdfbf6; }
.profile-page { height: 100vh; background: #fdfbf6; }
.profile-page__content { min-height: 100vh; padding: calc(108rpx + env(safe-area-inset-top)) 40rpx calc(184rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.profile-page__title { color: #080806; font-size: 60rpx; font-weight: 600; }
.profile-identity { display: flex; align-items: center; margin-top: 28rpx; padding: 10rpx 0 26rpx; }
.profile-identity__avatar { width: 144rpx; height: 144rpx; overflow: hidden; background: #080806; border-radius: 40rpx; }
.profile-identity__avatar image { width: 100%; height: 100%; }
.profile-identity__default { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; padding: 0 18rpx; box-sizing: border-box; }
.profile-identity__copy { display: flex; flex: 1; flex-direction: column; gap: 12rpx; margin-left: 40rpx; }
.profile-identity__name { color: #080806; font-size: 42rpx; font-weight: 600; }
.profile-identity__hint { color: #8a8172; font-size: 26rpx; }
.profile-login { height: 104rpx; margin: 20rpx 0 56rpx; color: #fff; background: #586b3f; border-radius: 24rpx; font-size: 32rpx; font-weight: 600; line-height: 104rpx; }
.profile-login::after, .profile-logout::after { border: 0; }
.profile-card { margin-top: 24rpx; padding: 0 32rpx; background: #fff; border-radius: 28rpx; }
.profile-card--member { margin-top: 18rpx; }
.profile-row { display: flex; align-items: center; justify-content: space-between; min-height: 104rpx; color: #433e34; border-bottom: 1rpx solid #e8e0d0; font-size: 28rpx; }
.profile-row:last-child { border-bottom: 0; }
.profile-row__arrow { width: 12rpx; height: 12rpx; margin-right: 4rpx; border-top: 2rpx solid #a39a8b; border-right: 2rpx solid #a39a8b; transform: rotate(45deg); }
.profile-logout { height: 96rpx; margin-top: 48rpx; color: #9a4639; background: transparent; border: 1rpx solid rgba(154,70,57,.38); border-radius: 24rpx; font-size: 28rpx; line-height: 96rpx; }
.profile-version { display: block; margin-top: 34rpx; color: #8a8172; font-size: 22rpx; text-align: center; }
