<view class="root-page progress-detail-page">
  <view class="progress-header">
    <view class="eyebrow">{{campaign.title || 'ROOT 活动'}}</view>
    <view class="progress-title">进度详情</view>
    <view class="progress-copy">这里展示当前活动配置下的任务条件和完成状态。</view>
  </view>

  <view wx:if="{{loading}}" class="root-card state-card">
    <view class="root-helper-text">正在加载进度...</view>
  </view>

  <view wx:elif="{{errorText}}" class="root-card state-card">
    <view class="root-section-title">进度暂未加载</view>
    <view class="root-helper-text">{{errorText}}</view>
    <button class="root-button state-btn" bindtap="load">重新加载</button>
  </view>

  <view wx:else>
    <view class="root-card summary-card">
      <view class="summary-percent">{{progress.summary.progressPercent || 0}}%</view>
      <view class="root-helper-text">必做任务 {{progress.summary.requiredCompletedTasks || 0}}/{{progress.summary.requiredTasks || 0}}</view>
    </view>
    <view class="detail-list">
      <view wx:for="{{tasks}}" wx:key="taskDefinitionId" class="root-card detail-task-card {{item.statusClass}}">
        <view class="detail-task-top">
          <view>
            <view class="task-type">{{item.typeLabel}}</view>
            <view class="task-title">{{item.title}}</view>
          </view>
          <view class="task-status">{{item.statusLabel}}</view>
        </view>
        <view class="task-desc">{{item.description}}</view>
        <view class="task-count">完成 {{item.completedCount || 0}} 次 / 目标 {{item.targetCount || 1}} 次</view>
      </view>
    </view>
  </view>
</view>
