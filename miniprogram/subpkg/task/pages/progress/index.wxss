.progress-detail-page {
  padding-top: 40rpx;
}

.progress-header {
  padding: 20rpx 0 28rpx;
}

.progress-title {
  margin-top: 14rpx;
  color: var(--color-root-ink);
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.18;
}

.progress-copy {
  margin-top: 16rpx;
  color: var(--color-root-copy);
  font-size: var(--font-size-base);
  line-height: 1.7;
}

.state-card,
.summary-card {
  margin-top: 24rpx;
}

.state-btn {
  margin-top: 24rpx;
}

.summary-percent {
  color: var(--color-root-clay);
  font-size: 64rpx;
  font-weight: 800;
  line-height: 1;
}

.detail-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
}

.detail-task-card.done {
  background: var(--color-primary-tint);
}

.detail-task-top {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
}

.task-type {
  color: var(--color-root-moss);
  font-size: var(--font-size-xs);
  font-weight: 800;
}

.task-title {
  margin-top: 10rpx;
  color: var(--color-root-ink);
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.3;
}

.task-status {
  flex: 0 0 112rpx;
  color: var(--color-root-moss);
  font-size: var(--font-size-sm);
  font-weight: 800;
  text-align: right;
}

.task-desc,
.task-count {
  margin-top: 14rpx;
  color: var(--color-root-copy);
  font-size: var(--font-size-sm);
  line-height: 1.55;
}

.task-count {
  color: var(--color-root-muted);
}
