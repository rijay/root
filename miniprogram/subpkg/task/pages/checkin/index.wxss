.task-submit-page {
  padding-top: 40rpx;
  padding-bottom: 160rpx;
}

.submit-header {
  padding: 20rpx 0 28rpx;
}

.submit-title {
  margin-top: 14rpx;
  color: var(--color-root-ink);
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.18;
}

.submit-copy {
  margin-top: 16rpx;
  color: var(--color-root-copy);
  font-size: var(--font-size-base);
  line-height: 1.7;
}

.submit-card {
  margin-top: 24rpx;
}

.choice-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 24rpx;
}

.choice,
.stool-option {
  min-height: 76rpx;
  padding: 0 20rpx;
  color: var(--color-root-copy);
  background: var(--color-primary-tint);
  border: 1rpx solid transparent;
  border-radius: var(--radius-control);
  font-size: var(--font-size-base);
  font-weight: 700;
  line-height: 76rpx;
  text-align: center;
}

.choice.active,
.stool-option.active {
  color: var(--color-root-surface);
  background: var(--color-root-moss);
}

.stool-options {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 22rpx;
}

.feedback-input {
  width: 100%;
  min-height: 180rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
  color: var(--color-root-ink);
  background: var(--color-primary-tint);
  border-radius: var(--radius-md);
  font-size: var(--font-size-base);
  line-height: 1.6;
}

.sticky-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: var(--color-glass);
  border-top: 1rpx solid var(--color-root-line);
}
