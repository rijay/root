page {
  height: 100%;
  overflow: hidden;
  background: var(--color-ui-grouped);
}

.root-with-you {
  position: relative;
  height: 100vh;
  overflow: hidden;
  color: var(--color-olive-dark);
  background: var(--color-ui-grouped);
}

.root-with-you__scroll {
  width: 100%;
  height: 100%;
}

.root-with-you__art {
  position: relative;
  width: 100%;
}

.root-with-you__image {
  display: block;
  width: 100%;
}

.root-with-you__image-skeleton,
.root-with-you__image-fallback {
  width: 100%;
  min-height: 1180rpx;
  background: linear-gradient(110deg, var(--color-olive-soft) 22%, var(--color-ui-grouped) 38%, var(--color-olive-soft) 54%);
  background-size: 220% 100%;
  animation: root-with-you-skeleton 1.4s ease-in-out infinite;
}

.root-with-you__image-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 20rpx;
  padding: 64rpx;
  box-sizing: border-box;
  color: var(--color-olive-mid);
  background: var(--color-olive-tint);
  animation: none;
  font-size: 26rpx;
  text-align: center;
}

.root-with-you__art-action {
  position: absolute;
  right: 28%;
  bottom: 4.2%;
  left: 28%;
  height: 96rpx;
  margin: 0;
  padding: 0;
  color: transparent;
  background: transparent;
  border: 0;
  font-size: 1rpx;
  line-height: 96rpx;
}

.root-with-you__art-action::after,
.root-with-you__primary::after {
  border: 0;
}

.root-with-you__terms {
  margin: 28rpx 40rpx 0;
  color: var(--color-neutral-grey);
  font-size: 22rpx;
  line-height: 1.65;
  text-align: center;
}

.root-with-you__spacer {
  height: calc(152rpx + env(safe-area-inset-bottom));
}

.root-with-you__dock {
  position: fixed;
  z-index: 12;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(245, 245, 247, 0.94);
  border-top: 1rpx solid rgba(36, 48, 15, 0.12);
  backdrop-filter: blur(18rpx);
}

.root-with-you__primary {
  width: 100%;
  min-height: 96rpx;
  margin: 0;
  color: var(--color-brand-white);
  background: var(--color-olive-mid);
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 96rpx;
  letter-spacing: 1rpx;
  animation: root-with-you-breathe 2.8s ease-in-out infinite;
}

@keyframes root-with-you-breathe {
  0%, 100% { box-shadow: 0 0 0 0 rgba(81, 101, 51, 0); transform: scale(1); }
  50% { box-shadow: 0 12rpx 34rpx rgba(81, 101, 51, 0.24); transform: scale(1.012); }
}

@keyframes root-with-you-skeleton {
  from { background-position: 100% 0; }
  to { background-position: -100% 0; }
}

@media (prefers-reduced-motion: reduce) {
  .root-with-you__scroll {
    scroll-behavior: auto;
  }

  .root-with-you__primary,
  .root-with-you__image-skeleton {
    animation: none;
  }
}
