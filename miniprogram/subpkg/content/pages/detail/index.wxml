<view class="content-detail" bindtap="handleAction">
  <page-navigation tone="light" show-home="{{false}}" />
  <block wx:if="{{state === 'ready'}}">
    <block wx:if="{{item.assets && item.assets.length}}">
      <view wx:for="{{item.assets}}" wx:for-item="asset" wx:for-index="assetIndex" wx:key="assetId" class="content-detail__asset">
        <image class="content-detail__image" src="{{asset.imageUrl}}" mode="widthFix" lazy-load="{{assetIndex > 0}}" />
        <button
          wx:for="{{asset.hotspots}}"
          wx:for-item="hotspot"
          wx:for-index="hotspotIndex"
          wx:key="id"
          class="content-detail__hotspot"
          style="left: {{hotspot.x}}%; top: {{hotspot.y}}%; width: {{hotspot.width}}%; height: {{hotspot.height}}%;"
          data-asset-index="{{assetIndex}}"
          data-hotspot-index="{{hotspotIndex}}"
          catchtap="handleHotspot"
          aria-label="打开相关内容"
        />
      </view>
    </block>
    <block wx:else>
      <image wx:for="{{item.detailImages}}" wx:for-index="detailIndex" wx:key="*this" class="content-detail__image" src="{{item}}" mode="widthFix" lazy-load="{{detailIndex > 0}}" />
    </block>
    <view wx:if="{{(!item.assets || item.assets.length === 0) && item.detailImages.length === 0}}" class="content-detail__placeholder">
      <view class="content-detail__wordmark" style="top: {{wordmarkTop}}px;"><root-wordmark tone="light" /></view>
      <text class="content-detail__kicker">{{item.kicker}}</text>
      <view class="content-detail__title">
        <text wx:for="{{item.lines}}" wx:for-item="line" wx:key="*this" class="content-detail__line">{{line}}</text>
      </view>
      <text class="content-detail__body">不追求立竿见影的幻觉。\n从每天可以持续的选择开始，\n让身体重新找回自己的秩序。</text>
    </view>
  </block>
  <view wx:elif="{{state === 'loading'}}" class="content-detail__state">正在读取内容…</view>
  <view wx:else class="content-detail__state"><text>内容暂时没有读到</text><button catchtap="loadDetail">重新加载</button></view>
</view>
