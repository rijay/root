page {
  height: 100%;
  overflow: hidden;
  background: var(--color-olive-soft);
}

.brand-foundation {
  position: relative;
  height: 100vh;
  overflow: hidden;
  background: var(--color-olive-soft);
}

.brand-foundation__swiper,
.brand-foundation__slide,
.brand-foundation__image {
  width: 100%;
  height: 100%;
}

.brand-foundation__slide--1 { background: var(--color-olive-soft); }
.brand-foundation__slide--2 { background: var(--color-olive-mid); }
.brand-foundation__slide--3 { background: var(--color-brand-black); }
.brand-foundation__slide--4 { background: var(--color-neutral-grey); }
.brand-foundation__slide--5 { background: var(--color-neutral-grey); }

.brand-foundation__image {
  display: block;
}

.brand-foundation__progress {
  position: fixed;
  z-index: 8;
  right: 28rpx;
  bottom: calc(env(safe-area-inset-bottom) + 28rpx);
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 56rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 999rpx;
  color: var(--color-brand-white);
  background: rgba(0, 0, 0, 0.64);
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.18);
  backdrop-filter: blur(16rpx);
}

.brand-foundation__dots {
  display: flex;
  align-items: center;
  gap: 9rpx;
}

.brand-foundation__dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.42);
  transition: width 180ms ease, background 180ms ease;
}

.brand-foundation__dot.is-active {
  width: 24rpx;
  background: var(--color-brand-white);
}

.brand-foundation__count {
  min-width: 54rpx;
  font-size: 20rpx;
  line-height: 28rpx;
  letter-spacing: 1rpx;
  text-align: right;
}

@media (prefers-reduced-motion: reduce) {
  .brand-foundation__dot {
    transition: none;
  }
}
