<view class="page refund-page">
  <view class="panel">
    <view class="eyebrow">REFUND REVIEW</view>
    <view class="h1">人工退款处理</view>
    <view class="body">完成 7 天打卡并提交 Day8 收尾问卷后，系统会进入人工退款处理。</view>
  </view>

  <view class="section panel">
    <view class="list-item">
      <view class="section-title">周期</view>
      <view class="body">{{session.startDate}} 至 {{session.endDate}}</view>
    </view>
    <view class="list-item">
      <view class="section-title">订单状态</view>
      <view class="body">{{session.orderId ? '已匹配订单' : '未匹配订单，需要人工确认'}}</view>
    </view>
    <view class="list-item">
      <view class="section-title">资格状态</view>
      <view class="body">{{eligibility && eligibility.eligible ? '可进入人工退款处理' : (eligibility.reason || '待确认')}}</view>
    </view>
  </view>

  <button class="btn apply-btn" bindtap="apply" loading="{{loading}}" disabled="{{!(eligibility && eligibility.eligible)}}">进入人工退款处理</button>
</view>
