.history-page {
  padding-top: 44rpx;
}

.history-list {
  padding-top: var(--spacing-sm);
  padding-bottom: var(--spacing-sm);
}

.history-page .h1 {
  margin-top: var(--spacing-sm);
}

.history-page .root-helper-text {
  margin-top: var(--spacing-md);
  font-size: var(--font-size-sm);
}

.history-row {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  min-height: 120rpx;
}

.row-marker {
  display: flex;
  flex: 0 0 64rpx;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  color: var(--color-root-muted);
  background: var(--color-root-nav);
  border: 1rpx solid var(--color-root-line);
  border-radius: 50%;
  font-size: var(--font-size-xs);
  font-weight: 900;
}

.row-marker.done {
  color: var(--color-root-surface);
  background: var(--color-root-moss);
  border-color: var(--color-root-moss);
}

.history-row-content {
  min-width: 0;
  flex: 1;
}

.row-title {
  color: var(--color-root-ink);
  font-size: var(--font-size-lg);
  font-weight: 800;
}

.history-summary {
  margin-top: var(--spacing-xs);
  color: var(--color-root-copy);
  font-size: var(--font-size-sm);
  line-height: 1.45;
}

.row-pill {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  min-width: 92rpx;
  height: 52rpx;
  padding: 0 var(--spacing-sm);
  color: var(--color-root-muted);
  background: var(--color-root-nav);
  border: 1rpx solid var(--color-root-line);
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  font-weight: 800;
}

.row-pill.done {
  color: var(--color-root-surface);
  background: var(--color-root-moss);
  border-color: var(--color-root-moss);
}

.empty-state {
  padding: var(--spacing-xl) var(--spacing-md);
  text-align: center;
}

.empty-title {
  color: var(--color-root-ink);
  font-size: var(--font-size-lg);
  font-weight: 800;
}

.history-detail {
  padding-bottom: var(--spacing-sm);
}

.detail-date {
  margin-top: var(--spacing-sm);
}

.detail-row {
  display: flex;
  justify-content: space-between;
  gap: var(--spacing-md);
  padding: var(--spacing-md) 0;
  border-bottom: 1rpx solid var(--color-root-line);
}

.detail-row:last-child {
  border-bottom: 0;
}

.detail-row--long {
  display: block;
}

.detail-label {
  flex-shrink: 0;
  color: var(--color-root-muted);
  font-size: var(--font-size-sm);
  font-weight: 700;
}

.detail-value {
  color: var(--color-root-ink);
  font-size: var(--font-size-base);
  line-height: 1.6;
  text-align: right;
}

.detail-row--long .detail-value {
  margin-top: var(--spacing-xs);
  text-align: left;
}
