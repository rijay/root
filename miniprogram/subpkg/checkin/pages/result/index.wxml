<view class="root-page result-page">
  <view class="result-hero {{failed ? 'result-hero--support' : ''}}">
    <image class="result-logo" src="/static/brand/root-logo-horizontal-light.png" mode="aspectFit" />
    <view class="result-kicker">{{resultCopy.kicker}}</view>
    <view class="result-title">{{resultCopy.title}}</view>
    <view class="result-copy">{{resultCopy.description}}</view>
  </view>

  <view wx:if="{{record}}" class="root-card result-summary-card">
    <view class="section-title">今日摘要</view>
    <view wx:if="{{recordDate}}" class="root-helper-text result-date">{{recordDate}}</view>
    <view wx:for="{{summaryRows}}" wx:key="label" class="summary-row {{item.long ? 'summary-row--long' : ''}}">
      <view class="summary-label">{{item.label}}</view>
      <view class="summary-value">{{item.value}}</view>
    </view>
  </view>

  <view wx:if="{{statsItems.length}}" class="result-stat-strip">
    <view wx:for="{{statsItems}}" wx:key="label" class="result-stat-item">
      <text class="result-stat-value">{{item.value}}</text>
      <text class="result-stat-label">{{item.label}}</text>
    </view>
  </view>

  <view class="result-actions">
    <button wx:if="{{!failed && record}}" class="root-button" bindtap="goSharePoster">生成今日分享图</button>
    <button class="root-button root-button--secondary" bindtap="goHistory">{{mode === 'daily' ? '查看记录历史' : '查看试饮进度'}}</button>
    <button wx:if="{{!failed && mode === 'checkin' && completedDays >= 7}}" class="root-button root-button--secondary" bindtap="goRefund">申请免单</button>
    <view class="result-link" bindtap="goHome">返回首页</view>
  </view>
</view>
