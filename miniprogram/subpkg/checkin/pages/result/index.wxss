.result-page {
  padding-top: var(--spacing-lg);
}

.result-hero {
  min-height: 520rpx;
  padding: 48rpx 40rpx;
  color: var(--color-root-nav);
  background: var(--color-root-moss);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-md);
}

.result-hero--support {
  background: var(--color-root-clay);
}

.result-logo {
  width: 228rpx;
  height: 44rpx;
}

.result-kicker {
  margin-top: 88rpx;
  color: rgba(253, 251, 246, 0.72);
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.result-title {
  margin-top: var(--spacing-xs);
  font-size: 54rpx;
  font-weight: 900;
  line-height: 1.2;
}

.result-copy {
  max-width: 560rpx;
  margin-top: var(--spacing-md);
  color: rgba(253, 251, 246, 0.82);
  font-size: 28rpx;
  line-height: 1.7;
}

.result-summary {
  margin-top: var(--spacing-lg);
}

.result-summary-card {
  margin-top: var(--spacing-lg);
}

.result-date {
  margin-top: var(--spacing-xs);
}

.summary-row {
  display: flex;
  justify-content: space-between;
  gap: var(--spacing-md);
  padding: var(--spacing-md) 0;
  border-bottom: 1rpx solid var(--color-root-line);
}

.summary-row:last-child {
  border-bottom: 0;
}

.summary-row--long {
  display: block;
}

.summary-label {
  flex-shrink: 0;
  color: var(--color-root-muted);
  font-size: var(--font-size-sm);
  font-weight: 700;
}

.summary-value {
  color: var(--color-root-ink);
  font-size: var(--font-size-base);
  line-height: 1.6;
  text-align: right;
}

.summary-row--long .summary-value {
  margin-top: var(--spacing-xs);
  text-align: left;
}

.result-stat-strip {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--spacing-md);
  margin-top: var(--spacing-lg);
}

.result-stat-item {
  padding: var(--spacing-md);
  background: var(--color-primary-tint);
  border-radius: var(--radius-card);
}

.result-stat-value,
.result-stat-label {
  display: block;
}

.result-stat-value {
  color: var(--color-root-moss);
  font-size: var(--font-size-lg);
  font-weight: 900;
}

.result-stat-label {
  margin-top: var(--spacing-xs);
  color: var(--color-root-muted);
  font-size: var(--font-size-xs);
}

.result-actions {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
  margin-top: var(--spacing-xl);
}

.result-actions .root-button {
  width: 100%;
}

.result-link {
  min-height: 88rpx;
  color: var(--color-root-muted);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 88rpx;
  text-align: center;
}
