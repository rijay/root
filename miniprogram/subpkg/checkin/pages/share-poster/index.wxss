.share-page {
  padding-top: var(--spacing-lg);
}

.share-header {
  margin-bottom: var(--spacing-lg);
}

.poster-shell {
  position: relative;
  min-height: 900rpx;
  display: flex;
  justify-content: center;
}

.poster-canvas,
.poster-preview {
  width: 640rpx;
  border-radius: 24rpx;
  box-shadow: var(--shadow-md);
}

.poster-preview {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
}

.poster-loading {
  position: absolute;
  top: 360rpx;
  left: 0;
  right: 0;
  color: var(--color-root-muted);
  font-size: var(--font-size-sm);
  text-align: center;
}

.share-actions {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
  margin-top: var(--spacing-lg);
}

.share-actions .root-button {
  width: 100%;
}

.share-link {
  min-height: 88rpx;
  color: var(--color-root-muted);
  font-size: var(--font-size-base);
  font-weight: 700;
  line-height: 88rpx;
  text-align: center;
}
