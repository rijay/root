<view class="page today-page">
  <view class="panel">
    <view class="eyebrow">DAY {{session.currentDayIndex}}</view>
    <view class="h1">今日身体记录</view>
    <view class="body">只记录真实状态，不需要迎合任何“理想答案”。</view>
  </view>

  <view class="section panel">
    <view class="section-title">今天有服用 ROOT 益生元口服液吗？</view>
    <view class="option-grid question-options">
      <view class="option-card {{tookProduct === true ? 'active' : ''}}" data-value="true" bindtap="selectTook">已完成，打卡成功！</view>
      <view class="option-card {{tookProduct === false ? 'active' : ''}}" data-value="false" bindtap="selectTook">还没有，现在就去！</view>
    </view>
  </view>

  <view class="section panel">
    <view class="section-title">昨日，您排便了吗？</view>
    <view class="option-grid question-options">
      <view class="option-card {{hadStool === true ? 'active' : ''}}" data-value="true" bindtap="selectHadStool">有</view>
      <view class="option-card {{hadStool === false ? 'active' : ''}}" data-value="false" bindtap="selectHadStool">没有</view>
    </view>
  </view>

  <view wx:if="{{hadStool}}" class="section panel">
    <view class="section-title">昨日便型</view>
    <view class="stool-grid">
      <view
        wx:for="{{stoolOptions}}"
        wx:key="value"
        class="stool-card {{stoolType === item.value ? 'active' : ''}}"
        data-value="{{item.value}}"
        bindtap="selectStool"
      >
        <image src="{{item.image}}" mode="aspectFit" />
        <text>{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="section panel">
    <view class="section-title">今日感受 / 反馈</view>
    <textarea class="textarea" maxlength="500" value="{{feedback}}" bindinput="onFeedback" placeholder="例如：腹胀减少、睡得更稳、暂时无明显变化" />
    <button class="btn secondary upload-btn" bindtap="chooseImages">添加图片（最多3张）</button>
    <view wx:if="{{imageUrls.length}}" class="image-count">已选择 {{imageUrls.length}} 张</view>
  </view>

  <button class="btn submit-btn" disabled="{{!canSubmit}}" loading="{{loading}}" bindtap="submit">提交今日打卡</button>
</view>
