.compare-page {
  padding-top: 48rpx;
}

.compare-kicker {
  color: var(--color-root-sprout);
  font-size: var(--font-size-xs);
  font-weight: 800;
  letter-spacing: 3rpx;
}

.compare-title {
  margin-top: var(--spacing-md);
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.18;
}

.compare-copy {
  margin-top: var(--spacing-sm);
  color: var(--color-root-copy);
  font-size: var(--font-size-sm);
  line-height: 1.7;
}

.compare-state,
.compare-period,
.result-compare-card,
.dimension-compare-card,
.mismatch-card {
  margin-top: var(--spacing-lg);
}

.state-action {
  margin-top: var(--spacing-lg);
}

.compare-refresh-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--spacing-sm);
  margin-top: var(--spacing-lg);
  padding: var(--spacing-md);
  color: var(--color-danger);
  background: var(--color-danger-tint);
  border: 1rpx solid var(--color-danger-line);
  border-radius: var(--radius-md);
}

.compare-refresh-error__title {
  font-size: var(--font-size-sm);
  font-weight: 750;
}

.compare-refresh-error__copy {
  margin-top: 6rpx;
  font-size: var(--font-size-xs);
  line-height: 1.5;
}

.compare-refresh-error button {
  flex: 0 0 auto;
  min-width: 104rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0 20rpx;
  color: var(--color-danger);
  background: var(--color-root-surface);
  border: 0;
  border-radius: var(--radius-md);
  font-size: var(--font-size-xs);
  line-height: 88rpx;
}

.compare-refresh-error button::after {
  border: 0;
}

.compare-period {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: var(--spacing-sm);
  padding: var(--spacing-lg);
  color: var(--color-root-nav);
  background: var(--color-root-moss);
  border-radius: var(--radius-card);
}

.period-latest {
  text-align: right;
}

.period-label,
.period-version {
  color: var(--color-white-strong);
  font-size: var(--font-size-xs);
}

.period-time {
  margin-top: 8rpx;
  font-size: var(--font-size-sm);
  font-weight: 700;
}

.period-version {
  margin-top: 8rpx;
}

.period-arrow {
  color: var(--color-accent-on-dark);
  font-size: var(--font-size-xl);
}

.result-compare-card {
  padding: var(--spacing-lg);
  background: var(--color-root-surface);
  border: 1rpx solid var(--color-root-line);
  border-radius: var(--radius-card);
}

.result-compare-card__label {
  color: var(--color-root-muted);
  font-size: var(--font-size-xs);
  font-weight: 750;
  letter-spacing: 2rpx;
}

.result-compare-card__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--spacing-sm);
  margin-top: var(--spacing-md);
}

.result-summary {
  min-width: 0;
  padding: var(--spacing-md);
  background: var(--color-ui-grouped);
  border-radius: var(--radius-md);
}

.result-summary--latest {
  background: var(--color-primary-tint);
}

.result-summary__period,
.result-summary__meta {
  color: var(--color-root-muted);
  font-size: var(--font-size-xs);
}

.result-summary__title {
  margin-top: 10rpx;
  color: var(--color-root-ink);
  font-size: var(--font-size-md);
  font-weight: 760;
  line-height: 1.4;
}

.result-summary__meta {
  margin-top: 10rpx;
}

.dimension-compare-card {
  padding: var(--spacing-lg);
  background: var(--color-root-surface);
  border: 1rpx solid var(--color-root-line);
  border-radius: var(--radius-card);
}

.dimension-label {
  color: var(--color-root-copy);
  font-size: var(--font-size-sm);
  font-weight: 700;
  text-align: center;
}

.dimension-values {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: var(--spacing-md);
  margin-top: var(--spacing-lg);
  text-align: center;
}

.dimension-number {
  margin-right: 6rpx;
  color: var(--color-root-ink);
  font-size: 52rpx;
  font-weight: 800;
}

.dimension-delta {
  min-width: 88rpx;
  padding: 10rpx 16rpx;
  color: var(--color-root-moss);
  background: var(--color-primary-tint);
  border-radius: var(--radius-full);
  font-size: var(--font-size-sm);
  font-weight: 750;
}

.compare-notice {
  margin: var(--spacing-lg) var(--spacing-sm);
  color: var(--color-root-muted);
  font-size: var(--font-size-xs);
  line-height: 1.7;
}

.mismatch-label {
  color: var(--color-warning);
  font-size: var(--font-size-xs);
  font-weight: 800;
  letter-spacing: 2rpx;
}

.mismatch-title {
  margin-top: var(--spacing-sm);
  font-size: var(--font-size-lg);
  font-weight: 760;
  line-height: 1.45;
}

.mismatch-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--spacing-sm);
  margin-top: var(--spacing-lg);
}

.mismatch-actions button {
  min-height: 88rpx;
  margin: 0;
  color: var(--color-root-moss);
  background: var(--color-primary-tint);
  border: 0;
  border-radius: var(--radius-md);
  font-size: var(--font-size-sm);
  line-height: 88rpx;
}

.mismatch-actions button::after {
  border: 0;
}

.compare-refreshing {
  padding: var(--spacing-lg) 0 var(--spacing-xl);
  color: var(--color-root-muted);
  font-size: var(--font-size-xs);
  text-align: center;
}
