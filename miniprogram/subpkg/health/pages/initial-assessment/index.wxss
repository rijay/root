page {
  background: #fdfbf6;
}

.assessment-scroll {
  height: 100vh;
  background: #fdfbf6;
}

.assessment-page {
  position: relative;
  width: 100%;
  min-height: 844px;
  padding-bottom: 116px;
  box-sizing: border-box;
}

.assessment-state {
  padding-top: 180px;
  color: #6c6457;
  font-size: 14px;
  font-weight: 400;
  text-align: center;
}

.assessment-progress {
  position: absolute;
  top: 76px;
  right: 34px;
  width: 70px;
  color: #586b3f;
  font-size: 13px;
  font-weight: 500;
  line-height: 20px;
  text-align: right;
}

.assessment-progress__track {
  position: absolute;
  top: 122px;
  left: 20px;
  width: 350px;
  height: 4px;
  overflow: hidden;
  background: #e8e0d0;
  border-radius: 2px;
}

.assessment-progress__track view {
  height: 100%;
  background: #586b3f;
  border-radius: 2px;
  transition: width 0.24s ease;
}

.assessment-eyebrow {
  position: absolute;
  top: 162px;
  left: 20px;
  color: #586b3f;
  font-size: 11px;
  font-weight: 600;
  line-height: 18px;
  letter-spacing: 1px;
}

.assessment-title {
  position: absolute;
  top: 196px;
  left: 20px;
  width: 350px;
  color: #080806;
  font-size: 25px;
  font-weight: 600;
  line-height: 34px;
}

.assessment-hint {
  position: absolute;
  top: 270px;
  left: 20px;
  color: #8a8172;
  font-size: 11px;
  line-height: 18px;
}

.assessment-options {
  position: absolute;
  top: 294px;
  left: 20px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  width: 350px;
}

.assessment-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 350px !important;
  min-height: 52px;
  margin: 0;
  padding: 11px 18px;
  box-sizing: border-box;
  color: #433e34;
  background: #fff;
  border: 1px solid transparent;
  border-radius: 12px;
  font-size: 14px;
  font-weight: 400;
  line-height: 20px;
  text-align: left;
}

.assessment-option::after,
.assessment-next::after {
  border: 0;
}

.assessment-option--selected {
  color: #344126;
  background: #eef1e8;
  border-color: #586b3f;
}

.assessment-option__mark {
  flex: 0 0 16px;
  width: 16px;
  height: 16px;
  margin-left: 16px;
  box-sizing: border-box;
  border: 1px solid #c8c0b2;
  border-radius: 50%;
}

.assessment-option--selected .assessment-option__mark {
  background: #586b3f;
  border: 4px solid #dfe6d5;
}

.assessment-next-dock {
  position: fixed;
  z-index: 5;
  right: 0;
  bottom: 0;
  left: 0;
  height: 120px;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(253, 251, 246, 0), #fdfbf6 34%);
}

.assessment-next {
  position: fixed;
  top: 724px;
  left: 20px;
  height: 56px;
  margin: 0;
  padding: 0;
  color: #fff;
  background: #586b3f;
  border: 0;
  border-radius: 12px;
  font-size: 14px;
  font-weight: 500;
  line-height: 56px;
  pointer-events: auto;
}

@media (max-height: 843px) {
  .assessment-next {
    top: calc(100vh - 120px);
  }
}

.assessment-next[disabled] {
  color: #a39a8b;
  background: transparent;
  border: 1px solid #d8d2c6;
  opacity: 1;
}

@media (max-width: 374px) {
  .assessment-progress__track,
  .assessment-title,
  .assessment-options,
  .assessment-option {
    width: calc(100vw - 40px) !important;
  }

  .assessment-next {
    width: calc(100vw - 40px) !important;
  }
}
