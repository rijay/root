page {
  background: var(--color-brand-white);
}

.assessment-scroll {
  height: 100vh;
  background: var(--color-brand-white);
}

.assessment-page {
  position: relative;
  width: 100%;
  min-height: 844px;
  padding-bottom: 116px;
  box-sizing: border-box;
}

.assessment-state {
  padding-top: 180px;
  color: var(--color-neutral-grey);
  font-size: 14px;
  font-weight: 400;
  text-align: center;
}

.assessment-progress {
  position: absolute;
  top: 76px;
  right: 34px;
  width: 70px;
  color: var(--color-brand-olive);
  font-size: 13px;
  font-weight: 500;
  line-height: 20px;
  text-align: right;
}

.assessment-progress__track {
  position: absolute;
  top: 122px;
  left: 20px;
  width: calc(100% - 40px);
  height: 4px;
  overflow: hidden;
  background: var(--color-ui-line-solid);
  border-radius: 2px;
}

.assessment-progress__track view {
  height: 100%;
  background: var(--color-brand-olive);
  border-radius: 2px;
  transition: width 0.24s ease;
}

.assessment-eyebrow {
  position: absolute;
  top: 162px;
  left: 20px;
  color: var(--color-brand-olive);
  font-size: 11px;
  font-weight: 600;
  line-height: 18px;
  letter-spacing: 1px;
}

.assessment-title {
  position: absolute;
  top: 196px;
  left: 20px;
  width: calc(100% - 40px);
  color: var(--color-brand-black);
  font-size: 25px;
  font-weight: 600;
  line-height: 34px;
}

.assessment-hint {
  position: absolute;
  top: 270px;
  left: 20px;
  color: var(--color-neutral-grey);
  font-size: 11px;
  line-height: 18px;
}

.assessment-options {
  position: absolute;
  top: 294px;
  left: 20px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  width: calc(100% - 40px);
}

.assessment-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100% !important;
  min-height: 52px;
  margin: 0;
  padding: 11px 18px;
  box-sizing: border-box;
  color: var(--color-graphite);
  background: var(--color-brand-white);
  border: 1px solid transparent;
  border-radius: 12px;
  font-size: 14px;
  font-weight: 400;
  line-height: 20px;
  text-align: left;
}

.assessment-option::after,
.assessment-next::after {
  border: 0;
}

.assessment-option--selected {
  color: var(--color-olive-dark);
  background: var(--color-olive-tint);
  border-color: var(--color-brand-olive);
}

.assessment-option__mark {
  flex: 0 0 16px;
  width: 16px;
  height: 16px;
  margin-left: 16px;
  box-sizing: border-box;
  border: 1px solid var(--color-ui-line-solid);
  border-radius: 50%;
}

.assessment-option--selected .assessment-option__mark {
  background: var(--color-brand-olive);
  border: 4px solid var(--color-olive-soft);
}

.assessment-next-dock {
  position: fixed;
  z-index: 5;
  right: 0;
  bottom: 0;
  left: 0;
  height: 120px;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0), var(--color-brand-white) 34%);
}

.assessment-next {
  position: fixed;
  bottom: 64px;
  left: 20px;
  height: 56px;
  margin: 0;
  padding: 0;
  color: var(--color-brand-white);
  background: var(--color-brand-olive);
  border: 0;
  border-radius: 12px;
  font-size: 14px;
  font-weight: 500;
  line-height: 56px;
  pointer-events: auto;
  width: calc(100% - 40px) !important;
}

.assessment-next[disabled] {
  color: var(--color-system-secondary);
  background: transparent;
  border: 1px solid var(--color-ui-line-solid);
  opacity: 1;
}
