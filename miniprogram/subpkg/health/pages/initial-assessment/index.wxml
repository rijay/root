<view class="assessment-page">
  <button class="assessment-nav-back" aria-label="返回上一页" bindtap="goBack"><view></view></button>
  <view wx:if="{{loading}}" class="assessment-state">正在准备评测…</view>
  <block wx:elif="{{currentQuestion}}">
    <view class="assessment-progress">
      <text>ROOT4U · 健康起点评测</text>
      <text>{{currentIndex + 1}} / {{definition.questions.length}}</text>
    </view>
    <view class="assessment-progress__track"><view style="width: {{(currentIndex + 1) * 100 / definition.questions.length}}%"></view></view>
    <text class="assessment-title">{{currentQuestion.title}}</text>
    <text wx:if="{{currentQuestion.type === 'multi'}}" class="assessment-hint">可选择所有符合的情况</text>
    <view class="assessment-options">
      <button
        wx:for="{{currentQuestion.options}}"
        wx:key="value"
        class="assessment-option {{item.selected ? 'assessment-option--selected' : ''}}"
        data-value="{{item.value}}"
        aria-label="{{item.label}}"
        bindtap="selectOption"
      >
        <text>{{item.label}}</text><view class="assessment-option__mark"></view>
      </button>
    </view>
    <view class="assessment-actions">
      <button class="assessment-back" disabled="{{currentIndex === 0 || submitting}}" bindtap="previous">上一步</button>
      <button class="assessment-next" disabled="{{!canContinue || submitting}}" loading="{{submitting}}" bindtap="next">{{currentIndex === definition.questions.length - 1 ? '完成建档' : '下一步'}}</button>
    </view>
    <text class="assessment-disclaimer">{{definition.disclaimer}}</text>
  </block>
</view>
