.result-page {
  min-height: 100vh;
  background: var(--color-root-bg);
}

.result-state {
  padding-top: 96rpx;
}

.state-action {
  margin-top: var(--spacing-lg);
}

.result-hero {
  padding: 80rpx var(--spacing-lg) 72rpx;
  color: var(--color-root-nav);
  background: linear-gradient(148deg, var(--color-brand-olive) 0%, var(--color-olive-mid) 160%);
}

.result-hero--safety {
  background: var(--color-brand-olive);
  box-shadow: inset 0 12rpx 0 var(--color-danger);
}

.result-eyebrow,
.result-time {
  color: var(--color-white-strong);
  font-size: var(--font-size-xs);
}

.result-eyebrow {
  font-weight: 750;
  letter-spacing: 2rpx;
}

.result-title {
  max-width: 650rpx;
  margin-top: 80rpx;
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1.15;
}

.result-summary {
  margin-top: var(--spacing-md);
  color: var(--color-white-soft);
  font-size: var(--font-size-base);
  line-height: 1.75;
}

.result-time {
  margin-top: 48rpx;
}

.result-body {
  padding-top: var(--spacing-lg);
}

.result-card,
.result-section {
  margin-bottom: var(--spacing-md);
  padding: var(--spacing-lg);
  background: var(--color-root-surface);
  border: 1rpx solid var(--color-root-line);
  border-radius: var(--radius-card);
}

.result-card--priority {
  background: var(--color-primary-tint);
  border-color: var(--color-ui-line);
}

.result-card--notice {
  background: var(--color-danger-tint);
  border-color: var(--color-danger-line);
}

.result-card--trial {
  background: linear-gradient(145deg, var(--color-olive-tint) 0%, var(--color-olive-soft) 100%);
  border-color: var(--color-olive-soft);
}

.result-card__trial-title {
  margin-top: 16rpx;
  color: var(--color-root-ink);
  font-size: 34rpx;
  font-weight: 760;
  line-height: 1.35;
}

.result-card--trial button.result-trial-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100% !important;
  max-width: none;
  height: 96rpx;
  min-height: 96rpx;
  margin: 32rpx 0 0 !important;
  padding: 0 32rpx;
  box-sizing: border-box;
  color: var(--color-brand-white);
  background: var(--color-root-moss);
  border: 0;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 720;
  line-height: 1.2;
  white-space: nowrap;
}

.result-card--trial button.result-trial-action::after {
  border: 0;
}

.result-trial-note {
  margin-top: 18rpx;
  color: var(--color-root-muted);
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}

.result-card__label {
  color: var(--color-root-moss);
  font-size: var(--font-size-xs);
  font-weight: 800;
  letter-spacing: 2rpx;
}

.result-card--notice .result-card__label {
  color: var(--color-danger);
}

.result-card__copy {
  margin-top: var(--spacing-sm);
  color: var(--color-root-copy);
  font-size: var(--font-size-base);
  line-height: 1.75;
}

.result-action-list {
  margin-top: var(--spacing-sm);
}

.result-action-item {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 12rpx 0;
}

.result-action-dot {
  flex: 0 0 auto;
  width: 10rpx;
  height: 10rpx;
  margin-top: 18rpx;
  background: var(--color-root-moss);
  border-radius: 50%;
}

.result-action-copy {
  flex: 1;
  color: var(--color-root-copy);
  font-size: var(--font-size-base);
  line-height: 1.75;
}

.result-section__head,
.dimension-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--spacing-md);
}

.result-section__hint {
  color: var(--color-root-muted);
  font-size: var(--font-size-xs);
}

.dimension-list {
  margin-top: var(--spacing-md);
}

.dimension-row {
  min-height: 88rpx;
  border-top: 1rpx solid var(--color-root-line);
  color: var(--color-root-copy);
  font-size: var(--font-size-sm);
}

.dimension-score {
  margin-right: 6rpx;
  color: var(--color-root-ink);
  font-size: var(--font-size-xl);
}

.result-disclaimer {
  margin: var(--spacing-lg) var(--spacing-sm);
  color: var(--color-root-muted);
  font-size: var(--font-size-xs);
  line-height: 1.7;
}

.result-action {
  width: 100%;
  margin-top: var(--spacing-sm);
}

.result-text-action {
  width: 100%;
  min-height: 88rpx;
  margin-top: var(--spacing-sm);
  color: var(--color-root-moss);
  background: transparent;
  border: 0;
  font-size: var(--font-size-sm);
  line-height: 88rpx;
}

.result-delete-action {
  width: 100%;
  min-height: 88rpx;
  margin-top: var(--spacing-md);
  color: var(--color-danger);
  background: transparent;
  border: 0;
  font-size: var(--font-size-sm);
  line-height: 88rpx;
}

.result-text-action::after,
.result-delete-action::after {
  border: 0;
}
