page {
  min-height: 100%;
  background: var(--color-brand-black);
}

.activity-detail {
  min-height: 100vh;
  color: var(--color-brand-white);
  background: var(--color-brand-black);
}

.detail-first-screen {
  position: relative;
  min-height: 844px;
  overflow: hidden;
}

.detail-hero {
  position: absolute;
  z-index: 0;
  top: 0;
  left: 0;
  width: 100%;
  height: 844px;
  overflow: hidden;
}

.detail-hero__image,
.detail-hero__fallback,
.detail-hero__shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.detail-hero__fallback {
  z-index: 0;
  background: radial-gradient(circle at 65% 18%, var(--color-olive-mid) 0%, var(--color-graphite) 30%, var(--color-olive-dark) 62%, var(--color-brand-black) 100%);
}

.detail-hero__image {
  z-index: 1;
}

.detail-hero__shade {
  z-index: 2;
  background: rgba(0, 0, 0, 0.18);
}

.detail-lower-shade {
  position: absolute;
  z-index: 3;
  top: 396px;
  left: 0;
  width: 100%;
  height: 348px;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.92) 28%, var(--color-brand-black) 100%);
}

.detail-hero__wordmark {
  position: absolute;
  z-index: 5;
  top: 132px;
  left: 24px;
  width: 84px;
  height: 22px;
}

.detail-main {
  position: absolute;
  z-index: 4;
  inset: 0;
}

.detail-kicker,
.detail-title,
.detail-summary,
.detail-meta text,
.detail-section text,
.detail-result text,
.detail-action-state text,
.sheet-tag,
.sheet-title,
.sheet-summary text,
.sheet-notice,
.detail-state text {
  display: block;
}

.detail-kicker {
  position: absolute;
  top: 444px;
  left: 24px;
  width: calc(100% - 48px);
  color: var(--color-accent-on-dark);
  font-size: 11px;
  font-weight: 600;
  line-height: 18px;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.detail-title {
  position: absolute;
  top: 478px;
  left: 24px;
  width: calc(100% - 48px);
  height: 35px;
  overflow: hidden;
  font-size: 28px;
  font-weight: 600;
  line-height: 35px;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.detail-summary {
  position: absolute;
  top: 532px;
  left: 24px;
  display: -webkit-box;
  width: calc(100% - 48px);
  max-height: 44px;
  overflow: hidden;
  color: var(--color-ui-grouped);
  font-size: 13px;
  line-height: 22px;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.detail-meta {
  position: absolute;
  top: 602px;
  left: 24px;
  width: calc(100% - 48px);
  height: 112px;
  padding: 18px 16px;
  box-sizing: border-box;
  color: var(--color-brand-black);
  background: var(--color-brand-white);
  border-radius: 12px;
}

.detail-meta__primary {
  font-size: 13px;
  font-weight: 500;
  line-height: 20px;
}

.detail-meta__row {
  margin-top: 10px;
  color: var(--color-graphite);
  font-size: 13px;
  line-height: 20px;
}

.detail-meta__muted {
  margin-top: 10px;
  overflow: hidden;
  color: var(--color-neutral-grey);
  font-size: 12px;
  line-height: 18px;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.detail-sections {
  margin: 0 24px;
  padding: 0 16px;
  background: var(--color-brand-black);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 12px;
}

.detail-section {
  padding: 20px 0;
}

.detail-section + .detail-section {
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.detail-section__label {
  color: var(--color-accent-on-dark);
  font-size: 11px;
  font-weight: 600;
  line-height: 18px;
  letter-spacing: 1px;
}

.detail-section__copy {
  margin-top: 8px;
  color: rgba(255, 255, 255, 0.78);
  font-size: 12px;
  line-height: 21px;
}

.detail-section__copy--preline {
  white-space: pre-line;
}

.detail-result {
  margin: 20px 24px 160px;
  padding: 20px 16px;
  color: var(--color-brand-black);
  background: var(--color-brand-white);
  border-radius: 12px;
}

.detail-scroll-spacer {
  height: 120px;
}

.detail-result__tag {
  color: var(--color-brand-olive);
  font-size: 11px;
  font-weight: 600;
}

.detail-result__title {
  margin-top: 8px;
  font-size: 16px;
  font-weight: 600;
}

.detail-result__copy {
  margin-top: 8px;
  color: var(--color-neutral-grey);
  font-size: 12px;
  line-height: 20px;
}

.detail-result__button,
.detail-result__dismiss,
.detail-state__action,
.detail-state__quiet {
  width: 100%;
  margin-top: 12px;
  border: 0;
  font-size: 12px;
}

.detail-result__button {
  color: var(--color-brand-white);
  background: var(--color-brand-olive);
}

.detail-result__button--quiet,
.detail-result__dismiss {
  color: var(--color-brand-olive);
  background: transparent;
}

.detail-result__button::after,
.detail-result__dismiss::after,
.detail-action-button::after,
.sheet-primary::after,
.sheet-secondary::after,
.detail-state__action::after,
.detail-state__quiet::after {
  border: 0;
}

.detail-action-bar {
  position: fixed;
  z-index: 60;
  right: 0;
  bottom: 0;
  left: 0;
  display: grid;
  grid-template-columns: 132px 198px;
  gap: 20px;
  width: 100%;
  height: 100px;
  padding: 14px 20px 32px;
  box-sizing: border-box;
  background: var(--color-brand-white);
}

.detail-action-bar--status-only {
  grid-template-columns: minmax(0, 1fr);
}

.detail-action-state {
  min-width: 0;
  padding-top: 4px;
}

.detail-action-state__label {
  overflow: hidden;
  color: var(--color-brand-olive);
  font-size: 12px;
  font-weight: 500;
  line-height: 20px;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.detail-action-state__hint {
  margin-top: 4px;
  color: var(--color-neutral-grey);
  font-size: 10px;
  line-height: 16px;
}

.detail-action-button {
  width: 198px;
  height: 54px;
  margin: 0;
  padding: 0 10px;
  color: var(--color-brand-white);
  background: var(--color-brand-olive);
  border: 0;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 600;
  line-height: 54px;
}

.detail-action-button[disabled] {
  color: var(--color-neutral-grey);
  background: var(--color-ui-line-solid);
  opacity: 1;
}

.detail-state {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  flex-direction: column;
  min-height: 100vh;
  padding: 100px 24px 80px;
  box-sizing: border-box;
  color: rgba(255, 255, 255, 0.7);
  font-size: 13px;
  line-height: 21px;
}

.detail-state__visual {
  width: 100%;
  height: 270px;
  margin-bottom: 21px;
  background: var(--color-graphite);
  border-radius: 14px;
}

.detail-state__line {
  width: 55%;
  height: 12px;
  margin-bottom: 10px;
  background: var(--color-graphite);
  border-radius: 9px;
}

.detail-state__line--wide {
  width: 82%;
  height: 23px;
}

.detail-state__tag {
  color: var(--color-accent-on-dark);
  font-size: 11px;
}

.detail-state__title {
  margin: 9px 0;
  color: var(--color-brand-white);
  font-size: 20px;
  font-weight: 600;
}

.detail-state__action {
  color: var(--color-brand-white);
  background: var(--color-brand-olive);
}

.detail-state__quiet {
  color: var(--color-accent-on-dark);
  background: transparent;
}

.sheet-mask {
  position: fixed;
  z-index: 90;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.72);
}

.confirmation-sheet {
  position: relative;
  width: 100%;
  height: 500px;
  padding: 0;
  box-sizing: border-box;
  color: var(--color-brand-black);
  background: var(--color-brand-white);
  border-radius: 20px 20px 0 0;
}

.sheet-handle {
  position: absolute;
  top: 12px;
  left: 50%;
  width: 52px;
  height: 4px;
  margin: 0;
  background: var(--color-ui-line-solid);
  border-radius: 2px;
  transform: translateX(-50%);
}

.sheet-tag {
  position: absolute;
  top: 46px;
  left: 24px;
  width: calc(100% - 48px);
  color: var(--color-brand-olive);
  font-size: 12px;
  font-weight: 500;
  line-height: 18px;
}

.sheet-title {
  position: absolute;
  top: 82px;
  left: 24px;
  width: calc(100% - 48px);
  overflow: hidden;
  color: var(--color-brand-black);
  font-size: 21px;
  font-weight: 600;
  line-height: 32px;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sheet-summary {
  position: absolute;
  top: 138px;
  left: 24px;
  width: calc(100% - 48px);
  height: 140px;
  padding: 18px 16px;
  box-sizing: border-box;
  color: var(--color-graphite);
  background: var(--color-brand-white);
  border-radius: 12px;
  font-size: 13px;
  line-height: 26px;
}

.sheet-notice {
  position: absolute;
  top: 302px;
  left: 24px;
  display: -webkit-box;
  width: calc(100% - 48px);
  max-height: 42px;
  overflow: hidden;
  color: var(--color-neutral-grey);
  font-size: 12px;
  line-height: 21px;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.sheet-primary,
.sheet-secondary {
  position: absolute;
  left: 20px;
  width: calc(100% - 40px) !important;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 12px;
  font-weight: 600;
  text-align: center;
}

.sheet-primary {
  top: 370px;
  height: 54px;
  color: var(--color-brand-white);
  background: var(--color-brand-olive);
  font-size: 16px;
  line-height: 54px;
}

.sheet-secondary {
  top: 442px;
  height: 22px;
  color: var(--color-neutral-grey);
  background: transparent;
  font-size: 14px;
  font-weight: 400;
  line-height: 22px;
}

@media (max-width: 375px) {
  .detail-action-bar {
    grid-template-columns: minmax(0, 1fr) 198px;
  }

  .detail-action-bar--status-only {
    grid-template-columns: minmax(0, 1fr);
  }

}
