.activity-detail-page {
  padding-top: var(--spacing-md);
}

.detail-visual,
.loading-visual {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  min-height: 430rpx;
  padding: var(--spacing-lg);
  box-sizing: border-box;
  color: var(--color-root-nav);
  background: linear-gradient(148deg, #1b2019, #667552 68%, #9aa77b);
  border-radius: var(--radius-card);
}

.detail-visual__image,
.detail-visual__shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.detail-visual__shade {
  background: linear-gradient(180deg, rgba(15, 17, 13, 0.08), rgba(15, 17, 13, 0.72));
}

.detail-visual__copy {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  width: 100%;
}

.detail-type {
  max-width: 460rpx;
  font-size: var(--font-size-xl);
  font-weight: 800;
  letter-spacing: 2rpx;
}

.detail-city {
  font-size: var(--font-size-xs);
}

.detail-heading {
  padding: var(--spacing-xl) var(--spacing-xs) var(--spacing-md);
}

.detail-status,
.state-label {
  color: var(--color-root-moss);
  font-size: var(--font-size-xs);
  font-weight: 750;
  letter-spacing: 1rpx;
}

.detail-status--closed {
  color: var(--color-root-clay);
}

.detail-title {
  margin-top: var(--spacing-sm);
  font-size: var(--font-size-xl);
  font-weight: 800;
  line-height: 1.28;
}

.detail-summary {
  margin-top: var(--spacing-md);
  color: var(--color-root-copy);
  font-size: var(--font-size-base);
  line-height: 1.72;
}

.detail-facts,
.detail-content-card,
.enrollment-state,
.notice-card,
.result-card,
.action-gate,
.error-card {
  margin-top: var(--spacing-lg);
}

.detail-content-section + .detail-content-section {
  margin-top: var(--spacing-lg);
  padding-top: var(--spacing-lg);
  border-top: 1rpx solid var(--color-root-line);
}

.detail-content-copy {
  margin-top: var(--spacing-sm);
  color: var(--color-root-copy);
  font-size: var(--font-size-sm);
  line-height: 1.72;
}

.detail-content-copy--preline {
  white-space: pre-line;
}

.notice-label {
  font-weight: 700;
}

.root-cell__value {
  max-width: 420rpx;
}

.state-title,
.state-copy {
  margin-top: var(--spacing-sm);
}

.state-action {
  width: 100%;
  margin-top: var(--spacing-lg);
  padding: 0;
}

.text-action {
  width: 100%;
  margin-top: var(--spacing-sm);
  padding: var(--spacing-sm);
  color: var(--color-root-moss);
  background: transparent;
  border: 0;
  font-size: var(--font-size-sm);
  line-height: 1.5;
}

.text-action::after {
  border: 0;
}

.loading-line {
  width: 54%;
  height: 28rpx;
  margin-top: var(--spacing-md);
  background: var(--color-root-line);
  border-radius: var(--radius-full);
}

.loading-line--wide {
  width: 82%;
  height: 44rpx;
}

.loading-copy {
  margin-top: var(--spacing-md);
}

.notice-row,
.sheet-fact {
  margin-top: var(--spacing-sm);
  color: var(--color-root-copy);
  font-size: var(--font-size-sm);
  line-height: 1.6;
}

.sheet-warning {
  margin-top: var(--spacing-md);
  padding: var(--spacing-md);
  color: var(--color-root-clay);
  background: rgba(146, 96, 66, 0.1);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-sm);
  line-height: 1.6;
}

.sheet-mask {
  position: fixed;
  z-index: 80;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(18, 20, 16, 0.52);
}

.confirmation-sheet {
  width: 100%;
  padding: 24rpx var(--spacing-lg) calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--color-root-nav);
  border-radius: 36rpx 36rpx 0 0;
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto var(--spacing-lg);
  background: var(--color-root-line);
  border-radius: var(--radius-full);
}

.sheet-title,
.sheet-copy {
  margin-top: var(--spacing-sm);
}

.sheet-primary {
  width: 100%;
  margin-top: var(--spacing-lg);
}

.sheet-secondary {
  width: 100%;
  margin-top: var(--spacing-sm);
}
