page,
.privacy-account-page {
  min-height: 100vh;
  background: var(--color-brand-white);
}

.privacy-account-page {
  position: relative;
  height: 844px;
  overflow: hidden;
}

.privacy-account-page__title {
  position: absolute;
  top: 130px;
  left: 20px;
  width: calc(100% - 40px);
  height: 38px;
  color: var(--color-brand-black);
  font-size: 30px;
  font-weight: 600;
  line-height: 38px;
}

.privacy-account-page__introduction {
  position: absolute;
  top: 180px;
  left: 20px;
  width: calc(100% - 40px);
  height: 44px;
  color: var(--color-graphite);
  font-size: 14px;
  line-height: 22px;
  white-space: pre-line;
}

.privacy-account-page__section-tag {
  position: absolute;
  left: 20px;
  width: calc(100% - 40px);
  height: 18px;
  color: var(--color-brand-olive);
  font-size: 12px;
  font-weight: 500;
  line-height: 18px;
}

.privacy-account-page__section-tag--privacy {
  top: 260px;
}

.privacy-account-page__section-tag--account {
  top: 502px;
}

.privacy-account-page__menu {
  position: absolute;
  left: 20px;
  width: calc(100% - 40px);
  overflow: hidden;
  box-sizing: border-box;
  padding: 0 16px;
  background: var(--color-brand-white);
  border-radius: 14px;
}

.privacy-account-page__menu--privacy {
  top: 292px;
  height: 172px;
}

.privacy-account-page__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 57.33px;
  color: var(--color-graphite);
  border-bottom: 1px solid var(--color-ui-line-solid);
  box-sizing: border-box;
  font-size: 14px;
}

.privacy-account-page__row:last-child {
  border-bottom: 0;
}

.privacy-account-page__arrow {
  flex: 0 0 4px;
  width: 4px;
  height: 8px;
  margin-right: 1px;
  border-top: 1px solid var(--color-neutral-grey);
  border-right: 1px solid var(--color-neutral-grey);
  transform: rotate(45deg);
}

.privacy-account-page__account {
  position: absolute;
  top: 534px;
  left: 20px;
  width: calc(100% - 40px);
  height: 94px;
  box-sizing: border-box;
  padding: 18px 16px;
  background: var(--color-brand-white);
  border-radius: 14px;
}

.privacy-account-page__account-title,
.privacy-account-page__account-hint {
  display: block;
}

.privacy-account-page__account-title {
  color: var(--color-danger);
  font-size: 14px;
  font-weight: 500;
  line-height: 22px;
}

.privacy-account-page__account-hint {
  margin-top: 10px;
  color: var(--color-neutral-grey);
  font-size: 11px;
  line-height: 18px;
}

.privacy-account-page__account > .privacy-account-page__arrow {
  position: absolute;
  top: 23px;
  right: 17px;
}

.privacy-account-page__support {
  position: absolute;
  top: 664px;
  left: 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: calc(100% - 40px);
  height: 76px;
  box-sizing: border-box;
  padding: 0 20px;
  color: var(--color-brand-olive);
  background: var(--color-olive-tint);
  border-radius: 14px;
  font-size: 13px;
  font-weight: 500;
  line-height: 20px;
  white-space: pre-line;
}

.privacy-account-page__version {
  position: absolute;
  top: 790px;
  left: 20px;
  width: calc(100% - 40px);
  height: 18px;
  color: var(--color-neutral-grey);
  font-size: 11px;
  line-height: 18px;
  text-align: center;
}

.cancellation-overlay {
  position: fixed;
  z-index: 50;
  inset: 0;
  background: rgba(0, 0, 0, .92);
}

.cancellation-sheet {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 596px;
  overflow: hidden;
  background: var(--color-brand-white);
  border-radius: 20px 20px 0 0;
}

.cancellation-sheet__handle {
  position: absolute;
  top: 12px;
  left: 50%;
  width: 52px;
  height: 4px;
  background: var(--color-ui-line-solid);
  border-radius: 2px;
  transform: translateX(-50%);
}

.cancellation-sheet__tag,
.cancellation-sheet__title,
.cancellation-sheet__introduction,
.cancellation-sheet__support {
  position: absolute;
}

.cancellation-sheet__tag {
  top: 44px;
  left: 24px;
  width: calc(100% - 48px);
  height: 18px;
  color: var(--color-danger);
  font-size: 12px;
  font-weight: 500;
  line-height: 18px;
}

.cancellation-sheet__title {
  top: 78px;
  left: 24px;
  width: calc(100% - 48px);
  height: 32px;
  color: var(--color-brand-black);
  font-size: 22px;
  font-weight: 600;
  line-height: 32px;
}

.cancellation-sheet__introduction {
  top: 122px;
  left: 24px;
  width: calc(100% - 48px);
  height: 40px;
  color: var(--color-graphite);
  font-size: 13px;
  line-height: 20px;
  white-space: pre-line;
}

.cancellation-sheet__consequences {
  position: absolute;
  top: 180px;
  left: 24px;
  width: calc(100% - 48px);
  height: 178px;
  box-sizing: border-box;
  padding: 18px 16px;
  color: var(--color-graphite);
  background: var(--color-brand-white);
  border-radius: 12px;
  font-size: 13px;
  line-height: 34px;
  white-space: pre-line;
}

.cancellation-sheet__confirmation {
  position: absolute;
  top: 380px;
  left: 24px;
  display: flex;
  width: calc(100% - 48px);
  height: 38px;
  color: var(--color-graphite);
  font-size: 12px;
  line-height: 18px;
  white-space: pre-line;
}

.cancellation-sheet__checkbox {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 20px;
  width: 20px;
  height: 20px;
  margin-right: 10px;
  box-sizing: border-box;
  color: var(--color-brand-white);
  background: var(--color-brand-white);
  border: 1px solid var(--color-danger);
  border-radius: 4px;
  font-size: 13px;
  line-height: 20px;
}

.cancellation-sheet__checkbox.is-checked {
  background: var(--color-danger);
}

.cancellation-sheet__keep,
.cancellation-sheet__submit {
  position: absolute;
  left: 20px;
  margin: 0 !important;
  padding: 0;
  box-sizing: border-box;
  border-radius: 12px;
  width: calc(100% - 40px) !important;
}

.cancellation-sheet__keep::after,
.cancellation-sheet__submit::after {
  border: 0;
}

.cancellation-sheet__keep {
  top: 442px;
  height: 50px;
  min-height: 50px;
  color: var(--color-brand-white);
  background: var(--color-brand-olive);
  font-size: 16px;
  font-weight: 600;
  line-height: 50px;
}

.cancellation-sheet__submit {
  top: 502px;
  height: 46px;
  min-height: 46px;
  color: var(--color-danger);
  background: var(--color-brand-white);
  border: 1px solid var(--color-danger);
  font-size: 14px;
  font-weight: 500;
  line-height: 44px;
}

.cancellation-sheet__support {
  top: 564px;
  left: 20px;
  width: calc(100% - 40px);
  height: 18px;
  color: var(--color-neutral-grey);
  font-size: 11px;
  line-height: 18px;
  text-align: center;
}
