<view class="root-page profile-subpage">
  <view class="orders-hero {{heroClass}}">
    <view class="eyebrow">订单记录</view>
    <view class="orders-title">{{heroTitle}}</view>
    <view class="orders-copy">{{heroCopy}}</view>
    <view class="orders-actions">
      <button class="root-button" loading="{{loading && primaryAction === '刷新状态'}}" bindtap="handlePrimaryAction">{{primaryAction}}</button>
      <button class="root-button root-button--secondary" loading="{{loading && secondaryAction === '刷新状态'}}" bindtap="handleSecondaryAction">{{secondaryAction}}</button>
    </view>
  </view>

  <view wx:if="{{loading}}" class="root-card state-card">
    <view class="root-helper-text">正在加载订单同步状态...</view>
  </view>

  <view wx:elif="{{errorText}}" class="root-card state-card">
    <view class="root-section-title">订单状态暂未加载</view>
    <view class="root-helper-text">{{errorText}}</view>
    <button class="root-button state-btn" bindtap="load">重新加载</button>
  </view>

  <view wx:else>
    <view class="root-card sync-card">
      <view class="root-section-title">同步说明</view>
      <view class="sync-step">
        <view class="step-num">1</view>
        <view>
          <view class="step-title">Root 会员中心购买</view>
          <view class="step-copy">商品购买在 Root 会员中心完成，myRoot 只展示订单和活动相关状态。</view>
        </view>
      </view>
      <view class="sync-step">
        <view class="step-num">2</view>
        <view>
          <view class="step-title">订单自动补链</view>
          <view class="step-copy">系统会优先通过 UnionID、有赞客户、手机号等证据同步订单，不要求先绑定订单才能参与任务。</view>
        </view>
      </view>
      <view class="sync-step">
        <view class="step-num">3</view>
        <view>
          <view class="step-title">异常人工确认</view>
          <view class="step-copy">如果物流或订单状态不一致，可联系顾问协助核对。</view>
        </view>
      </view>
    </view>

    <view class="root-card order-list-card">
      <view class="order-list-head">
        <view>
          <view class="root-section-title">订单明细</view>
          <view class="list-copy">展示已同步到 myRoot 的 Root 会员中心订单。</view>
        </view>
        <view class="count-pill">{{orders.length}} 单</view>
      </view>

      <view wx:if="{{orders.length}}" class="order-list">
        <view wx:for="{{orders}}" wx:key="orderId" class="order-card {{item.statusClass}}">
          <view class="order-card-head">
            <view>
              <view class="order-no">{{item.youzanOrderNo || '订单待同步'}}</view>
              <view class="order-product">{{item.productName || 'Root 会员中心商品'}}</view>
            </view>
            <view class="order-status {{item.statusClass}}">{{item.statusLabel}}</view>
          </view>
          <view class="order-status-title">{{item.statusTitle}}</view>
          <view class="order-status-copy">{{item.statusCopy}}</view>
          <view class="order-meta-grid">
            <view class="meta-item">
              <text>实付金额</text>
              <text>{{item.amount || 0}} 元</text>
            </view>
            <view class="meta-item">
              <text>匹配方式</text>
              <text>{{item.matchSourceLabel}}</text>
            </view>
            <view wx:if="{{item.receiverName}}" class="meta-item">
              <text>收货人</text>
              <text>{{item.receiverName}}</text>
            </view>
            <view wx:if="{{item.receiverPhone}}" class="meta-item">
              <text>收货手机</text>
              <text>{{item.receiverPhone}}</text>
            </view>
          </view>
          <view wx:if="{{item.hasLogistics}}" class="order-logistics">
            <view wx:if="{{item.fulfillment.carrier}}" class="logistics-row">
              <text>物流公司</text><text>{{item.fulfillment.carrier}}</text>
            </view>
            <view wx:if="{{item.fulfillment.trackingNo}}" class="logistics-row">
              <text>运单号</text><text>{{item.fulfillment.trackingNo}}</text>
            </view>
            <view wx:if="{{item.fulfillment.lastEventText}}" class="logistics-row">
              <text>最新节点</text><text>{{item.fulfillment.lastEventText}}</text>
            </view>
            <view wx:if="{{item.shippedAtText}}" class="logistics-row">
              <text>发货时间</text><text>{{item.shippedAtText}}</text>
            </view>
            <view wx:if="{{item.deliveredAtText}}" class="logistics-row">
              <text>送达时间</text><text>{{item.deliveredAtText}}</text>
            </view>
          </view>
        </view>
      </view>

      <view wx:else class="empty-state">
        <view class="empty-title">暂未同步到订单</view>
        <view class="root-helper-text">你仍可先完成打卡、问卷和咨询。购买后如果长时间未出现，可联系顾问协助核对。</view>
        <button class="root-button empty-btn" bindtap="handlePrimaryAction">查看商品</button>
      </view>
    </view>
  </view>
</view>
