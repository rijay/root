<view class="root-page profile-subpage">
  <view class="root-card">
    <view class="eyebrow">订单记录</view>
    <view class="h1">我的订单</view>
    <view class="root-helper-text">用于确认试饮资格、物流送达与后续免单处理。若状态不一致，可联系 ROOT 顾问协助核对。</view>
  </view>
  <view class="section root-card profile-list">
    <view wx:if="{{orders.length}}">
      <view wx:for="{{orders}}" wx:key="orderId" class="profile-row order-row">
        <view class="order-row-head">
          <view class="root-section-title">{{item.youzanOrderNo || '订单待同步'}}</view>
          <view class="order-status">{{item.deliveryStatusLabel || item.deliveryStatus || '待确认'}}</view>
        </view>
        <view class="body">金额 {{item.amount || 0}} 元</view>
        <view class="body">匹配方式：{{item.matchSource || item.match_source || '未匹配'}}</view>
        <view wx:if="{{item.fulfillment && (item.fulfillment.carrier || item.fulfillment.trackingNo)}}" class="order-logistics">
          <view wx:if="{{item.fulfillment.carrier}}" class="body">物流公司：{{item.fulfillment.carrier}}</view>
          <view wx:if="{{item.fulfillment.trackingNo}}" class="body">运单号：{{item.fulfillment.trackingNo}}</view>
          <view wx:if="{{item.fulfillment.lastEventText}}" class="body">最新节点：{{item.fulfillment.lastEventText}}</view>
        </view>
      </view>
    </view>
    <view wx:else class="empty-state">
      <view class="empty-title">暂未匹配到订单</view>
      <view class="root-helper-text">如果你已经下单，稍后再刷新；仍未出现时可进入人工协助。</view>
    </view>
  </view>
</view>
