.profile-subpage {
  padding-top: 40rpx;
}

.orders-hero {
  padding: 40rpx 36rpx;
  color: var(--color-root-surface);
  background: var(--color-root-ink);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-md);
}

.orders-hero.pending {
  background: var(--color-root-clay);
}

.orders-hero.done {
  background: var(--color-root-moss);
}

.orders-hero.danger {
  background: var(--color-danger);
}

.orders-hero.idle {
  color: var(--color-root-ink);
  background: var(--color-root-nav);
  border: 1rpx solid var(--color-root-line);
}

.orders-hero .eyebrow {
  color: currentColor;
  opacity: 0.72;
}

.orders-title {
  margin-top: 16rpx;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.18;
}

.orders-copy {
  margin-top: 18rpx;
  font-size: var(--font-size-base);
  line-height: 1.7;
  opacity: 0.78;
}

.orders-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 32rpx;
}

.orders-hero .root-button {
  color: var(--color-root-ink);
  background: var(--color-root-surface);
}

.orders-hero .root-button--secondary {
  color: currentColor;
  background: rgba(255, 255, 255, 0.12);
  border-color: rgba(255, 255, 255, 0.34);
}

.orders-hero.idle .root-button {
  color: var(--color-root-surface);
  background: var(--color-root-ink);
}

.orders-hero.idle .root-button--secondary {
  color: var(--color-root-moss);
  background: var(--color-root-surface);
  border-color: var(--color-root-line);
}

.state-card,
.sync-card,
.order-list-card {
  margin-top: 24rpx;
}

.state-btn,
.empty-btn {
  margin-top: 24rpx;
}

.sync-step {
  display: flex;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--color-root-line);
}

.sync-step:last-child {
  border-bottom: 0;
}

.step-num {
  display: flex;
  flex: 0 0 40rpx;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  color: var(--color-root-surface);
  background: var(--color-root-moss);
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  font-weight: 800;
  line-height: 40rpx;
}

.step-title,
.order-no,
.order-status-title {
  color: var(--color-root-ink);
  font-size: var(--font-size-base);
  font-weight: 800;
  line-height: 1.35;
}

.step-copy,
.list-copy,
.order-product,
.order-status-copy {
  margin-top: 8rpx;
  color: var(--color-root-copy);
  font-size: var(--font-size-sm);
  line-height: 1.55;
}

.order-list-head,
.order-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.count-pill {
  flex: 0 0 auto;
  min-width: 88rpx;
  padding: 8rpx 16rpx;
  box-sizing: border-box;
  color: var(--color-root-moss);
  background: var(--color-primary-tint);
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  font-weight: 800;
  line-height: 1.3;
  text-align: center;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
}

.order-card {
  padding: 24rpx;
  background: var(--color-root-nav);
  border: 1rpx solid var(--color-root-line);
  border-radius: var(--radius-control);
}

.order-card.done {
  background: var(--color-primary-tint);
  border-color: var(--color-root-sprout);
}

.order-card.danger {
  background: #FFF2EA;
  border-color: #F0B49A;
}

.order-status {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  color: var(--color-root-moss);
  background: var(--color-primary-tint);
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  font-weight: 800;
  line-height: 1.3;
  text-align: center;
}

.order-status.pending {
  color: var(--color-root-clay);
  background: #FFF2EA;
}

.order-status.danger {
  color: var(--color-danger);
  background: #FFE9E2;
}

.order-status.muted {
  color: var(--color-root-muted);
  background: var(--color-root-line);
}

.order-status-title {
  margin-top: 18rpx;
}

.order-meta-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 20rpx;
}

.meta-item {
  padding: 16rpx;
  background: var(--color-root-surface);
  border: 1rpx solid var(--color-root-line);
  border-radius: var(--radius-md);
}

.meta-item text {
  display: block;
  color: var(--color-root-muted);
  font-size: var(--font-size-xs);
  line-height: 1.45;
}

.meta-item text:last-child {
  margin-top: 6rpx;
  color: var(--color-root-ink);
  font-size: var(--font-size-sm);
  font-weight: 800;
}

.order-logistics {
  display: grid;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  background: var(--color-root-surface);
  border: 1rpx solid var(--color-root-line);
  border-radius: var(--radius-md);
}

.logistics-row {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  color: var(--color-root-copy);
  font-size: var(--font-size-sm);
  line-height: 1.5;
}

.logistics-row text:first-child {
  flex: 0 0 132rpx;
  color: var(--color-root-muted);
}

.logistics-row text:last-child {
  text-align: right;
}

.empty-state {
  padding: var(--spacing-xl) var(--spacing-md);
  text-align: center;
}

.empty-title {
  color: var(--color-root-ink);
  font-size: var(--font-size-lg);
  font-weight: 800;
}

@media (max-width: 360px) {
  .orders-actions {
    display: flex;
    flex-direction: column;
  }

  .order-meta-grid {
    grid-template-columns: 1fr;
  }
}
