.review-page {
  padding-top: 40rpx;
}

.review-hero {
  padding: 40rpx 36rpx;
  color: var(--color-root-surface);
  background: var(--color-root-ink);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-md);
}

.review-hero.pending {
  background: var(--color-root-clay);
}

.review-hero.done {
  background: var(--color-root-moss);
}

.review-hero.idle {
  color: var(--color-root-ink);
  background: var(--color-root-nav);
  border: 1rpx solid var(--color-root-line);
}

.review-hero .eyebrow {
  color: currentColor;
  opacity: 0.72;
}

.review-title {
  margin-top: 16rpx;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.18;
}

.review-copy {
  margin-top: 18rpx;
  font-size: var(--font-size-base);
  line-height: 1.7;
  opacity: 0.78;
}

.review-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 32rpx;
}

.review-hero .root-button {
  color: var(--color-root-ink);
  background: var(--color-root-surface);
}

.review-hero .root-button--secondary {
  color: currentColor;
  background: rgba(255, 255, 255, 0.12);
  border-color: rgba(255, 255, 255, 0.34);
}

.review-hero.idle .root-button {
  color: var(--color-root-surface);
  background: var(--color-root-ink);
}

.review-hero.idle .root-button--secondary {
  color: var(--color-root-moss);
  background: var(--color-root-surface);
  border-color: var(--color-root-line);
}

.state-card,
.review-section,
.settlement-card,
.reward-card {
  margin-top: 24rpx;
}

.state-btn {
  margin-top: 24rpx;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.section-copy {
  margin-top: 8rpx;
  color: var(--color-root-copy);
  font-size: var(--font-size-sm);
  line-height: 1.55;
}

.count-pill,
.status-pill,
.settlement-badge {
  flex: 0 0 auto;
  min-width: 104rpx;
  padding: 8rpx 16rpx;
  box-sizing: border-box;
  color: var(--color-root-moss);
  background: var(--color-primary-tint);
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  font-weight: 800;
  line-height: 1.3;
  text-align: center;
}

.status-pill.pending {
  color: var(--color-root-clay);
  background: #FFF2EA;
}

.status-pill.done,
.settlement-badge {
  color: var(--color-root-moss);
  background: var(--color-primary-tint);
}

.review-item,
.reward-row {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-root-line);
}

.review-item:last-child,
.reward-row:last-child {
  border-bottom: 0;
}

.review-item-top,
.settlement-row,
.reward-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 24rpx;
}

.review-type,
.settlement-status,
.reward-title {
  color: var(--color-root-ink);
  font-size: var(--font-size-base);
  font-weight: 800;
  line-height: 1.35;
}

.review-reason,
.settlement-meta,
.reward-copy,
.empty-note {
  margin-top: 8rpx;
  color: var(--color-root-copy);
  font-size: var(--font-size-sm);
  line-height: 1.55;
}

.review-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 20rpx;
  margin-top: 14rpx;
  color: var(--color-root-muted);
  font-size: var(--font-size-xs);
  line-height: 1.5;
}

.review-note {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  color: var(--color-root-clay);
  background: #FFF2EA;
  border: 1rpx solid rgba(143, 86, 50, 0.18);
  border-radius: var(--radius-control);
  font-size: var(--font-size-sm);
  line-height: 1.55;
}

.review-note.done {
  color: var(--color-root-moss);
  background: var(--color-primary-tint);
  border-color: var(--color-root-sprout);
}

.review-explanation {
  margin-top: 16rpx;
  padding: 18rpx;
  background: var(--color-root-nav);
  border: 1rpx solid var(--color-root-line);
  border-radius: var(--radius-control);
}

.review-explanation.done {
  background: var(--color-primary-tint);
  border-color: var(--color-root-sprout);
}

.review-explanation-title {
  color: var(--color-root-ink);
  font-size: var(--font-size-sm);
  font-weight: 800;
  line-height: 1.45;
}

.review-explanation-copy {
  margin-top: 8rpx;
  color: var(--color-root-copy);
  font-size: var(--font-size-sm);
  line-height: 1.55;
}

.review-evidence {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.review-evidence > text {
  padding: 6rpx 12rpx;
  color: var(--color-root-moss);
  background: var(--color-root-surface);
  border: 1rpx solid var(--color-root-line);
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  font-weight: 700;
  line-height: 1.35;
}

.reward-row {
  align-items: flex-start;
}

.reward-row > text {
  flex: 0 0 128rpx;
  color: var(--color-root-moss);
  font-size: var(--font-size-sm);
  font-weight: 800;
  line-height: 1.45;
  text-align: right;
}

@media (max-width: 360px) {
  .review-actions {
    display: flex;
    flex-direction: column;
  }

  .status-pill,
  .settlement-badge,
  .reward-row > text {
    align-self: flex-start;
    text-align: left;
  }
}
