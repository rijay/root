.profile-subpage {
  padding-top: 44rpx;
}

.support-card .h1 {
  margin-top: var(--spacing-sm);
}

.support-card .root-helper-text {
  margin-top: var(--spacing-md);
  font-size: var(--font-size-sm);
}

.support-list {
  margin-top: var(--spacing-lg);
  padding: var(--spacing-sm) var(--spacing-md);
  background: var(--color-root-nav);
  border: 1rpx solid var(--color-root-line);
  border-radius: var(--radius-control);
}

.support-row {
  padding: var(--spacing-md) 0;
  color: var(--color-root-copy);
  border-bottom: 1rpx solid var(--color-root-line);
  font-size: var(--font-size-sm);
  line-height: 1.45;
}

.support-row:last-child {
  border-bottom: 0;
}

.contact-btn {
  width: 100%;
  margin-top: var(--spacing-xl);
}
