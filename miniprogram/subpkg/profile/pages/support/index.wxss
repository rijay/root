.profile-subpage {
  padding-top: 40rpx;
}

.support-hero {
  padding: 40rpx 0 28rpx;
}

.support-title {
  margin-top: 16rpx;
  color: var(--color-root-ink);
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.18;
}

.support-copy {
  margin-top: 16rpx;
  color: var(--color-root-copy);
  font-size: var(--font-size-base);
  line-height: 1.7;
}

.topic-card,
.contact-card,
.follow-card,
.quick-card {
  margin-top: 24rpx;
}

.topic-list {
  margin-top: 8rpx;
}

.topic-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-root-line);
}

.topic-row:last-child {
  border-bottom: 0;
}

.topic-row.active {
  padding-right: 16rpx;
  padding-left: 16rpx;
  background: var(--color-primary-tint);
  border: 1rpx solid var(--color-root-sprout);
  border-radius: var(--radius-control);
}

.topic-title {
  color: var(--color-root-ink);
  font-size: var(--font-size-base);
  font-weight: 800;
  line-height: 1.35;
}

.topic-copy {
  margin-top: 8rpx;
  color: var(--color-root-copy);
  font-size: var(--font-size-sm);
  line-height: 1.55;
}

.topic-check {
  flex: 0 0 88rpx;
  color: var(--color-root-moss);
  font-size: var(--font-size-sm);
  font-weight: 800;
  line-height: 1.5;
  text-align: right;
}

.contact-status {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  color: var(--color-root-copy);
  background: var(--color-root-nav);
  border: 1rpx solid var(--color-root-line);
  border-radius: var(--radius-control);
  font-size: var(--font-size-sm);
  line-height: 1.55;
}

.contact-status.done {
  color: var(--color-root-moss);
  background: var(--color-primary-tint);
  border-color: var(--color-root-sprout);
}

.contact-btn {
  width: 100%;
  margin-top: 24rpx;
}

.follow-summary,
.follow-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.follow-summary {
  margin-top: 16rpx;
  padding: 20rpx;
  background: var(--color-root-nav);
  border: 1rpx solid var(--color-root-line);
  border-radius: var(--radius-control);
}

.follow-title,
.follow-row-title {
  color: var(--color-root-ink);
  font-size: var(--font-size-base);
  font-weight: 800;
  line-height: 1.4;
}

.follow-copy,
.follow-row-copy,
.follow-loading {
  margin-top: 8rpx;
  color: var(--color-root-copy);
  font-size: var(--font-size-sm);
  line-height: 1.55;
}

.follow-loading {
  flex: 0 0 84rpx;
  margin-top: 0;
  color: var(--color-root-muted);
  text-align: right;
}

.follow-list {
  margin-top: 8rpx;
}

.follow-row {
  min-height: 96rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--color-root-line);
}

.follow-row:last-child {
  border-bottom: 0;
}

.follow-status {
  flex: 0 0 112rpx;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.4;
  text-align: center;
}

.follow-status.status-pending {
  color: var(--color-root-moss);
  background: var(--color-primary-tint);
}

.follow-status.status-done {
  color: #1f6b3b;
  background: #e7f5eb;
}

.follow-status.status-muted {
  color: var(--color-root-muted);
  background: var(--color-root-nav);
  border: 1rpx solid var(--color-root-line);
}

.quick-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  color: var(--color-root-ink);
  border-bottom: 1rpx solid var(--color-root-line);
  font-size: var(--font-size-base);
  font-weight: 700;
}

.quick-row:last-child {
  border-bottom: 0;
}

.quick-arrow {
  color: var(--color-root-muted);
  font-size: 40rpx;
  font-weight: 400;
}
