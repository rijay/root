<view class="root-page profile-subpage">
  <view class="root-card">
    <view class="eyebrow">身体画像</view>
    <view class="h1">身体反馈画像</view>
    <view class="root-helper-text">这些信息来自你的入组选择，用于后续记录与顾问沟通。</view>
  </view>
  <view class="section root-card profile-list">
    <view wx:for="{{rows}}" wx:key="label" class="profile-row">
      <view class="root-section-title">{{item.label}}</view>
      <view class="body">{{item.value}}</view>
    </view>
    <view wx:if="{{!rows.length}}" class="body">暂未完成画像问卷。</view>
  </view>
</view>
