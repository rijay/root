page,
.about-page {
  min-height: 100vh;
  background: var(--color-brand-white);
}

.about-page {
  position: relative;
  height: 844px;
  overflow: hidden;
}

.about-page__title {
  position: absolute;
  top: 130px;
  left: 20px;
  width: calc(100% - 40px);
  height: 38px;
  color: var(--color-brand-black);
  font-size: 30px;
  font-weight: 600;
  line-height: 38px;
}

.about-page__wordmark {
  position: absolute;
  top: 210px;
  left: 20px;
  width: 126px;
  height: 33px;
  overflow: hidden;
}

.about-page__wordmark root-wordmark {
  transform: scale(1.5);
  transform-origin: left top;
}

.about-page__introduction {
  position: absolute;
  top: 278px;
  left: 20px;
  width: calc(100% - 40px);
  height: 82px;
  color: var(--color-graphite);
  font-size: 14px;
  line-height: 27px;
  white-space: pre-line;
}

.about-page__quote {
  position: absolute;
  top: 390px;
  left: 20px;
  display: flex;
  align-items: center;
  width: calc(100% - 40px);
  height: 112px;
  box-sizing: border-box;
  padding: 0 20px;
  color: var(--color-brand-white);
  background: var(--color-brand-black);
  border-radius: 14px;
  font-size: 17px;
  font-weight: 500;
  line-height: 32px;
  white-space: pre-line;
}

.about-page__links {
  position: absolute;
  top: 520px;
  left: 20px;
  width: calc(100% - 40px);
  height: 230px;
  overflow: hidden;
  box-sizing: border-box;
  padding: 0 16px;
  background: var(--color-brand-white);
  border-radius: 14px;
}

.about-page__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 46px;
  box-sizing: border-box;
  color: var(--color-graphite);
  border-bottom: 1px solid var(--color-ui-line-solid);
  font-size: 14px;
}

.about-page__row:last-child {
  border-bottom: 0;
}

.about-page__arrow {
  width: 4px;
  height: 8px;
  margin-right: 1px;
  border-top: 1px solid var(--color-neutral-grey);
  border-right: 1px solid var(--color-neutral-grey);
  transform: rotate(45deg);
}

.about-page__version,
.about-page__copyright {
  position: absolute;
  left: 20px;
  width: calc(100% - 40px);
  height: 18px;
  color: var(--color-neutral-grey);
  font-size: 11px;
  line-height: 18px;
  text-align: center;
}

.about-page__version {
  top: 762px;
}

.about-page__copyright {
  top: 792px;
}
