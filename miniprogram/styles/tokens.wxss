page {
  /* v0.7.0：黑白、品牌橄榄绿和中性灰为唯一界面色源。 */
  --root-ink: #000000;
  --root-bg: #f5f5f7;
  --root-nav: #ffffff;
  --root-surface: #ffffff;
  --root-moss: #242a0b;
  --root-sprout: #a1b371;
  --root-line: #d1d1d6;
  --root-muted: #7b7a7e;
  --root-copy: #3a3a3c;
  --root-soft: #e1e8d3;
  --root-primary-tint: #eef2e7;
  --root-warning: #b7791f;
  --root-danger: #b5523c;

  /* 内容图片的延展色，只用于 aspectFit 留白，不参与全局界面配色。 */
  --root-media-matte-brand-foundation-02: #9a6848;

  /* 旧名称仅为保留页面兼容，不再代表暖棕或米色。 */
  --root-clay: #6b7c3a;

  --root-font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  --root-type-xs: 22rpx;
  --root-type-sm: 26rpx;
  --root-type-body: 28rpx;
  --root-type-card-title: 32rpx;
  --root-type-page-title: 40rpx;
  --root-type-display: 56rpx;

  --root-space-xs: 8rpx;
  --root-space-sm: 16rpx;
  --root-space-md: 24rpx;
  --root-space-lg: 32rpx;
  --root-space-xl: 48rpx;
  --root-space-xxl: 64rpx;
  --root-space-hero: 96rpx;

  --root-radius-sm: 8rpx;
  --root-radius-md: 16rpx;
  --root-radius-lg: 24rpx;
  --root-radius-xl: 32rpx;
  --root-radius-full: 9999rpx;

  --root-canvas-width: 390px;
  --root-canvas-height: 844px;
  --root-page-padding: 32rpx;
  --root-tab-height: calc(104rpx + env(safe-area-inset-bottom));
  --root-motion-fast: 200ms;
  --root-motion-standard: 280ms;

  /* 兼容尚未重写的正式保留页面；对应值只在此处维护。 */
  --color-root-ink: var(--root-ink);
  --color-root-bg: var(--root-bg);
  --color-root-nav: var(--root-nav);
  --color-root-surface: var(--root-surface);
  --color-root-moss: var(--root-moss);
  --color-root-sprout: var(--root-sprout);
  --color-root-clay: var(--root-clay);
  --color-root-line: var(--root-line);
  --color-root-muted: var(--root-muted);
  --color-root-copy: var(--root-copy);
  --color-root-soft: var(--root-soft);
  --color-primary: var(--root-moss);
  --color-primary-light: var(--root-sprout);
  --color-primary-dark: #242a0b;
  --color-primary-tint: var(--root-primary-tint);
  --color-glass: rgba(255, 255, 255, 0.94);
  --color-white-strong: rgba(255, 255, 255, 0.72);
  --color-white-soft: rgba(255, 255, 255, 0.78);
  --color-accent: var(--root-clay);
  --color-success: var(--root-moss);
  --color-warning: var(--root-warning);
  --color-danger: var(--root-danger);

  /* 品牌语义色；页面只通过这些 token 表达界面语义。 */
  --color-brand-black: #000000;
  --color-brand-white: #ffffff;
  --color-brand-olive: #242a0b;
  --color-olive-mid: #6b7c3a;
  --color-olive-dark: #344126;
  --color-accent-on-dark: #a1b371;
  --color-olive-soft: #e1e8d3;
  --color-olive-tint: #eef2e7;
  --color-ui-grouped: #f5f5f7;
  --color-ui-surface: #ffffff;
  --color-ui-line-solid: #d1d1d6;
  --color-system-line: #e5e5ea;
  --color-ui-line: rgba(123, 122, 126, 0.22);
  --color-graphite: #3a3a3c;
  --color-neutral-grey: #7b7a7e;
  --color-system-secondary: #8e8e93;
  --color-danger-tint: #fff2ea;
  --color-danger-line: rgba(181, 82, 60, 0.28);
  --color-bg: var(--root-bg);
  --color-surface: var(--root-surface);
  --color-text-primary: var(--root-ink);
  --color-text-secondary: var(--root-copy);
  --color-text-tertiary: var(--root-muted);
  --color-text: var(--root-ink);
  --color-border: var(--root-line);
  --font-family: var(--root-font-family);
  --font-size-xs: var(--root-type-xs);
  --font-size-sm: var(--root-type-sm);
  --font-size-md: var(--root-type-body);
  --font-size-base: var(--root-type-body);
  --font-size-lg: var(--root-type-card-title);
  --font-size-xl: var(--root-type-page-title);
  --font-size-2xl: var(--root-type-display);
  --spacing-xs: var(--root-space-xs);
  --spacing-sm: var(--root-space-sm);
  --spacing-md: var(--root-space-md);
  --spacing-lg: var(--root-space-lg);
  --spacing-xl: var(--root-space-xl);
  --spacing-2xl: var(--root-space-xxl);
  --radius-sm: var(--root-radius-sm);
  --radius-md: var(--root-radius-md);
  --radius-lg: var(--root-radius-lg);
  --radius-xl: var(--root-radius-xl);
  --radius-card: var(--root-radius-xl);
  --radius-control: var(--root-radius-lg);
  --radius-full: var(--root-radius-full);
  --shadow-sm: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 16rpx 48rpx rgba(0, 0, 0, 0.1);
  --shadow-primary-cta: 0 8rpx 24rpx rgba(0, 0, 0, 0.18);
  --shadow-accent-cta: 0 8rpx 24rpx rgba(36, 42, 11, 0.2);
}
