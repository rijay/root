.privacy-overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.72);
}

.privacy-dialog {
  position: relative;
  width: 100% !important;
  height: 458px;
  min-height: 458px;
  padding: 12px 20px calc(28px + env(safe-area-inset-bottom));
  box-sizing: border-box;
  color: var(--root-ink);
  background: var(--root-nav);
  border-radius: 20px 20px 0 0;
}

.privacy-handle {
  width: 52px;
  height: 4px;
  margin: 0 auto 28px;
  background: var(--root-line);
  border-radius: 2px;
}

.privacy-platform-tag {
  color: var(--root-moss);
  font-size: 12px;
  line-height: 18px;
  font-weight: 500;
}

.privacy-title {
  margin-top: 12px;
  font-size: 20px;
  line-height: 28px;
  font-weight: 600;
}

.privacy-copy {
  margin-top: 20px;
  color: var(--root-copy);
  font-size: 13px;
  line-height: 22px;
  white-space: pre-line;
}

.privacy-link {
  margin-top: 12px;
  color: var(--root-moss);
  font-size: 13px;
  line-height: 22px;
}

.privacy-actions {
  position: absolute;
  top: 324px;
  right: 20px;
  left: 20px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.privacy-button {
  width: 100% !important;
  max-width: 100%;
  height: 54px;
  min-height: 54px;
  margin: 0;
  margin-right: 0 !important;
  margin-left: 0 !important;
  padding: 0;
  border: 0;
  border-radius: 12px;
  font-size: 16px;
  line-height: 54px;
}

.privacy-button::after {
  border: 0;
}

.privacy-button--primary {
  color: var(--color-brand-white);
  background: var(--root-moss);
  font-weight: 600;
}

.privacy-button--secondary {
  color: var(--root-muted);
  background: transparent;
  font-size: 14px;
}
