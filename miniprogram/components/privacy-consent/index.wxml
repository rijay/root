<view wx:if="{{visible}}" class="privacy-overlay" catchtouchmove="preventTouchMove">
  <view class="privacy-dialog" role="dialog" aria-label="隐私授权">
    <view class="privacy-title">隐私授权确认</view>
    <view class="privacy-copy">为继续使用{{purpose}}，请先阅读并同意</view>
    <view class="privacy-link" bindtap="openPrivacyContract">《{{contractName}}》</view>
    <view class="privacy-actions">
      <button class="privacy-button privacy-button--secondary" bindtap="rejectPrivacyAuthorization">暂不使用</button>
      <button
        id="root-privacy-agree"
        class="privacy-button privacy-button--primary"
        open-type="agreePrivacyAuthorization"
        bindagreeprivacyauthorization="handleAgreePrivacyAuthorization"
      >同意并继续</button>
    </view>
  </view>
</view>
